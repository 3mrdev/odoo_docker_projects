<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="slide_channel_view_form_inherit_jiz" model="ir.ui.view">
            <field name="name">slide.channel.form.inherit.jiz</field>
            <field name="model">slide.channel</field>
            <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_generate_certificates" string="Generate Certificates" type="object" class="oe_highlight"/>
                </xpath>
                <field name="user_id" position="after">
                    <field name="survey_id"/>
                </field>
                <xpath expr="//notebook" position="inside">
                    <page string="Students" name="students">
                        <field name="partner_ids">
                            <list>
                                <field name="name"/>
                                <field name="email"/>
                                <field name="civil_number"/>
                                <field name="date_of_birth"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
