<odoo>
    <data>
        <record id="swms_stepper_form" model="ir.ui.view">
            <field name="name">swms.stepper.form</field>
            <field name="model">swms.stepper</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="row justify-content-between position-relative w-100 m-0 mb-2">
                            <div class="oe_title mw-75 ps-0 pe-2">
                                <h1 class="d-flex flex-row align-items-center">
                                    <field name="name" style="font-size: min(4vw, 2.6rem);" placeholder="Portal Form Name"/>
                                </h1>
                                <h2>
                                    <field name="type" widget="radio" options="{'horizontal': true}"/>
                                </h2>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="stepper_model_id" options="{'no_create_edit': True, 'no_open': True, 'no_quick_create': True,'no_create': True}"/>
                                <field name="service_id" domain="[('is_swms','=',True)]" invisible="type != 'service'" required="type == 'service'" options="{'no_create_edit': True, 'no_open': True, 'no_quick_create': True,'no_create': True}"/>
                                <field name="description"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Steps">
                                <field name="steps_ids">
                                    <list editable="bottom" open_form_view="True">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="icon" placeholder="ex. fa fa-upload"/>
                                        <field name="document_types_ids" widget="many2many_tags"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="swms_stepper_list" model="ir.ui.view">
            <field name="name">swms.stepper.list</field>
            <field name="model">swms.stepper</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="stepper_model_id" groups="base.group_erp_manager"/>
                    <field name="steps_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="swms_stepper_step_form" model="ir.ui.view">
            <field name="name">swms.stepper.step.form</field>
            <field name="model">swms.stepper.step</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="row justify-content-between position-relative w-100 m-0 mb-2">
                            <div class="oe_title mw-75 ps-0 pe-2">
                                <h1 class="d-flex flex-row align-items-center">
                                    <field name="name" style="font-size: min(4vw, 2.6rem);" placeholder="Field name"/>
                                </h1>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="stepper_id"/>
                                <field name="icon" placeholder="ex. fa fa-upload"/>
                                <field name="document_types_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Choose Fields">
                                <field name="lines">
                                    <list editable="bottom" open_form_view="True">
                                        <field name="sequence" widget="handle"/>
                                        <field name="line_field" string="Field" options="{'no_create_edit': True, 'no_open': True, 'no_quick_create': True,'no_create': True}"/>
                                        <field name="name"/>
                                        <field name="tip"/>
                                        <field name="validation_type"/>
                                        <field name="is_mandatory" widget="boolean_toggle" optional="show"/>
                                        <field name="line_field_relation_model_name" optional="hide"/>
                                        <field name="line_domain" string="Domain (M2O)" widget="domain" options="{'model': 'line_field_relation_model_name'}" optional="hide"/>
                                        <!-- <field name="line_domain" string="Domain json" readonly="1" optional="hide"/> -->
                                        <field name="line_fields_ids" string="Fields (O2M)" widget="many2many_tags" options="{'no_create_edit': True, 'no_open': True, 'no_quick_create': True,'no_create': True}" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="swms_step_list" model="ir.ui.view">
            <field name="name">swms.stepper.step.list</field>
            <field name="model">swms.stepper.step</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="icon" placeholder="ex. fa fa-upload"/>
                    <field name="stepper_id"/>
                </list>
            </field>
        </record>

        <record id="swms_stepper_step_line_form" model="ir.ui.view">
            <field name="name">swms.stepper.step.line.form</field>
            <field name="model">swms.stepper.step.line</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="row justify-content-between position-relative w-100 m-0 mb-2">
                            <div class="oe_title mw-75 ps-0 pe-2">
                                <h1 class="d-flex flex-row align-items-center">
                                    <field name="name" style="font-size: min(4vw, 2.6rem);" placeholder="Field name"/>
                                </h1>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="line_field"/>
                                <field name="is_mandatory" widget="boolean_toggle"/>
                                <!-- <field name="sequence"/>
                                <field name="line_field_relation_model_name" invisible="1"/>
                                <field name="line_domain" string="Domain json" invisible="1"/>
                                <field name="line_domain" string="Domain (M2O)" widget="domain" options="{'model': 'line_field_relation_model_name'}"/>
                                <field name="line_fields_ids" string="Fields (O2M)" widget="many2many_tags" options="{'no_create_edit': True, 'no_open': True, 'no_quick_create': True,'no_create': True}"/> -->
                            </group>
                        </group>
                        <notebook>
                            <page string="Choose Fields">
                                <field name="line_fields_v2_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="v2line_field" string="Field" options="{'no_create_edit': True, 'no_open': True, 'no_quick_create': True,'no_create': True}"/>
                                        <field name="name"/>
                                        <field name="is_mandatory" widget="boolean_toggle" optional="show"/>
                                        <field name="v2line_field_relation_model_name" optional="hide"/>
                                        <field name="v2line_domain" string="Domain (M2O)" widget="domain" options="{'model': 'v2line_field_relation_model_name'}" optional="hide"/>
                                        <!-- <field name="v2line_domain" string="Domain json" readonly="1" optional="hide"/> -->
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="swms_step_line_list" model="ir.ui.view">
            <field name="name">swms.stepper.step.line.list</field>
            <field name="model">swms.stepper.step.line</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>
    </data>
</odoo>