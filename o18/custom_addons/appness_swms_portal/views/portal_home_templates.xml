<odoo>
    
    <template id="portal_odoo_sidebar_remove" name="Remove Odoo form Portal sidebar " inherit_id="portal.portal_record_sidebar">
        <xpath expr="//div[hasclass('o_portal_sidebar_content')]" position="replace">
            <div class="o_portal_sidebar_content flex-grow-1 mb-4 mb-lg-0 pe-lg-4" id="sidebar_content">
                <div t-if="title" class="position-relative d-flex align-items-center justify-content-md-center justify-content-lg-between flex-wrap gap-2">
                    <t t-out="title"/>
                </div>
                <t t-if="entries" t-out="entries"/>
                <!-- <div class="d-none d-lg-block mt-5 small text-center text-muted">
                    Powered by <a target="_blank" href="http://www.odoo.com?utm_source=db&amp;utm_medium=portal" title="odoo"><img src="/web/static/img/logo.png" alt="Odoo Logo" height="15"/></a>
                </div> -->
            </div>
        </xpath>
    </template>

    <template id="appness_swms_portal.side_content_redirect" name="Edit profile redirect" inherit_id="portal.side_content">        
        <xpath expr="//a" position="replace">
            <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
            <a t-if="not is_family" role="button" href="/my/account" class="btn btn-link p-0 mt-3"><i class="fa fa-pencil"/> Edit information</a>
            <a t-if="is_family" role="button" href="/my/swms_account/1" class="btn btn-link p-0 mt-3"><i class="fa fa-pencil"/> Edit information</a>
        </xpath>
    </template>

    <template id="portal_my_home_menu_swms_request" name="Portal layout : SWMS requests menu entries" inherit_id="portal.portal_breadcrumbs" priority="50">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'swms_request_page'" t-attf-class="breadcrumb-item #{'active ' if not swms_request else ''}">
                <a t-if="swms_request" t-attf-href="/my/requests?{{ keep_query() }}">Requests</a>
                <t t-else="">Requests</t>
            </li>
            <li t-if="swms_request" class="breadcrumb-item active text-truncate"> 
                <span t-field="swms_request.name"/> (#<span t-field="swms_request.request_seq"/>)
            </li>
            <!-- (#<span t-field="swms_request.ticket_ref"/>) -  -->
            <li t-if="page_name == 'swms_services'" t-attf-class="breadcrumb-item #active">
                Services
            </li>
            <li t-if="page_name == 'swms_service'" t-attf-class="breadcrumb-item #active">
                <a t-attf-href="/swms/services?{{ keep_query() }}">Services</a>
                / Service <span t-esc="service_id"/> Details
            </li>
        </xpath>
    </template>

    <template id="portal.portal_my_home" name="My Portal">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="True"/>
            <div class="o_portal_my_home">
                <div class="oe_structure" id="oe_structure_portal_my_home_1"/>
                <div class="o_portal_docs row g-2">
                    <div t-if="portal_alert_category_enable" class="o_portal_category row g-2 mt-3" id="portal_alert_category"/>
                    <div t-if="portal_client_category_enable" class="o_portal_category row g-2 mt-3" id="portal_client_category"/>
                    <div t-if="portal_service_category_enable" class="o_portal_category row g-2 mt-3" id="portal_service_category"/>
                    <div t-if="portal_vendor_category_enable" class="o_portal_category row g-2 mt-3" id="portal_vendor_category"/>
                    <div class="o_portal_category row g-2 mt-3" id="portal_common_category">
                        <t t-call="portal.portal_docs_entry" t-if="False"/>
                        <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
                        <t t-if="not is_family" t-call="portal.portal_docs_entry">
                            <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                            <t t-set="title">Connection &amp; Security</t>
                            <t t-set="text">Configure your connection parameters</t>
                            <t t-set="url" t-value="'/my/security'"/>
                            <t t-set="config_card" t-value="True"/>
                        </t>
                    </div>
                    <div class="o_portal_doc_spinner spinner-border text-o-color-2 align-self-center mt-5"/>
                </div>
            </div>
            <div class="oe_structure" id="oe_structure_portal_my_home_2"/>
        </t>
    </template>

    <template id="helpdesk.portal_my_home_helpdesk_ticket" name="Helpdesk Tickets" customize_show="True" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
            <t t-if="not is_family" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/helpdesk/static/src/img/tickets.svg'"/>
                <t t-set="title">Tickets</t>
                <t t-set="text">Follow all your helpdesk tickets</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="placeholder_count" t-value="'ticket_count'"/>
            </t>
        </div>
    </template>

    <template id="sale.portal_my_home_sale" name="Quotations / Sales Orders" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
            <t t-set="portal_alert_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_alert_category" position="inside">
            <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
            <t t-if="not is_family" t-call="portal.portal_docs_entry">
                <t t-set="bg_color" t-value="'alert alert-primary align-items-center'"/>
                <t t-set="placeholder_count" t-value="'quotation_count'"/>
                <t t-set="title">Quotations to review</t>
                <t t-set="url" t-value="'/my/quotes'"/>
                <t t-set="show_count" t-value="True"/>
            </t>
        </div>
        <div id="portal_client_category" position="inside">
            <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
            <t t-if="not is_family" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                <t t-set="title">Your Orders</t>
                <t t-set="url" t-value="'/my/orders'"/>
                <t t-set="text">Follow, view or pay your orders</t>
                <t t-set="placeholder_count" t-value="'order_count'"/>
            </t>
        </div>
    </template>

    <template id="account.portal_my_home_invoice" name="Invoices / Bills" inherit_id="portal.portal_my_home" customize_show="True" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
            <t t-set="portal_vendor_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
            <t t-if="not is_family" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'"/>
                <t t-set="title">Your Invoices</t>
                <t t-set="url" t-value="'/my/invoices?filterby=invoices'"/>
                <t t-set="text">Follow, download or pay your invoices</t>
                <t t-set="placeholder_count" t-value="'invoice_count'"/>
            </t>
        </div>
        <div id="portal_vendor_category" position="inside">
            <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
            <t t-if="not is_family" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'"/>
                <t t-set="title">Our Invoices</t>
                <t t-set="url" t-value="'/my/invoices?filterby=bills'"/>
                <t t-set="text">Follow, download or pay our invoices</t>
                <t t-set="placeholder_count" t-value="'bill_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_dashboard" name="SWMS Requests" customize_show="True" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
            <t t-set="portal_alert_category_enable" t-value="True"/>
        </xpath>
        <!-- TODO: Show required document updates and notifications to the user in portal -->
        <div id="portal_alert_category" position="inside">
            <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
            <t t-if="is_family" t-call="portal.portal_docs_entry">
                <t t-set="bg_color" t-value="'alert alert-danger align-items-center'"/>
                <t t-set="placeholder_count" t-value="'expired_documents_count'"/>
                <t t-set="title">Documents to update in your family profile</t>
                <t t-set="text">You have expired documents that need to be renewed .. please click here!</t>
                <t t-set="url" t-value="'/my/swms_account/1'"/>
                <t t-set="show_count" t-value="True"/>
            </t>
            <t t-if="is_family" t-call="portal.portal_docs_entry">
                <t t-set="bg_color" t-value="'alert alert-danger align-items-center'"/>
                <t t-set="placeholder_count" t-value="'missing_documents_count'"/>
                <t t-set="title">Missing Documents in your family profile</t>
                <t t-set="text">You have missing documents that you need to upload .. please click here!</t>
                <t t-set="url" t-value="'/my/swms_account/1'"/>
                <t t-set="show_count" t-value="True"/>
            </t>
            <t t-if="is_family" t-call="portal.portal_docs_entry">
                <t t-set="bg_color" t-value="'alert alert-danger align-items-center'"/>
                <t t-set="placeholder_count" t-value="'services_expired_documents_count'"/>
                <t t-set="title">Documents to update in your assistance requests</t>
                <t t-set="text">You have expired documents that need to be renewed .. please click here!</t>
                <t t-set="url" t-value="'/my/requests'"/>
                <t t-set="show_count" t-value="True"/>
            </t>
            <t t-if="is_family" t-call="portal.portal_docs_entry">
                <t t-set="bg_color" t-value="'alert alert-danger align-items-center'"/>
                <t t-set="placeholder_count" t-value="'services_missing_documents_count'"/>
                <t t-set="title">Missing Documents in your assistance requests</t>
                <t t-set="text">You have missing documents that you need to upload .. please click here!</t>
                <t t-set="url" t-value="'/my/requests'"/>
                <t t-set="show_count" t-value="True"/>
            </t>
            <!-- <t t-if="is_family" t-call="portal.portal_docs_entry">
                <t t-set="bg_color" t-value="'alert alert-primary align-items-center'"/>
                <t t-set="placeholder_count" t-value="'missing_information_count'"/>
                <t t-set="title">Missing Information</t>
                <t t-set="text">You have missing information that need enter !</t>
                <t t-set="url" t-value="'/my/swms_account/1'"/>
                <t t-set="show_count" t-value="True"/>
            </t> -->
        </div>

        <div id="portal_service_category" position="inside">
            <t t-set="is_family" t-value="request.env.user.partner_id.is_family"/>
            <div t-if="is_family" class="o_portal_index_card col-md-6 order-2">
                <a href="/my/requests" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon">
                        <!-- <img t-attf-src="#{'/appness_swms_portal/static/img/helphand.png'}"/> -->
                         <img src="data:image/png;base64,"/>
                    </div>
                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                            <span>Requests</span>
                        </div>
                        <div class="opacity-75">
                            Follow all your service requests
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </template>
</odoo>