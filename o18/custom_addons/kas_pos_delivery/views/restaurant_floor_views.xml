<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit restaurant floor form view to add default_customer field -->
    <record id="floor_form_view_inherit_kas_pos_delivery" model="ir.ui.view">
        <field name="name">restaurant.floor.form.inherit.kas.pos.delivery</field>
        <field name="model">restaurant.floor</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_floor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_config_ids']" position="after">
                <field name="default_customer"/>
            </xpath>
        </field>
    </record>
</odoo>
