<odoo>
    <record model="ir.ui.view" id="swms_reports_wizard">
        <field name="name">SWMS Reports</field>
        <field name="model">swms.reports.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="SWMS Owners Reports">
                <group>
                    <group>
                        <field name="sponser_id"/>
                        <field name="family"/>
                        <field name="orphan"/>
                    </group>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="select_all"/>
                        <field name="sort_reports" widget='boolean_toggle'/>
                    </group>
                </group>
                <notebook>
                    <page string="SWMS Reports" invisible="sort_reports">
                        <group >
                            <group>
                                <field name="report1"/>
                                <field name="report2"/>
                                <field name="report3"/>
                                <field name="report4"/>
                            </group>
                            <group>
                                <field name="report5"/>
                                <field name="report6"/>
                                <field name="report7"/>
                            </group>
                        </group>
                    </page>
                    <page string="SWMS Reports" invisible="not sort_reports">
                        <field name="reports_ids" readonly="0">
                            <list editable="bottom" delete="0">
                                <field name="seq" widget="handle"/>
                                <field name="name" column_readonly="1"/>
                                <field name="check" widget='boolean_toggle' string="Print"/>
                                <field name="num" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="print_report" string="Print Report" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_swms_reports_wizard" model="ir.actions.act_window">
        <field name="name">SWMS Reports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">swms.reports.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

