<odoo>
    <data>

        <record id="purchase_order_form_inherit_swms" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.swms</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="replace">
                    <field name="partner_id" domain="[('is_family','=',False)]" widget="res_partner_many2one" context="{'res_partner_search_mode': 'supplier', 'show_vat': True}" placeholder="Name, TIN, Email, or Reference" readonly="state in ['cancel', 'done', 'purchase']"/>
                </field>
            </field>
        </record>

    </data>
</odoo>