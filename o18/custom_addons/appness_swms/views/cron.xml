<odoo>
   <data noupdate="0">

       <record id="swms_pause_sponsership" model="ir.cron">
           <field name="name">SWMS: Pause Sponsership to Update Inofrmation</field>
           <field name="model_id" ref="model_sale_order"/>
           <field name="state">code</field>
           <field name="code">model.update_info_pause_subs()</field>
           <field name="user_id" ref="base.user_root"/>
           <field name='interval_number'>1</field>
           <field name='interval_type'>days</field>
           <!-- <field name="nextcall"
                  eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/> -->
           <field name="priority">1</field>
       </record>

       <record id="swms_send_notifications" model="ir.cron">
           <field name="name">SWMS: Send Notifications</field>
           <field name="model_id" ref="model_documents_document"/>
           <field name="state">code</field>
           <field name="code">model.send_notifications()</field>
           <field name="user_id" ref="base.user_root"/>
           <field name='interval_number'>1</field>
           <field name='interval_type'>days</field>
           <!-- <field name="nextcall"
                  eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/> -->
           <field name="priority">1</field>
       </record>

   </data>
</odoo>
