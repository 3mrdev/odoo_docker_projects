<odoo>
    <data>
        <record id="swms_stock_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="after">
                    <group invisible="not is_swms">
                        <group>
                            <field name="is_swms" string="Is SWMS ?" widget="boolean_toggle"/>
                        </group>
                    </group>
                </div>

                <xpath expr="//notebook/page[1]" position="after">
                    <page string="SWMS" invisible="not is_swms">
                        <group>
                            <field name="request_id" readonly="1" options="{'no_create_edit': True, 'no_open': True, 'no_quick_create': True,'no_create': True}"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>