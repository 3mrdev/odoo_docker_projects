<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add allowed_route_ids field to the Warehouse Management page -->
    <record id="view_users_form_inherit_route" model="ir.ui.view">
        <field name="name">res.users.form.inherit.route</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="sttl_warehouse_access_control.view_users_form_inherit_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='locationaccess']" position="inside">
                <field name="allowed_route_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

</odoo>
