<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">
    <t t-name="pos_enhanced_features.OrderReceipt" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'btn') and contains(., 'Refund')]" position="replace">
            <t t-set="cashier" t-value="this.pos.get_cashier()"/>
            <button t-if="cashier &amp;&amp; cashier._role == 'manager'" class="btn btn-secondary btn-lg py-5" t-on-click="() => this.clickRefund()">
                <i class="fa fa-undo me-1" role="img" aria-label="Refund" title="Refund" />
                Refund
            </button>
        </xpath>
    </t>
</templates>