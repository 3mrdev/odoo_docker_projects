<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="jiz_training_type_view_form" model="ir.ui.view">
            <field name="name">jiz.training.type.view.form</field>
            <field name="model">jiz.training.type</field>
            <field name="arch" type="xml">
                <form string="Training Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="jiz_training_type_view_list" model="ir.ui.view">
            <field name="name">jiz.training.type.view.list</field>
            <field name="model">jiz.training.type</field>
            <field name="arch" type="xml">
                <list string="Training Types">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="jiz_training_type_action" model="ir.actions.act_window">
            <field name="name">Training Types</field>
            <field name="res_model">jiz.training.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="jiz_training_type_menu" name="Training Types" parent="hr.menu_human_resources_configuration" action="jiz_training_type_action" sequence="100"/>
    </data>
</odoo>
