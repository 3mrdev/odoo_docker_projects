<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="jiz_training_view_form" model="ir.ui.view">
            <field name="name">jiz.training.view.form</field>
            <field name="model">jiz.training</field>
            <field name="arch" type="xml">
                <form string="Employee Training">
                    <header>
                        <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="status != 'planned'"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="status != 'in_progress'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="status in ['completed', 'cancelled']"/>
                        <button name="action_reset_to_planned" string="Reset to Planned" type="object" invisible="status not in ['cancelled', 'completed']"/>
                        <field name="status" widget="statusbar" statusbar_visible="planned,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Training Title..." invisible="status != 'planned'"/>
                                <field name="name" readonly="1" invisible="status == 'planned'"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id" invisible="status != 'planned'"/>
                                <field name="employee_id" readonly="1" invisible="status == 'planned'"/>
                                <field name="provider_id" invisible="status != 'planned'"/>
                                <field name="provider_id" readonly="1" invisible="status == 'planned'"/>
                                <field name="training_type_id" invisible="status != 'planned'"/>
                                <field name="training_type_id" readonly="1" invisible="status == 'planned'"/>
                            </group>
                            <group>
                                <field name="start_date" invisible="status != 'planned'"/>
                                <field name="start_date" readonly="1" invisible="status == 'planned'"/>
                                <field name="end_date" invisible="status != 'planned'"/>
                                <field name="end_date" readonly="1" invisible="status == 'planned'"/>
                                <field name="certification_indicator" invisible="status != 'planned'"/>
                                <field name="certification_indicator" readonly="1" invisible="status == 'planned'"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="jiz_training_view_list" model="ir.ui.view">
            <field name="name">jiz.training.view.list</field>
            <field name="model">jiz.training</field>
            <field name="arch" type="xml">
                <list string="Employee Trainings">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="provider_id"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <record id="jiz_training_action" model="ir.actions.act_window">
            <field name="name">Employee Trainings</field>
            <field name="res_model">jiz.training</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="jiz_training_menu" name="Employee Trainings" parent="hr.menu_hr_root" action="jiz_training_action" sequence="10"/>
    </data>
</odoo>
