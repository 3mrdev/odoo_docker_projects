<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kas_pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_interface_section" position="inside">
                <setting string="Refund/Cancel Order" help="Allow to show refund and cancel order buttons.">
                    <div class="content-group">
                        <div>
                            <field name="pos_allow_refund_button"/>
                            <label for="pos_allow_refund_button" string="Allow refund button" class="fw-normal me-1"/>
                        </div>
                        <div>
                            <field name="pos_allow_cancel_button"/>
                            <label for="pos_allow_cancel_button" string="Allow cancel button" class="fw-normal me-1"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
