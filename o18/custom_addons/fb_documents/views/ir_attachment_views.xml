<odoo>
    <record id="view_ir_attachment_search" model="ir.ui.view">
        <field name="name">ir.attachment.search</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="description"/>
                <field name="sequence"/>
                <field name="doc_type"/>
                <field name="department"/>
            </field>
            <filter name="owner" position="before">
                <filter name="res_model" string="Screen" domain="[]" context="{'group_by':'res_model'}"/>
                <filter name="doc_type" string="Document Type" domain="[]" context="{'group_by':'doc_type'}"/>
                <filter name="department" string="Department" domain="[]" context="{'group_by':'department'}"/>
            </filter>
        </field>
    </record>

    <record id="view_ir_attachment_form" model="ir.ui.view">
        <field name="name">ir.attachment.form</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <field name="type" position="before">
                <field name="sequence" readonly="1"/>
                <field name="doc_type"/>
                <field name="department"/>
            </field>
        </field>
    </record>

    <record id="view_ir_attachment_kanban" model="ir.ui.view">
        <field name="name">ir.attachment.kanban</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="mail.view_document_file_kanban"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sequence"/>
                <field name="doc_type"/>
                <field name="department"/>
            </field>
        </field>
    </record>

    <record id="action_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{"search_default_res_model": "res_model"}</field>
        <field name="domain">[('res_model', 'not in', ['ir.module.module', 'ir.ui.view', False])]</field>
    </record>

    <record id="action_document_type" model="ir.actions.act_window">
        <field name="name">Document Type</field>
        <field name="res_model">fb.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_department" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban,list,form</field>
    </record>


    <menuitem id="menu_fb_documents" web_icon="fb_documents,static/description/icon.png" name="Documents" sequence="10"/>
    <menuitem id="menu_fb_documents_document" name="Document" parent="menu_fb_documents" action="action_document" sequence="10"/>

    <menuitem id="menu_fb_documents_configuration" name="Configuration" parent="menu_fb_documents" sequence="20"/>
    <menuitem id="menu_fb_documents_document_type" name="Document Type" parent="menu_fb_documents_configuration" action="action_document_type" sequence="10"/>
    <menuitem id="menu_fb_documents_department" name="Department" parent="menu_fb_documents_configuration" action="action_department" sequence="20"/>
</odoo>
