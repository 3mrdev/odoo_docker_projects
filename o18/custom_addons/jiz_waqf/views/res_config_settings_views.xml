<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_documents_waqf" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.documents.waqf</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="80"/>
            <field name="inherit_id" ref="documents.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='files_centralization_section']" position="inside">
                    <setting company_dependent="1" help="Centralize your Waqf' documents">
                        <field name="documents_waqf_settings"/>
                        <div class="content-group" invisible="not documents_waqf_settings">
                            <div class="row mt16">
                                <label class="o_form_label col-lg-3" for="documents_waqf_folder" string="Workspace"/>
                                <field name="documents_waqf_folder" required="documents_waqf_settings" widget="documents_folder_many2one"/>
                            </div>
                            <div class="row">
                                <label class="o_form_label col-lg-3" for="documents_waqf_tags" string="Default Tags"/>
                                <field name="documents_waqf_tags" widget="many2many_tags"/>
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>