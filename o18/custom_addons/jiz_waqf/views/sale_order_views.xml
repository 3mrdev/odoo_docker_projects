<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_view_form_inherit_waqf" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.waqf</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='subscription_info']" position="after">
                    <group string="Waqf" name="waqf_info">
                        <field name="waqf_unit_id" domain="[('status', '=', 'free')]"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
