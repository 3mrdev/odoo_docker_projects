<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_jiz_waqf" model="ir.module.category">
            <field name="name">Waqf</field>
            <field name="description">User access levels for the Waqf module</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_jiz_waqf_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="jiz_waqf.module_category_jiz_waqf"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_jiz_waqf_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="jiz_waqf.module_category_jiz_waqf"/>
            <field name="implied_ids" eval="[(4, ref('jiz_waqf.group_jiz_waqf_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
