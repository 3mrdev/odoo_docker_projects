<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================ -->
        <!-- MASTER DATA: Vehicle Types -->
        <!-- ============================================ -->
        <record id="vehicle_type_flatbed_3t" model="logspace.vehicle.type">
            <field name="name">Flatbed Truck 3T</field>
            <field name="code">flatbed_3t</field>
            <field name="icon">fa-truck</field>
            <field name="default_capacity_kg">3000</field>
            <field name="default_capacity_cbm">15.0</field>
            <field name="category">medium</field>
            <field name="description">Standard flatbed truck for general cargo</field>
            <field name="sequence">10</field>
        </record>

        <record id="vehicle_type_flatbed_5t" model="logspace.vehicle.type">
            <field name="name">Flatbed Truck 5T</field>
            <field name="code">flatbed_5t</field>
            <field name="icon">fa-truck</field>
            <field name="default_capacity_kg">5000</field>
            <field name="default_capacity_cbm">25.0</field>
            <field name="category">heavy</field>
            <field name="description">Heavy flatbed truck for large cargo</field>
            <field name="sequence">20</field>
        </record>

        <record id="vehicle_type_covered_3t" model="logspace.vehicle.type">
            <field name="name">Covered Truck 3T</field>
            <field name="code">covered_3t</field>
            <field name="icon">fa-truck-moving</field>
            <field name="default_capacity_kg">3000</field>
            <field name="default_capacity_cbm">18.0</field>
            <field name="category">medium</field>
            <field name="description">Covered truck for weather-sensitive cargo</field>
            <field name="sequence">30</field>
        </record>

        <record id="vehicle_type_van" model="logspace.vehicle.type">
            <field name="name">Cargo Van</field>
            <field name="code">van</field>
            <field name="icon">fa-shuttle-van</field>
            <field name="default_capacity_kg">1000</field>
            <field name="default_capacity_cbm">6.0</field>
            <field name="category">light</field>
            <field name="description">Small van for light deliveries</field>
            <field name="sequence">40</field>
        </record>

        <record id="vehicle_type_refrigerated" model="logspace.vehicle.type">
            <field name="name">Refrigerated Truck</field>
            <field name="code">refrigerated</field>
            <field name="icon">fa-snowflake</field>
            <field name="default_capacity_kg">2500</field>
            <field name="default_capacity_cbm">14.0</field>
            <field name="category">special</field>
            <field name="description">Temperature-controlled transport for perishables</field>
            <field name="sequence">50</field>
        </record>

        <!-- ============================================ -->
        <!-- MASTER DATA: Zones -->
        <!-- ============================================ -->
        <record id="zone_downtown" model="logspace.zone">
            <field name="name">Downtown</field>
            <field name="code">DOWNTOWN</field>
            <field name="city">Metropolis</field>
            <field name="region">Central</field>
        </record>

        <record id="zone_airport" model="logspace.zone">
            <field name="name">Airport Zone</field>
            <field name="code">AIRPORT</field>
            <field name="city">Metropolis</field>
            <field name="region">East</field>
        </record>

        <record id="zone_port" model="logspace.zone">
            <field name="name">Port Area</field>
            <field name="code">PORT</field>
            <field name="city">Harbor City</field>
            <field name="region">Coastal</field>
        </record>

        <record id="zone_industrial" model="logspace.zone">
            <field name="name">Industrial North</field>
            <field name="code">INDUSTRIAL_N</field>
            <field name="city">Tech Valley</field>
            <field name="region">North</field>
        </record>

        <record id="zone_business" model="logspace.zone">
            <field name="name">Business District</field>
            <field name="code">BUSINESS</field>
            <field name="city">Metropolis</field>
            <field name="region">Central</field>
        </record>

        <record id="zone_residential" model="logspace.zone">
            <field name="name">Residential East</field>
            <field name="code">RESIDENTIAL_E</field>
            <field name="city">Suburbia</field>
            <field name="region">East</field>
        </record>

        <record id="zone_suburb" model="logspace.zone">
            <field name="name">Suburb West</field>
            <field name="code">SUBURB_W</field>
            <field name="city">Westfield</field>
            <field name="region">West</field>
        </record>

        <record id="zone_metro" model="logspace.zone">
            <field name="name">Metro Central</field>
            <field name="code">METRO_C</field>
            <field name="city">Metropolis</field>
            <field name="region">Central</field>
        </record>

        <record id="zone_northern" model="logspace.zone">
            <field name="name">Northern Hub</field>
            <field name="code">NORTHERN</field>
            <field name="city">Tech Valley</field>
            <field name="region">North</field>
        </record>

        <record id="zone_coastal" model="logspace.zone">
            <field name="name">Coastal Area</field>
            <field name="code">COASTAL</field>
            <field name="city">Beachside</field>
            <field name="region">Coastal</field>
        </record>

        <!-- ============================================ -->
        <!-- MASTER DATA: Add-ons -->
        <!-- ============================================ -->
        <record id="addon_loading" model="logspace.addon">
            <field name="name">Loading Assistance</field>
            <field name="code">loading_assist</field>
            <field name="description">Professional help loading items onto the truck</field>
            <field name="price">25.0</field>
            <field name="price_type">fixed</field>
            <field name="icon">fa-hand-rock</field>
            <field name="sequence">10</field>
        </record>

        <record id="addon_unloading" model="logspace.addon">
            <field name="name">Unloading Assistance</field>
            <field name="code">unloading_assist</field>
            <field name="description">Professional help unloading at destination</field>
            <field name="price">25.0</field>
            <field name="price_type">fixed</field>
            <field name="icon">fa-hand-holding</field>
            <field name="sequence">20</field>
        </record>

        <record id="addon_express" model="logspace.addon">
            <field name="name">Express Delivery</field>
            <field name="code">express</field>
            <field name="description">Priority delivery within 4 hours</field>
            <field name="price">50.0</field>
            <field name="price_type">fixed</field>
            <field name="icon">fa-bolt</field>
            <field name="sequence">30</field>
        </record>

        <record id="addon_helper" model="logspace.addon">
            <field name="name">Extra Helper</field>
            <field name="code">extra_helper</field>
            <field name="description">Additional helper for heavy items</field>
            <field name="price">40.0</field>
            <field name="price_type">per_hour</field>
            <field name="icon">fa-user-plus</field>
            <field name="sequence">40</field>
        </record>

        <record id="addon_protection" model="logspace.addon">
            <field name="name">Furniture Protection</field>
            <field name="code">protection</field>
            <field name="description">Wrapping and padding for delicate furniture</field>
            <field name="price">15.0</field>
            <field name="price_type">fixed</field>
            <field name="icon">fa-shield-alt</field>
            <field name="sequence">50</field>
        </record>

        <record id="addon_gps" model="logspace.addon">
            <field name="name">GPS Tracking</field>
            <field name="code">gps_tracking</field>
            <field name="description">Real-time tracking of your delivery</field>
            <field name="price">10.0</field>
            <field name="price_type">fixed</field>
            <field name="icon">fa-map-marker-alt</field>
            <field name="sequence">60</field>
        </record>

        <!-- ============================================ -->
        <!-- DEMO PROVIDERS -->
        <!-- ============================================ -->

        <!-- Partner Records for Providers -->
        <record id="partner_abc_logistics" model="res.partner">
            <field name="name">ABC Logistics</field>
            <field name="is_company">True</field>
            <field name="phone">+1 555-0101</field>
            <field name="email">contact@abclogistics.com</field>
            <field name="city">Metropolis</field>
            <field name="website">https://abclogistics.com</field>
        </record>

        <record id="partner_fast_truck" model="res.partner">
            <field name="name">Fast Truck Co</field>
            <field name="is_company">True</field>
            <field name="phone">+1 555-0102</field>
            <field name="email">info@fasttruck.com</field>
            <field name="city">Tech Valley</field>
        </record>

        <record id="partner_city_movers" model="res.partner">
            <field name="name">City Movers</field>
            <field name="is_company">False</field>
            <field name="phone">+1 555-0103</field>
            <field name="email">citymovers@email.com</field>
            <field name="city">Suburbia</field>
        </record>

        <record id="partner_new_provider" model="res.partner">
            <field name="name">New Provider LLC</field>
            <field name="is_company">True</field>
            <field name="phone">+1 555-0104</field>
            <field name="email">new@provider.com</field>
            <field name="city">Westfield</field>
        </record>

        <record id="partner_suspended" model="res.partner">
            <field name="name">Suspended Trucking</field>
            <field name="is_company">True</field>
            <field name="phone">+1 555-0105</field>
            <field name="email">suspended@trucking.com</field>
            <field name="city">Harbor City</field>
        </record>

        <!-- Provider 1: Approved - ABC Logistics -->
        <record id="provider_abc_logistics" model="logspace.provider">
            <field name="name">ABC Logistics</field>
            <field name="partner_id" ref="partner_abc_logistics"/>
            <field name="state">approved</field>
            <field name="years_experience">5_10</field>
            <field name="tax_id">TAX-987654321</field>
            <field name="is_verified">True</field>
            <field name="approval_date" eval="(datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Provider 2: Approved - Fast Truck Co -->
        <record id="provider_fast_truck" model="logspace.provider">
            <field name="name">Fast Truck Co</field>
            <field name="partner_id" ref="partner_fast_truck"/>
            <field name="state">approved</field>
            <field name="years_experience">3_5</field>
            <field name="tax_id">TAX-456789012</field>
            <field name="is_verified">True</field>
            <field name="approval_date" eval="(datetime.now() - timedelta(days=15)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Provider 3: Pending - City Movers -->
        <record id="provider_city_movers" model="logspace.provider">
            <field name="name">City Movers</field>
            <field name="partner_id" ref="partner_city_movers"/>
            <field name="state">pending</field>
            <field name="years_experience">3_5</field>
            <field name="is_verified">False</field>
        </record>

        <!-- Provider 4: Draft - New Provider LLC -->
        <record id="provider_new" model="logspace.provider">
            <field name="name">New Provider LLC</field>
            <field name="partner_id" ref="partner_new_provider"/>
            <field name="state">draft</field>
            <field name="years_experience">less_1</field>
            <field name="is_verified">False</field>
        </record>

        <!-- Provider 5: Suspended - Suspended Trucking -->
        <record id="provider_suspended" model="logspace.provider">
            <field name="name">Suspended Trucking</field>
            <field name="partner_id" ref="partner_suspended"/>
            <field name="state">suspended</field>
            <field name="years_experience">more_10</field>
            <field name="tax_id">TAX-123456789</field>
            <field name="is_verified">True</field>
            <field name="approval_date" eval="(datetime.now() - timedelta(days=60)).strftime('%Y-%m-%d')"/>
            <field name="suspension_reason">Multiple customer complaints about late deliveries</field>
        </record>

        <!-- ============================================ -->
        <!-- DEMO VEHICLES -->
        <!-- ============================================ -->

        <!-- ABC Logistics Vehicles -->
        <record id="vehicle_abc_1" model="logspace.vehicle">
            <field name="name">Truck Alpha</field>
            <field name="provider_id" ref="provider_abc_logistics"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_3t"/>
            <field name="plate_number">ABC-1234</field>
            <field name="is_active">True</field>
        </record>

        <record id="vehicle_abc_2" model="logspace.vehicle">
            <field name="name">Truck Beta</field>
            <field name="provider_id" ref="provider_abc_logistics"/>
            <field name="vehicle_type_id" ref="vehicle_type_covered_3t"/>
            <field name="plate_number">ABC-5678</field>
            <field name="is_active">True</field>
        </record>

        <!-- Fast Truck Co Vehicle -->
        <record id="vehicle_ftc_1" model="logspace.vehicle">
            <field name="name">Fast One</field>
            <field name="provider_id" ref="provider_fast_truck"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_5t"/>
            <field name="plate_number">FTC-9876</field>
            <field name="is_active">True</field>
        </record>

        <!-- City Movers Vehicle -->
        <record id="vehicle_cm_1" model="logspace.vehicle">
            <field name="name">City Van</field>
            <field name="provider_id" ref="provider_city_movers"/>
            <field name="vehicle_type_id" ref="vehicle_type_van"/>
            <field name="plate_number">CM-1111</field>
            <field name="is_active">True</field>
        </record>

        <!-- Suspended Trucking Vehicles -->
        <record id="vehicle_sus_1" model="logspace.vehicle">
            <field name="name">Big Rig 1</field>
            <field name="provider_id" ref="provider_suspended"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_5t"/>
            <field name="plate_number">SUS-2222</field>
            <field name="is_active">False</field>
        </record>

        <record id="vehicle_sus_2" model="logspace.vehicle">
            <field name="name">Reefer</field>
            <field name="provider_id" ref="provider_suspended"/>
            <field name="vehicle_type_id" ref="vehicle_type_refrigerated"/>
            <field name="plate_number">SUS-3333</field>
            <field name="is_active">False</field>
        </record>

        <!-- ============================================ -->
        <!-- DEMO PRICE MATRIX -->
        <!-- ============================================ -->

        <!-- ABC Logistics Pricing -->
        <record id="price_abc_1" model="logspace.price.matrix">
            <field name="provider_id" ref="provider_abc_logistics"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_3t"/>
            <field name="zone_from_id" ref="zone_downtown"/>
            <field name="zone_to_id" ref="zone_airport"/>
            <field name="distance_km">15.0</field>
            <field name="provider_price">75.0</field>
            <field name="is_active">True</field>
        </record>

        <record id="price_abc_2" model="logspace.price.matrix">
            <field name="provider_id" ref="provider_abc_logistics"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_3t"/>
            <field name="zone_from_id" ref="zone_downtown"/>
            <field name="zone_to_id" ref="zone_industrial"/>
            <field name="distance_km">25.0</field>
            <field name="provider_price">100.0</field>
            <field name="is_active">True</field>
        </record>

        <record id="price_abc_3" model="logspace.price.matrix">
            <field name="provider_id" ref="provider_abc_logistics"/>
            <field name="vehicle_type_id" ref="vehicle_type_covered_3t"/>
            <field name="zone_from_id" ref="zone_downtown"/>
            <field name="zone_to_id" ref="zone_business"/>
            <field name="distance_km">5.0</field>
            <field name="provider_price">60.0</field>
            <field name="is_active">True</field>
        </record>

        <!-- Fast Truck Co Pricing -->
        <record id="price_ftc_1" model="logspace.price.matrix">
            <field name="provider_id" ref="provider_fast_truck"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_5t"/>
            <field name="zone_from_id" ref="zone_industrial"/>
            <field name="zone_to_id" ref="zone_northern"/>
            <field name="distance_km">20.0</field>
            <field name="provider_price">120.0</field>
            <field name="is_active">True</field>
        </record>

        <record id="price_ftc_2" model="logspace.price.matrix">
            <field name="provider_id" ref="provider_fast_truck"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_5t"/>
            <field name="zone_from_id" ref="zone_industrial"/>
            <field name="zone_to_id" ref="zone_downtown"/>
            <field name="distance_km">25.0</field>
            <field name="provider_price">130.0</field>
            <field name="is_active">True</field>
        </record>

        <!-- City Movers Pricing -->
        <record id="price_cm_1" model="logspace.price.matrix">
            <field name="provider_id" ref="provider_city_movers"/>
            <field name="vehicle_type_id" ref="vehicle_type_van"/>
            <field name="zone_from_id" ref="zone_residential"/>
            <field name="zone_to_id" ref="zone_downtown"/>
            <field name="distance_km">12.0</field>
            <field name="provider_price">45.0</field>
            <field name="is_active">True</field>
        </record>

        <!-- Additional Zone Pairs -->
        <record id="price_abc_4" model="logspace.price.matrix">
            <field name="provider_id" ref="provider_abc_logistics"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_3t"/>
            <field name="zone_from_id" ref="zone_port"/>
            <field name="zone_to_id" ref="zone_downtown"/>
            <field name="distance_km">40.0</field>
            <field name="provider_price">150.0</field>
            <field name="is_active">True</field>
        </record>

        <record id="price_abc_5" model="logspace.price.matrix">
            <field name="provider_id" ref="provider_abc_logistics"/>
            <field name="vehicle_type_id" ref="vehicle_type_flatbed_3t"/>
            <field name="zone_from_id" ref="zone_suburb"/>
            <field name="zone_to_id" ref="zone_metro"/>
            <field name="distance_km">18.0</field>
            <field name="provider_price">85.0</field>
            <field name="is_active">True</field>
        </record>

    </data>
</odoo>
