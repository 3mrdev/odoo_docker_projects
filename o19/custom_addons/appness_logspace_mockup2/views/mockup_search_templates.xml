<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screen 1 & 2: Search and Results Page with Real Data -->
    <template id="mockup2_search_page" name="Logspace Search">
        <t t-call="appness_logspace_mockup2.mockup2_layout">
            <!-- Hero Search Section -->
            <section class="py-5 bg-light">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <h1 class="text-center mb-4">Find the Perfect Truck for Your Move</h1>
                            <p class="text-center text-muted mb-4">Compare prices, read reviews, and book instantly</p>

                            <div class="card shadow-sm">
                                <div class="card-body p-4">
                                    <form action="/logspace/search" method="POST" enctype="multipart/form-data">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <!-- Row 1: Vehicle Type and Zones -->
                                        <div class="row g-3 mb-3">
                                            <!-- Vehicle Type -->
                                            <div class="col-md-3">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-truck me-1"/>
                                                    Vehicle Type
                                                </label>
                                                <select class="form-select" name="vehicle_type_id" required="required">
                                                    <option value="">Select Vehicle...</option>
                                                    <t t-foreach="vehicle_types" t-as="vt">
                                                        <option t-att-value="vt.id" t-att-selected="search_params.get('vehicle_type_id') and str(vt.id) == str(search_params.get('vehicle_type_id'))">
                                                            <t t-esc="vt.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            <!-- Pickup Zone -->
                                            <div class="col-md-3">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-circle text-primary me-1"/>
                                                    From Zone
                                                </label>
                                                <select class="form-select" name="zone_from_id" required="required">
                                                    <option value="">Select Pickup Zone...</option>
                                                    <t t-foreach="zones" t-as="zone">
                                                        <option t-att-value="zone.id" t-att-selected="search_params.get('zone_from_id') and str(zone.id) == str(search_params.get('zone_from_id'))">
                                                            <t t-esc="zone.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            <!-- Dropoff Zone -->
                                            <div class="col-md-3">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-map-marker text-danger me-1"/>
                                                    To Zone
                                                </label>
                                                <select class="form-select" name="zone_to_id" required="required">
                                                    <option value="">Select Dropoff Zone...</option>
                                                    <t t-foreach="zones" t-as="zone">
                                                        <option t-att-value="zone.id" t-att-selected="search_params.get('zone_to_id') and str(zone.id) == str(search_params.get('zone_to_id'))">
                                                            <t t-esc="zone.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            <!-- Pickup Date -->
                                            <div class="col-md-3">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-calendar me-1"/>
                                                    Pickup Date
                                                </label>
                                                <input type="date" class="form-control" name="pickup_date"
                                                       t-att-value="search_params.get('pickup_date')"/>
                                            </div>
                                        </div>
                                        <!-- Row 2: Timeframes and Search -->
                                        <div class="row g-3 align-items-end">
                                            <!-- Pickup Timeframe -->
                                            <div class="col-md-3">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-clock-o text-primary me-1"/>
                                                    Pickup Timeframe
                                                </label>
                                                <select class="form-select" name="pickup_timeframe">
                                                    <option value="">Any Time...</option>
                                                    <option value="8:00-10:00" t-att-selected="search_params.get('pickup_timeframe') == '8:00-10:00'">8:00 - 10:00 AM</option>
                                                    <option value="10:00-12:00" t-att-selected="search_params.get('pickup_timeframe') == '10:00-12:00'">10:00 - 12:00 PM</option>
                                                    <option value="12:00-14:00" t-att-selected="search_params.get('pickup_timeframe') == '12:00-14:00'">12:00 - 2:00 PM</option>
                                                    <option value="14:00-16:00" t-att-selected="search_params.get('pickup_timeframe') == '14:00-16:00'">2:00 - 4:00 PM</option>
                                                    <option value="16:00-18:00" t-att-selected="search_params.get('pickup_timeframe') == '16:00-18:00'">4:00 - 6:00 PM</option>
                                                    <option value="18:00-20:00" t-att-selected="search_params.get('pickup_timeframe') == '18:00-20:00'">6:00 - 8:00 PM</option>
                                                </select>
                                            </div>
                                            <!-- Dropoff Timeframe -->
                                            <div class="col-md-3">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-clock-o text-success me-1"/>
                                                    Dropoff Timeframe
                                                </label>
                                                <select class="form-select" name="dropoff_timeframe">
                                                    <option value="">Any Time...</option>
                                                    <option value="8:00-10:00" t-att-selected="search_params.get('dropoff_timeframe') == '8:00-10:00'">8:00 - 10:00 AM</option>
                                                    <option value="10:00-12:00" t-att-selected="search_params.get('dropoff_timeframe') == '10:00-12:00'">10:00 - 12:00 PM</option>
                                                    <option value="12:00-14:00" t-att-selected="search_params.get('dropoff_timeframe') == '12:00-14:00'">12:00 - 2:00 PM</option>
                                                    <option value="14:00-16:00" t-att-selected="search_params.get('dropoff_timeframe') == '14:00-16:00'">2:00 - 4:00 PM</option>
                                                    <option value="16:00-18:00" t-att-selected="search_params.get('dropoff_timeframe') == '16:00-18:00'">4:00 - 6:00 PM</option>
                                                    <option value="18:00-20:00" t-att-selected="search_params.get('dropoff_timeframe') == '18:00-20:00'">6:00 - 8:00 PM</option>
                                                </select>
                                            </div>
                                            <!-- Search Button -->
                                            <div class="col-md-6">
                                                <button type="submit" class="btn btn-primary w-100">
                                                    <i class="fa fa-search me-2"/>
                                                    Search Available Trucks
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Results Section -->
            <t t-if="show_results">
                <section class="py-4">
                    <div class="container logspace-results">
                        <!-- No Results Message -->
                        <t t-if="not results">
                            <div class="alert alert-info text-center py-5">
                                <i class="fa fa-info-circle fa-3x mb-3"/>
                                <h4>No trucks available for this route</h4>
                                <p class="mb-0">Try selecting different zones or vehicle type.</p>
                            </div>
                        </t>

                        <!-- Results Found -->
                        <t t-if="results">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="mb-0">
                                    <span t-esc="len(results)"/> Provider<t t-if="len(results) != 1">s</t> Available
                                </h5>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-secondary js-view-grid active">
                                        <i class="fa fa-th-large"/> Grid
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary js-view-list">
                                        <i class="fa fa-list"/> List
                                    </button>
                                </div>
                            </div>

                            <!-- Grid View -->
                            <div class="row g-4" id="grid-view">
                                <t t-foreach="results" t-as="result">
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 shadow-sm border-0">
                                            <!-- Timeframe Warning Badge -->
                                            <t t-if="not result['timeframe_available'] and result['requested_timeframe']">
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge bg-warning">Timeframe Limited</span>
                                                </div>
                                            </t>
                                            <div class="card-img-top bg-light text-center">
                                                <img t-att-src="result['vehicle_type_image']" class="img-fluid"
                                                     style="width: 100%; height: 200px; object-fit: cover;"
                                                     t-att-alt="result['vehicle_type_name']"/>
                                            </div>
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h5 class="card-title mb-0" t-esc="result['vehicle_type_name']"/>
                                                    <span class="badge bg-success">
                                                        $<t t-esc="'%.2f' % result['price']"/>
                                                    </span>
                                                </div>
                                                <p class="text-muted small mb-2">
                                                    <i class="fa fa-building-o me-1"/>
                                                    <span t-esc="result['provider_name']"/>
                                                </p>
                                                <div class="mb-2">
                                                    <span class="text-warning">
                                                        <i class="fa fa-star"/>
                                                        <span t-esc="'%.1f' % result['rating'] if result['rating'] else 'N/A'"/>
                                                    </span>
                                                    <span class="text-muted small ms-1">
                                                        (<span t-esc="result['reviews']"/> reviews)
                                                    </span>
                                                </div>
                                                <!-- Zones -->
                                                <div class="mb-2 small bg-light p-2 rounded">
                                                    <p class="mb-1">
                                                        <i class="fa fa-circle text-primary me-1"/>
                                                        <strong>From:</strong> <span t-esc="result['zone_from']"/>
                                                    </p>
                                                    <p class="mb-0">
                                                        <i class="fa fa-map-marker text-danger me-1"/>
                                                        <strong>To:</strong> <span t-esc="result['zone_to']"/>
                                                    </p>
                                                </div>
                                                <!-- Available Timeframes -->
                                                <div class="mb-2 small">
                                                    <p class="mb-1 text-muted">
                                                        <i class="fa fa-clock-o text-primary me-1"/>
                                                        <strong>Available Times:</strong>
                                                    </p>
                                                    <t t-foreach="result['timeframes']" t-as="tf">
                                                        <span class="badge bg-light text-dark me-1" t-esc="tf.name"/>
                                                    </t>
                                                    <t t-if="not result['timeframes']">
                                                        <span class="text-muted">Contact for availability</span>
                                                    </t>
                                                </div>
                                                <a t-att-href="result['vehicle_info_url']" class="btn btn-primary w-100">
                                                    View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <!-- List View (Hidden by default) -->
                            <div class="d-none" id="list-view">
                                <div class="card">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Vehicle</th>
                                                    <th>Provider</th>
                                                    <th>Route</th>
                                                    <th>Available Times</th>
                                                    <th>Price</th>
                                                    <th>Rating</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="results" t-as="result">
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                <img t-att-src="result['vehicle_type_image']"
                                                                     class="rounded me-3"
                                                                     style="width: 60px; height: 60px; object-fit: cover;"/>
                                                                <div>
                                                                    <strong t-esc="result['vehicle_type_name']"/>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td t-esc="result['provider_name']"/>
                                                        <td>
                                                            <small>
                                                                <i class="fa fa-circle text-primary me-1"/>
                                                                <span t-esc="result['zone_from']"/>
                                                                <br/>
                                                                <i class="fa fa-map-marker text-danger me-1"/>
                                                                <span t-esc="result['zone_to']"/>
                                                            </small>
                                                        </td>
                                                        <td>
                                                            <t t-foreach="result['timeframes'][:2]" t-as="tf">
                                                                <span class="badge bg-light text-dark me-1" t-esc="tf.name"/>
                                                            </t>
                                                            <t t-if="len(result['timeframes']) > 2">
                                                                <span class="badge bg-secondary">+<span t-esc="len(result['timeframes']) - 2"/> more</span>
                                                            </t>
                                                        </td>
                                                        <td>
                                                            <span class="fw-bold text-success">
                                                                $<t t-esc="'%.2f' % result['price']"/>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="text-warning">
                                                                <i class="fa fa-star"/>
                                                                <span t-esc="'%.1f' % result['rating'] if result['rating'] else 'N/A'"/>
                                                            </span>
                                                            <small class="text-muted">(<span t-esc="result['reviews']"/>)</small>
                                                        </td>
                                                        <td>
                                                            <a t-att-href="result['vehicle_info_url']"
                                                               class="btn btn-primary btn-sm">View Details</a>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>
            </t>

            <!-- Initial State - No Search Yet -->
            <t t-if="not show_results">
                <section class="py-5">
                    <div class="container text-center">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <i class="fa fa-search fa-4x text-muted mb-4"/>
                                <h3>Start Your Search</h3>
                                <p class="text-muted">Select your pickup and dropoff zones, vehicle type, and preferred timeframe to find available trucks.</p>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </t>
    </template>
</odoo>
