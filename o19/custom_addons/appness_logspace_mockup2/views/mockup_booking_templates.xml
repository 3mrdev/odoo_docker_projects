<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screen 4: Add-ons Step (Now Step 2) -->
    <template id="mockup2_addons_page" name="Logspace Booking - Add-ons">
        <t t-call="appness_logspace_mockup2.mockup2_layout">
            <div class="container py-4">
                <h3 class="mb-4">Customize Your Booking</h3>
                <t t-call="appness_logspace_mockup2.mockup2_stepper"/>

                <div class="row">
                    <div class="col-lg-8">
                        <div class="card mb-4">
                            <div class="card-body">
                                <h5 class="card-title mb-4">Select Add-ons</h5>
                                <form action="/logspace/booking/checkout" method="GET">
                                    <div class="row">
                                        <t t-foreach="addons" t-as="addon">
                                            <div class="col-md-6 mb-3">
                                                <div class="card border">
                                                    <div class="card-body">
                                                        <div class="d-flex align-items-start">
                                                            <div class="form-check mt-1">
                                                                <input class="form-check-input" type="checkbox" name="addon" t-attf-value="#{addon['id']}"/>
                                                            </div>
                                                            <div class="ms-3 flex-grow-1">
                                                                <h6 class="mb-1" t-esc="addon['name']"/>
                                                                <p class="small text-muted mb-2" t-esc="addon['description']"/>
                                                                <span class="text-success fw-bold">+<span t-esc="'$' + str(int(addon['price']))"/></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="d-flex justify-content-between mt-4">
                                        <a href="/logspace/booking/details" class="btn btn-outline-secondary">Back</a>
                                        <button type="submit" class="btn btn-primary">Continue to Checkout</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6>Booking Summary</h6>
                                <p class="small text-muted mb-0">Flatbed Truck 3T</p>
                                <p class="small text-muted mb-2">ABC Logistics</p>
                                <hr class="my-2"/>
                                <p class="small mb-1"><i class="fa fa-box text-primary me-1"></i> 10 Items, 500kg</p>
                                <p class="small mb-1"><i class="fa fa-comment text-muted me-1"></i> Handle with care</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 5: Item Details Step (Now Step 1) - With Real Data -->
    <template id="mockup2_details_page" name="Logspace Booking - Details">
        <t t-call="appness_logspace_mockup2.mockup2_layout">
            <div class="container py-4">
                <h3 class="mb-4">Item Details</h3>
                <t t-call="appness_logspace_mockup2.mockup2_stepper"/>

                <div class="row">
                    <div class="col-lg-8">
                        <!-- Unregistered User Warning -->
                        <t t-if="not user or user._is_public()">
                            <div class="alert alert-warning mb-4">
                                <i class="fa fa-exclamation-triangle me-2"/>
                                <strong>Guest Checkout:</strong> Your contact data will not be verified before the final confirmation.
                                <a t-attf-href="/logspace/login?redirect=/logspace/booking/details">Sign in</a> for a verified booking experience.
                            </div>
                        </t>

                        <div class="card mb-4">
                            <div class="card-body">
                                <h5 class="card-title mb-4">Booking Details</h5>
                                <form action="/logspace/booking/details" method="POST" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="provider_id" t-att-value="booking_data.get('provider_id')"/>
                                    <input type="hidden" name="vehicle_type_id" t-att-value="booking_data.get('vehicle_type_id')"/>
                                    <input type="hidden" name="zone_from_id" t-att-value="booking_data.get('zone_from_id')"/>
                                    <input type="hidden" name="zone_to_id" t-att-value="booking_data.get('zone_to_id')"/>
                                    <input type="hidden" name="price_matrix_id" t-att-value="booking_data.get('price_matrix_id')"/>
                                    <input type="hidden" name="price" t-att-value="booking_data.get('price')"/>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Pickup Date</label>
                                            <input type="date" class="form-control" name="pickup_date"
                                                   t-att-value="booking_data.get('pickup_date')" required="required"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Pickup Timeframe</label>
                                            <select class="form-select" name="pickup_timeframe" required="required">
                                                <option value="">Select Time...</option>
                                                <t t-foreach="timeframes" t-as="tf">
                                                    <option t-att-value="tf.name" t-att-selected="tf.name == booking_data.get('pickup_timeframe')">
                                                        <t t-esc="tf.name"/> (<t t-esc="'Pickup' if tf.is_pickup else ''"/> <t t-esc="'Dropoff' if tf.is_dropoff else ''"/>)
                                                    </option>
                                                </t>
                                                <option value="custom">Other - Contact Provider</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Dropoff Timeframe</label>
                                        <select class="form-select" name="dropoff_timeframe">
                                            <option value="">Select Time...</option>
                                            <option value="8:00-10:00">8:00 - 10:00</option>
                                            <option value="10:00-12:00">10:00 - 12:00</option>
                                            <option value="12:00-14:00">12:00 - 14:00</option>
                                            <option value="14:00-16:00">14:00 - 16:00</option>
                                            <option value="16:00-18:00">16:00 - 18:00</option>
                                            <option value="18:00-20:00">18:00 - 20:00</option>
                                            <option value="custom">Other - Contact Provider</option>
                                        </select>
                                    </div>

                                    <hr class="my-4"/>
                                    <h5 class="card-title mb-4">
                                        <i class="fa fa-map-marker text-primary me-2"/>
                                        Pickup Address
                                    </h5>
                                    <div class="mb-3">
                                        <textarea class="form-control" name="pickup_address" rows="2" placeholder="Full pickup address with landmarks" required="required"
                                                  t-esc="booking_data.get('pickup_address')"/>
                                    </div>

                                    <hr class="my-4"/>
                                    <h5 class="card-title mb-4">
                                        <i class="fa fa-map-marker text-success me-2"/>
                                        Dropoff Address
                                    </h5>
                                    <div class="mb-3">
                                        <textarea class="form-control" name="dropoff_address" rows="2" placeholder="Full dropoff address with landmarks" required="required"
                                                  t-esc="booking_data.get('dropoff_address')"/>
                                    </div>

                                    <hr class="my-4"/>
                                    <h5 class="card-title mb-4">Item Information</h5>
                                    <div class="mb-3">
                                        <label class="form-label">Item Description</label>
                                        <textarea class="form-control" rows="3" name="item_description" placeholder="What are you moving? (e.g., furniture, boxes, equipment)"
                                                  t-esc="booking_data.get('item_description')"/>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Quantity</label>
                                            <input type="number" class="form-control" name="item_quantity" min="1"
                                                   t-att-value="booking_data.get('item_quantity', 1)"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Estimated Weight (kg)</label>
                                            <input type="number" class="form-control" name="estimated_weight_kg" min="0"
                                                   t-att-value="booking_data.get('estimated_weight_kg', 0)"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Special Instructions</label>
                                        <textarea class="form-control" rows="2" name="special_instructions" placeholder="Any special handling requirements"
                                                  t-esc="booking_data.get('special_instructions')"/>
                                    </div>

                                    <!-- Pickup Contact Info -->
                                    <hr class="my-4"/>
                                    <h5 class="card-title mb-4">
                                        <i class="fa fa-user-circle text-primary me-2"/>
                                        Pickup Contact Information
                                    </h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Contact Name *</label>
                                            <input type="text" class="form-control" name="pickup_contact_name"
                                                   placeholder="Person at pickup location" required="required"
                                                   t-att-value="booking_data.get('pickup_contact_name')"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Contact Phone *</label>
                                            <input type="tel" class="form-control" name="pickup_contact_phone"
                                                   placeholder="Phone number for pickup" required="required"
                                                   t-att-value="booking_data.get('pickup_contact_phone')"/>
                                        </div>
                                    </div>

                                    <!-- Dropoff Contact Info -->
                                    <hr class="my-4"/>
                                    <h5 class="card-title mb-4">
                                        <i class="fa fa-user-circle text-success me-2"/>
                                        Dropoff Contact Information
                                    </h5>
                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="same_as_pickup"
                                                   onclick="if(this.checked){document.querySelector('[name=dropoff_contact_name]').value=document.querySelector('[name=pickup_contact_name]').value;document.querySelector('[name=dropoff_contact_phone]').value=document.querySelector('[name=pickup_contact_phone]').value;}"/>
                                            <label class="form-check-label" for="same_as_pickup">
                                                Same as pickup contact
                                            </label>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Contact Name *</label>
                                            <input type="text" class="form-control" name="dropoff_contact_name"
                                                   placeholder="Person at dropoff location" required="required"
                                                   t-att-value="booking_data.get('dropoff_contact_name')"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Contact Phone *</label>
                                            <input type="tel" class="form-control" name="dropoff_contact_phone"
                                                   placeholder="Phone number for dropoff" required="required"
                                                   t-att-value="booking_data.get('dropoff_contact_phone')"/>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between mt-4">
                                        <a href="/logspace/search" class="btn btn-outline-secondary">Back to Search</a>
                                        <button type="submit" class="btn btn-primary">Continue to Add-ons</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6>Booking Summary</h6>
                                <p class="small text-muted mb-0" t-if="booking_data.get('vehicle_type_id')">
                                    <t t-set="vt" t-value="request.env['logspace.vehicle.type'].sudo().browse(booking_data.get('vehicle_type_id'))"/>
                                    <t t-esc="vt.name"/>
                                </p>
                                <p class="small text-muted" t-if="booking_data.get('provider_id')">
                                    <t t-set="provider" t-value="request.env['res.partner'].sudo().browse(booking_data.get('provider_id'))"/>
                                    <t t-esc="provider.name"/>
                                </p>
                                <hr class="my-2"/>
                                <p class="small mb-1" t-if="booking_data.get('zone_from_id')">
                                    <i class="fa fa-circle text-primary me-1"/>
                                    From: <t t-esc="request.env['logspace.zone'].sudo().browse(booking_data.get('zone_from_id')).name"/>
                                </p>
                                <p class="small mb-1" t-if="booking_data.get('zone_to_id')">
                                    <i class="fa fa-map-marker text-danger me-1"/>
                                    To: <t t-esc="request.env['logspace.zone'].sudo().browse(booking_data.get('zone_to_id')).name"/>
                                </p>
                                <p class="small mb-0" t-if="booking_data.get('price')">
                                    <hr class="my-2"/>
                                    <strong>Base Price: $<t t-esc="'%.2f' % booking_data.get('price', 0)"/></strong>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 6: Checkout Step with Real Data -->
    <template id="mockup2_checkout_page" name="Logspace Booking - Checkout">
        <t t-call="appness_logspace_mockup2.mockup2_layout">
            <div class="container py-4">
                <h3 class="mb-4">Review &amp; Checkout</h3>
                <t t-call="appness_logspace_mockup2.mockup2_stepper"/>

                <form action="/logspace/booking/checkout" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="row">
                        <div class="col-lg-8">
                            <!-- Order Summary -->
                            <div class="card mb-4">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0">Order Summary</h5>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="fa fa-truck fa-2x text-muted me-3"/>
                                        <div>
                                            <h6 class="mb-0" t-esc="vehicle_type_name"/>
                                            <small class="text-muted" t-esc="provider_name"/>
                                        </div>
                                    </div>
                                    <hr/>
                                    <!-- Order Dates -->
                                    <div class="row mb-2">
                                        <div class="col-6"><i class="fa fa-calendar-plus-o text-muted me-1"/> Order Created</div>
                                        <div class="col-6"><span t-esc="datetime.datetime.now().strftime('%b %d, %Y %H:%M')"/></div>
                                    </div>
                                    <div class="row mb-3" t-if="booking_data.get('pickup_date')">
                                        <div class="col-6"><i class="fa fa-calendar-check-o text-primary me-1"/> Scheduled For</div>
                                        <div class="col-6 text-primary" t-esc="booking_data.get('pickup_date')"/>
                                    </div>
                                    <hr/>
                                    <div class="row mb-2">
                                        <div class="col-6"><i class="fa fa-circle text-muted me-1"/> From Zone</div>
                                        <div class="col-6" t-esc="zone_from_name"/>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-6"><i class="fa fa-map-marker text-danger me-1"/> To Zone</div>
                                        <div class="col-6" t-esc="zone_to_name"/>
                                    </div>
                                    <div class="row mb-2" t-if="booking_data.get('pickup_address')">
                                        <div class="col-6"><i class="fa fa-circle text-primary me-1"/> Pickup Address</div>
                                        <div class="col-6" t-esc="booking_data.get('pickup_address')"/>
                                    </div>
                                    <div class="row mb-2" t-if="booking_data.get('pickup_timeframe')">
                                        <div class="col-6"><i class="fa fa-clock-o text-primary me-1"/> Pickup Time</div>
                                        <div class="col-6"><span class="badge bg-primary" t-esc="booking_data.get('pickup_timeframe')"/></div>
                                    </div>
                                    <div class="row mb-2" t-if="booking_data.get('dropoff_address')">
                                        <div class="col-6"><i class="fa fa-map-marker text-danger me-1"/> Dropoff Address</div>
                                        <div class="col-6" t-esc="booking_data.get('dropoff_address')"/>
                                    </div>
                                    <div class="row mb-3" t-if="booking_data.get('dropoff_timeframe')">
                                        <div class="col-6"><i class="fa fa-clock-o text-success me-1"/> Dropoff Time</div>
                                        <div class="col-6"><span class="badge bg-success" t-esc="booking_data.get('dropoff_timeframe')"/></div>
                                    </div>
                                    <t t-foreach="selected_addons" t-as="addon">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span><i class="fa fa-check text-success me-1"/> <span t-esc="addon['name']"/></span>
                                            <span t-esc="'$%.2f' % addon['price']"/>
                                        </div>
                                    </t>
                                    <hr t-if="selected_addons"/>
                                    <!-- Pricing Breakdown -->
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Base Price</span>
                                        <span t-esc="'$%.2f' % truck_price"/>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2" t-if="addon_total">
                                        <span>Add-ons</span>
                                        <span t-esc="'$%.2f' % addon_total"/>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tax (10%)</span>
                                        <span t-esc="'$%.2f' % tax"/>
                                    </div>
                                    <div class="d-flex justify-content-between fw-bold text-success fs-5">
                                        <span>Total</span>
                                        <span t-esc="'$%.2f' % total"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Guest Email (for non-logged in users) -->
                            <t t-if="not user or user._is_public()">
                                <div class="card mb-4">
                                    <div class="card-header bg-white">
                                        <h5 class="mb-0">Contact Information</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="alert alert-info">
                                            <i class="fa fa-info-circle me-2"/>
                                            Guest checkout is available. An account will be created for you automatically.
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Email *</label>
                                                <input type="email" class="form-control" name="guest_email" placeholder="For order confirmation" required="required"/>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Phone *</label>
                                                <input type="tel" class="form-control" name="guest_phone" placeholder="For driver contact" required="required"/>
                                            </div>
                                        </div>
                                        <div class="text-center">
                                            <p class="text-muted">Already have an account?
                                                <a t-attf-href="/logspace/login?redirect=/logspace/booking/checkout">Sign in</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <div class="d-flex justify-content-between mt-4">
                                <a href="/logspace/booking/addons" class="btn btn-outline-secondary">Back</a>
                                <button type="submit" class="btn btn-primary btn-lg">Proceed to Payment</button>
                            </div>
                        </div>

                    <div class="col-lg-4">
                        <div class="card">
                            <div class="card-body">
                                <h6>Booking Details</h6>
                                <div class="mb-3 small">
                                    <p class="mb-1 text-muted"><i class="fa fa-calendar-plus-o me-1"></i> Order Created</p>
                                    <p class="mb-0"><span t-esc="datetime.datetime.now().strftime('%b %d, %Y %H:%M')"/></p>
                                </div>
                                <div class="mb-3 small">
                                    <p class="mb-1 text-muted"><i class="fa fa-calendar-check-o me-1"></i> Scheduled</p>
                                    <p class="mb-0 text-primary">Jan 20, 2025</p>
                                </div>
                                <div class="mb-3 small">
                                    <p class="mb-1 text-muted"><i class="fa fa-clock-o me-1"></i> Pickup Timeframe</p>
                                    <p class="mb-0"><span class="badge bg-primary">10:00 AM - 12:00 PM</span></p>
                                </div>
                                <div class="mb-3 small">
                                    <p class="mb-1 text-muted"><i class="fa fa-clock-o me-1"></i> Dropoff Timeframe</p>
                                    <p class="mb-0"><span class="badge bg-success">2:00 PM - 4:00 PM</span></p>
                                </div>
                                <hr/>
                                <h6>Price Breakdown</h6>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Truck Service</span>
                                    <span t-esc="'$' + str(truck_price)"/>
                                </div>
                                <t t-foreach="addons" t-as="addon">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span><span t-esc="addon['name']"/></span>
                                        <span t-esc="'$' + str(int(addon['price']))"/>
                                    </div>
                                </t>
                                <hr/>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal</span>
                                    <span t-esc="'$' + str(subtotal)"/>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tax</span>
                                    <span t-esc="'$' + str(tax)"/>
                                </div>
                                <hr/>
                                <div class="d-flex justify-content-between fw-bold fs-5">
                                    <span>Total</span>
                                    <span class="text-success" t-esc="'$' + str(total)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 7: Payment Step -->
    <template id="mockup2_payment_page" name="Logspace Booking - Payment">
        <t t-call="appness_logspace_mockup2.mockup2_layout">
            <div class="container py-4">
                <h3 class="mb-4">Payment</h3>
                <t t-call="appness_logspace_mockup2.mockup2_stepper"/>

                <div class="row justify-content-center">
                    <div class="col-lg-6">
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="text-center mb-4">
                                    <h4 class="mb-1">Total Amount</h4>
                                    <h2 class="text-success" t-esc="'$' + str(total)"/>
                                </div>

                                <h6 class="mb-3"><i class="fa fa-credit-card me-2"></i>Paymob</h6>
                                <form action="/logspace/booking/done" method="GET">
                                    <div class="mb-3">
                                        <label class="form-label">Card Number</label>
                                        <input type="text" class="form-control" placeholder="0000 0000 0000 0000"/>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Expiry Date</label>
                                            <input type="text" class="form-control" placeholder="MM/YY"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">CVV</label>
                                            <input type="text" class="form-control" placeholder="123"/>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Cardholder Name</label>
                                        <input type="text" class="form-control" placeholder="Name on card"/>
                                    </div>
                                    <div class="d-flex justify-content-between mt-4">
                                        <a href="/logspace/booking/checkout" class="btn btn-outline-secondary">Back</a>
                                        <button type="submit" class="btn btn-success btn-lg">Pay <span t-esc="'$' + str(total)"/></button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 8: Booking Done -->
    <template id="mockup2_done_page" name="Logspace Booking - Success">
        <t t-call="appness_logspace_mockup2.mockup2_layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">
                        <div class="mb-4">
                            <i class="fa fa-check-circle fa-5x text-success"></i>
                        </div>
                        <h2 class="mb-3">Booking Confirmed!</h2>
                        <p class="lead text-muted mb-4">Your truck has been booked successfully.</p>

                        <div class="card mb-4 text-start">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
