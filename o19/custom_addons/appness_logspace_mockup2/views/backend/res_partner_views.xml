<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================================= -->
    <!-- Provider Form View - Inherits res.partner form -->
    <!-- ========================================================================= -->
    <record id="view_res_partner_provider_form" model="ir.ui.view">
        <field name="name">res.partner.provider.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Add status bar after name -->
            <xpath expr="//sheet" position="before">
                <header invisible="not is_provider">
                    <button name="%(action_logspace_zone_setup_wizard)d"
                            type="action"
                            string="Setup Zones"
                            class="oe_highlight"
                            context="{'default_provider_id': id}"/>
                    <button string="Submit" name="action_submit_provider" type="object" class="oe_highlight" invisible="state != 'draft'" groups="appness_logspace_mockup2.group_logspace_admin"/>
                    <button string="Approve" name="action_approve_provider" type="object" class="oe_highlight" invisible="state != 'pending'" groups="appness_logspace_mockup2.group_logspace_admin"/>
                    <button string="Reject" name="action_reject_provider" type="object" invisible="state != 'pending'" groups="appness_logspace_mockup2.group_logspace_admin"/>
                    <button string="Resubmit" name="action_resubmit_provider" type="object" invisible="state != 'rejected'" groups="appness_logspace_mockup2.group_logspace_provider"/>
                    <button string="Suspend" name="action_suspend_provider" type="object" invisible="state != 'approved'" groups="appness_logspace_mockup2.group_logspace_admin"/>
                    <button string="Reactivate" name="action_reactivate_provider" type="object" invisible="state != 'suspended'" groups="appness_logspace_mockup2.group_logspace_admin"/>
                    <button name="action_download_vehicles_excel" string="Download Vehicles Import Excel Template" type="object" class="btn btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,rejected,suspended"/>
                </header>
            </xpath>

            <xpath expr="//sheet/group[1]" position="replace">
                <group invisible="not is_provider">
                    <group string="Business Information">
                        <field name="tax_id"/>
                        <field name="cr_number"/>
                        <field name="years_experience"/>
                        <field name="platform_fee_percentage"/>
                    </group>
                    <group string="Status">
                        <field name="is_approved_provider" readonly="1"/>
                        <field name="approval_date" readonly="1"/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                        <field name="suspension_reason" invisible="state != 'suspended'"/>
                    </group>
                </group>
                <group invisible="is_provider">
                    <group>
                        <field name="parent_id" widget="res_partner_many2one" placeholder="Company Name..." string="Company" domain="[('is_company', '=', True)]" context="{'default_is_company': True, 'default_user_id': user_id, 'show_address': False}" invisible="((is_company and not parent_id) or company_name) and company_name != ''"/>
                        <div colspan="2" class="d-flex gap-2" invisible="not company_name or company_name == '' or is_company">
                            <label for="company_name" class="fw-bold text-nowrap"/>
                            <field name="company_name"/>
                            <button name="create_company" icon="fa-plus-square" string="Create" type="object" class="oe_edit_only btn-link text-nowrap"/>
                        </div>
                        <span class="o_form_label o_td_label o_address_type" name="address_name">
                            <field name="type_address_label" invisible="is_company" readonly="1" class="fw-bold"/>
                            <span invisible="not is_company">Address</span>
                        </span>
                        <div class="o_address_format">
                            <field name="street" placeholder="Street..." class="o_address_street"/>
                            <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                            <field name="city" placeholder="City" class="o_address_city"/>
                            <field name="state_id" placeholder="State" class="o_address_state" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                            <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                            <div name="partner_address_country" class="d-flex justify-content-between">
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                            </div>
                        </div>
                    </group>
                    <group>
                        <field name="function" placeholder="e.g. Sales Director" invisible="is_company"/>
                        <field name="vat" placeholder="e.g. BE0477472701"/>
                        <field name="website" string="Website" widget="url" placeholder="e.g. https://www.odoo.com"/>
                        <field name="lang" invisible="active_lang_count &lt;= 1"/>
                        <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="e.g. &quot;B2B&quot;, &quot;VIP&quot;, &quot;Consulting&quot;, ..."/>
                    </group>
                </group>
            </xpath>

            <!-- Provider-specific notebook pages -->
            <xpath expr="//notebook/page[1]" position="after">
                <page string="General Info" invisible="not is_provider">
                    <group>
                        <group>
                            <field name="parent_id" widget="res_partner_many2one" placeholder="Company Name..." string="Company" domain="[('is_company', '=', True)]" context="{'default_is_company': True, 'default_user_id': user_id, 'show_address': False}" invisible="((is_company and not parent_id) or company_name) and company_name != ''"/>
                            <div colspan="2" class="d-flex gap-2" invisible="not company_name or company_name == '' or is_company">
                                <label for="company_name" class="fw-bold text-nowrap"/>
                                <field name="company_name"/>
                                <button name="create_company" icon="fa-plus-square" string="Create" type="object" class="oe_edit_only btn-link text-nowrap"/>
                            </div>
                            <span class="o_form_label o_td_label o_address_type" name="address_name">
                                <field name="type_address_label" invisible="is_company" readonly="1" class="fw-bold"/>
                                <span invisible="not is_company">Address</span>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" placeholder="State" class="o_address_state" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="function" placeholder="e.g. Sales Director" invisible="is_company"/>
                            <field name="vat" placeholder="e.g. BE0477472701"/>
                            <field name="website" string="Website" widget="url" placeholder="e.g. https://www.odoo.com"/>
                            <field name="lang" invisible="active_lang_count &lt;= 1"/>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="e.g. &quot;B2B&quot;, &quot;VIP&quot;, &quot;Consulting&quot;, ..."/>
                        </group>
                    </group>
                    <group string="Fleet Summary"></group>
                    <field name="fleet_summary_ids">
                        <list editable="bottom">
                            <field name="vehicle_type_id"/>
                            <field name="fleet_count"/>
                            <field name="capacity_tons"/>
                            <field name="dimensions"/>
                        </list>
                    </field>
                    <group string="Special Instructions"></group>
                    <field name="special_instruction_ids">
                        <list editable="bottom">
                            <field name="vehicle_type_id"/>
                            <field name="instructions" widget="html"/>
                            <field name="is_active"/>
                        </list>
                    </field>
                    <group string="Time Frames"></group>
                    <field name="time_frame_ids">
                        <list editable="bottom">
                            <field name="vehicle_type_id"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="is_pickup"/>
                            <field name="is_dropoff"/>
                            <field name="name"/>
                        </list>
                    </field>
                </page>

                <!-- Vehicles Page -->
                <page string="Vehicles" invisible="not is_provider">
                    <field name="logspace_vehicle_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="plate_number"/>
                            <field name="vehicle_type_id"/>
                            <field name="zone_id"/>
                            <field name="driver_id"/>
                            <field name="is_active"/>
                        </list>
                    </field>
                </page>

                <!-- Price Matrix Page -->
                <page string="Price Matrix" invisible="not is_provider">
                    <field name="logspace_price_matrix_ids">
                        <list editable="bottom">
                            <field name="zone_from_id"/>
                            <field name="zone_to_id"/>
                            <field name="vehicle_type_id"/>
                            <field name="distance_km"/>
                            <field name="provider_price"/>
                            <field name="is_active"/>
                        </list>
                    </field>
                </page>

                <!-- Vehicle Type Add-ons Page -->
                <page string="Vehicle Type Add-ons" invisible="not is_provider">
                    <field name="vehicle_type_addon_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="vehicle_type_id"/>
                            <field name="addon_id"/>
                            <field name="provider_price"/>
                            <field name="is_active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ========================================================================= -->
    <!-- Provider List View -->
    <!-- ========================================================================= -->
    <record id="view_res_partner_provider_tree" model="ir.ui.view">
        <field name="name">res.partner.provider.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_provider" invisible="1"/>
                <field name="state" widget="badge" decoration-success="state=='approved'" decoration-warning="state=='pending'" decoration-danger="state in ['rejected','suspended']"/>
                <field name="is_approved_provider"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="logspace_vehicle_count"/>
                <field name="logspace_rating"/>
            </list>
        </field>
    </record>

    <!-- ========================================================================= -->
    <!-- Provider Search View -->
    <!-- ========================================================================= -->
    <record id="view_res_partner_provider_search" model="ir.ui.view">
        <field name="name">res.partner.provider.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="tax_id"/>
                <field name="cr_number"/>
                <separator/>
                <filter name="filter_providers" string="Is Provider" domain="[('is_provider', '=', True)]"/>
                <filter name="filter_approved" string="Approved" domain="[('is_provider', '=', True), ('state', '=', 'approved')]"/>
                <filter name="filter_pending" string="Pending" domain="[('is_provider', '=', True), ('state', '=', 'pending')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('is_provider', '=', True), ('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_years_experience" string="Experience" context="{'group_by': 'years_experience'}"/>
            </search>
        </field>
    </record>

    <!-- ========================================================================= -->
    <!-- Provider Action -->
    <!-- ========================================================================= -->
    <record id="action_res_partner_provider" model="ir.actions.act_window">
        <field name="name">Logspace Providers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_res_partner_provider_tree')})
        ]"/>
        <field name="search_view_id" ref="view_res_partner_provider_search"/>
        <field name="context">{'default_is_provider': True, 'default_is_company': True, 'create': False}</field>
        <field name="domain">[('is_provider', '=', True)]</field>
    </record>

    <!-- ========================================================================= -->
    <!-- All Partners Action (for comparison - shows all) -->
    <!-- ========================================================================= -->
    <record id="action_res_partner_all" model="ir.actions.act_window">
        <field name="name">All Partners</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
