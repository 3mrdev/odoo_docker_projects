<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================================= -->
    <!-- Sale Order Form View Extension -->
    <!-- ========================================================================= -->
    <record id="view_sale_order_form_inherit_logspace" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.logspace</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Smart Buttons to button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_logspace_tickets" type="object"
                    class="oe_stat_button" icon="fa-ticket"
                    invisible="not is_logspace_order">
                    <field name="logspace_ticket_count" widget="statinfo" string="Tickets"/>
                </button>
                <button name="action_view_logspace_refunds" type="object"
                    class="oe_stat_button" icon="fa-ticket"
                    invisible="not is_logspace_order">
                    <field name="logspace_refund_count" widget="statinfo" string="Refunds"/>
                </button>
                <button name="action_view_logspace_ratings" type="object"
                    class="oe_stat_button" icon="fa-star"
                    invisible="not is_logspace_order">
                    <field name="logspace_rating_count" widget="statinfo" string="Ratings"/>
                </button>
            </xpath>

            <!-- Add is_logspace_order checkbox in header -->
            <xpath expr="//sheet/div[1]" position="before">
                <field name="is_logspace_order" invisible="1"/>
                <field name="logspace_state" widget="statusbar"
                    invisible="not is_logspace_order"
                    statusbar_visible="order_received,pickup_started,vendor_arrived_pickup,pickup_completed,arrived_destination,dropoff_completed,grace_period,order_completed"/>
            </xpath>


            <!-- Logspace Provider Tabs -->
            <xpath expr="//notebook/page[1]" position="after">
                <!-- Provider & Vehicle Page -->
                <page string="Provider &amp; Vehicle" invisible="not is_logspace_order">
                    <group>
                        <group>
                            <field name="logspace_provider_id"/>
                            <field name="logspace_vehicle_id"
                                domain="[('provider_id', '=', logspace_provider_id), ('is_active', '=', True)]"/>
                            <field name="logspace_driver_id"/>
                            <field name="driver_phone"/>
                        </group>
                        <group>
                            <field name="pickup_zone_id"/>
                            <field name="dropoff_zone_id"/>
                            <field name="scheduled_date"/>
                            <field name="delivery_date" readonly="1" invisible="not delivery_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payment">
                            <field name="payment_status"/>
                            <field name="payment_method"/>
                            <field name="transaction_ref"/>
                        </group>
                        <group string="Order Type">
                            <field name="is_logspace_order" widget="boolean_toggle"/>
                            <field name="is_guest_order" invisible="not is_logspace_order"/>
                        </group>
                    </group>
                </page>

                <page string="Items &amp; Add-ons" invisible="not is_logspace_order">
                    <group>
                        <field name="item_description"/>
                    </group>
                    <group string="Add-ons">
                        <field name="logspace_addon_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Contacts">
                        <group string="Pickup">
                            <field name="pickup_contact_name"/>
                            <field name="pickup_contact_phone"/>
                            <field name="pickup_address"/>
                        </group>
                        <group string="Dropoff">
                            <field name="dropoff_contact_name"/>
                            <field name="dropoff_contact_phone"/>
                            <field name="dropoff_address"/>
                        </group>
                    </group>
                    <group string="Scheduling">
                        <field name="pickup_timeframe"/>
                        <field name="dropoff_timeframe"/>
                    </group>
                    <group string="Verification" >
                        <field name="verification_code_pickup" readonly="1"/>
                        <field name="verification_code_dropoff" readonly="1"/>
                    </group>
                </page>
            </xpath>

            <!-- Add Logspace buttons to header - Sequential by logspace status -->
            <xpath expr="//button[@name='action_confirm']" position="after">
                <!-- Order Received: Start Pickup -->
                <button name="action_start_pickup" string="Start Pickup"
                    type="object" invisible="not is_logspace_order or logspace_state != 'order_received'"/>

                <!-- Pickup Started: Arrived at Pickup -->
                <button name="action_vendor_arrived_pickup" string="Arrived at Pickup"
                    type="object" invisible="not is_logspace_order or logspace_state != 'pickup_started'"/>

                <!-- Vendor Arrived at Pickup: Pickup Add-ons Done -->
                <button name="action_pickup_addons" string="Pickup Add-ons Done"
                    type="object" invisible="not is_logspace_order or logspace_state != 'vendor_arrived_pickup'"/>

                <!-- Pickup Add-ons: Pickup Completed -->
                <button name="action_pickup_completed" string="Pickup Completed"
                    type="object" invisible="not is_logspace_order or logspace_state != 'pickup_addons'"
                    class="oe_highlight"/>

                <!-- Pickup Completed: Pre-Dropoff Add-ons -->
                <button name="action_pre_dropoff_addons" string="Pre-Dropoff Add-ons"
                    type="object" invisible="not is_logspace_order or logspace_state != 'pickup_completed'"/>

                <!-- Pre-Dropoff Add-ons: Arrived at Destination -->
                <button name="action_arrived_destination" string="Arrived at Destination"
                    type="object" invisible="not is_logspace_order or logspace_state != 'pre_dropoff_addons'"/>

                <!-- Arrived at Destination: Dropoff Completed -->
                <button name="action_dropoff_completed" string="Dropoff Completed"
                    type="object" invisible="not is_logspace_order or logspace_state != 'arrived_destination'"
                    class="oe_highlight"/>

                <!-- Dropoff Completed: Start Grace Period -->
                <button name="action_start_grace_period" string="Start Grace Period"
                    type="object" invisible="not is_logspace_order or logspace_state != 'dropoff_completed'"/>

                <!-- Grace Period: Complete Order -->
                <button name="action_complete_order" string="Complete Order"
                    type="object" invisible="not is_logspace_order or logspace_state != 'grace_period'"
                    class="oe_highlight"/>

                <!-- Cancel Order (available until dropoff_completed) -->
                <button name="action_cancel_logspace" string="Cancel Order"
                    type="object" invisible="not is_logspace_order or logspace_state in ('dropoff_completed', 'grace_period', 'order_completed', 'cancelled')"/>

                <!-- Reset to Draft (only when cancelled) -->
                <button name="action_reset_logspace_to_draft" string="Reset to Draft"
                    type="object" invisible="not is_logspace_order or logspace_state != 'cancelled'"/>
            </xpath>
        </field>
    </record>

    <!-- ========================================================================= -->
    <!-- Sale Order Tree View Extension -->
    <!-- ========================================================================= -->
    <record id="view_sale_order_tree_inherit_logspace" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.logspace</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_logspace_order" invisible="1"/>
                <field name="logspace_state" invisible="not is_logspace_order" optional="show"/>
                <field name="logspace_provider_id" invisible="not is_logspace_order" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ========================================================================= -->
    <!-- Sale Order Search View (Standalone for Logspace) -->
    <!-- ========================================================================= -->
    <record id="view_sale_order_search_logspace" model="ir.ui.view">
        <field name="name">sale.order.search.logspace</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="logspace_provider_id"/>
                <field name="logspace_state"/>
                <separator/>
                <filter name="filter_logspace" string="Logspace Orders" domain="[('is_logspace_order', '=', True)]"/>
                <filter name="filter_guest" string="Guest Orders" domain="[('is_guest_order', '=', True)]"/>
                <separator/>
                <filter name="group_by_logspace_state" string="Logspace Status" context="{'group_by': 'logspace_state'}"/>
                <filter name="group_by_provider" string="Provider" context="{'group_by': 'logspace_provider_id'}"/>
            </search>
        </field>
    </record>

    <!-- ========================================================================= -->
    <!-- Logspace Orders Action -->
    <!-- ========================================================================= -->
    <record id="action_sale_order_logspace" model="ir.actions.act_window">
        <field name="name">Logspace Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar,kanban,activity</field>
        <field name="search_view_id" ref="view_sale_order_search_logspace"/>
        <field name="context">{
            'default_is_logspace_order': True,
            'search_default_filter_logspace': 1,
            'create':False,
        }</field>
        <field name="domain">[('is_logspace_order', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Logspace logistics order
            </p>
        </field>
    </record>

</odoo>
