<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Notification Actions -->
    <record id="action_logspace_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">logspace.notification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Your notifications will appear here!
            </p>
        </field>
    </record>

    <!-- Notification Tree View -->
    <record id="view_logspace_notification_list" model="ir.ui.view">
        <field name="name">logspace.notification.list</field>
        <field name="model">logspace.notification</field>
        <field name="arch" type="xml">
            <list decoration-muted="is_read == True">
                <field name="type" widget="badge" decoration-success="type=='success'" decoration-info="type=='info'" decoration-warning="type=='warning'" decoration-danger="type=='error'"/>
                <field name="title"/>
                <field name="message"/>
                <field name="create_date"/>
                <field name="is_read" widget="boolean_toggle"/>
                <field name="read_date"/>
                <button name="action_mark_read" type="object" string="Mark Read" class="btn btn-link" invisible="is_read == True"/>
            </list>
        </field>
    </record>

    <!-- Notification Form View -->
    <record id="view_logspace_notification_form" model="ir.ui.view">
        <field name="name">logspace.notification.form</field>
        <field name="model">logspace.notification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="title"/>
                            <field name="message"/>
                            <field name="icon" optional="show"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="is_read"/>
                            <field name="read_date"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="Action Link">
                        <field name="action_link"/>
                        <field name="action_model"/>
                        <field name="action_res_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
