<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Type Actions -->
    <record id="action_logspace_vehicle_type" model="ir.actions.act_window">
        <field name="name">Vehicle Types</field>
        <field name="res_model">logspace.vehicle.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle type!
            </p>
        </field>
    </record>

    <!-- Vehicle Type Tree View -->
    <record id="view_logspace_vehicle_type_tree" model="ir.ui.view">
        <field name="name">logspace.vehicle.type.tree</field>
        <field name="model">logspace.vehicle.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon" widget="char"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="default_capacity_kg"/>
                <field name="default_capacity_cbm"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Type Form View -->
    <record id="view_logspace_vehicle_type_form" model="ir.ui.view">
        <field name="name">logspace.vehicle.type.form</field>
        <field name="model">logspace.vehicle.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="icon" placeholder="fa-truck"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_capacity_kg"/>
                            <field name="default_capacity_cbm"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
