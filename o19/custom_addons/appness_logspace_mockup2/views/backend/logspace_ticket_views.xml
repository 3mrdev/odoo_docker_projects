<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ticket Actions -->
    <record id="action_logspace_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">logspace.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Customer support tickets will appear here!
            </p>
        </field>
    </record>

    <!-- Ticket Kanban View -->
    <record id="view_logspace_ticket_kanban" model="ir.ui.view">
        <field name="name">logspace.ticket.kanban</field>
        <field name="model">logspace.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="subject"/>
                <field name="category"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="assigned_to_id"/>
                <field name="customer_id"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_content">
                                <div class="o_kanban_header">
                                    <span class="o_kanban_title">
                                        <strong><t t-esc="record.name.value"/></strong>
                                    </span>
                                    <span class="float-end">
                                        <span class="badge rounded-pill"
                                              t-attf-class="{{ record.priority.raw_value == 'urgent' ? 'bg-danger' : (record.priority.raw_value == 'high' ? 'bg-warning' : (record.priority.raw_value == 'low' ? 'bg-secondary' : 'bg-info')) }}">
                                            <t t-esc="record.priority.value"/>
                                        </span>
                                    </span>
                                </div>
                                <div class="text-muted">
                                    <t t-esc="record.subject.value"/>
                                </div>
                                <div class="mt-1">
                                    <span class="badge bg-light text-dark"><t t-esc="record.category.value"/></span>
                                </div>
                                <div class="mt-2 text-muted small">
                                    <span><i class="fa fa-user"/> <t t-esc="record.customer_id.value"/></span>
                                </div>
                                <div class="mt-1 text-muted small">
                                    <span><i class="fa fa-calendar"/> <t t-esc="record.create_date.value"/></span>
                                </div>
                                <div class="mt-2" t-if="!record.assigned_to_id.raw_value">
                                    <button class="btn btn-primary btn-sm" name="action_assign" type="object">Assign to Me</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Ticket Tree View -->
    <record id="view_logspace_ticket_list" model="ir.ui.view">
        <field name="name">logspace.ticket.list</field>
        <field name="model">logspace.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="subject"/>
                <field name="category"/>
                <field name="customer_id"/>
                <field name="order_id" optional="show"/>
                <field name="priority" widget="badge" decoration-danger="priority=='urgent'" decoration-warning="priority=='high'" decoration-muted="priority=='low'"/>
                <field name="state" widget="badge" decoration-success="state in ['resolved','closed']" decoration-info="state=='in_progress'" decoration-warning="state=='waiting_customer'" decoration-danger="state=='escalated'"/>
                <field name="assigned_to_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Ticket Form View -->
    <record id="view_logspace_ticket_form" model="ir.ui.view">
        <field name="name">logspace.ticket.form</field>
        <field name="model">logspace.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Assign" name="action_assign" type="object" class="oe_highlight" invisible="state != 'new'"/>
                    <button string="Start" name="action_start_progress" type="object" class="oe_highlight" invisible="state not in ['new','assigned']"/>
                    <button string="Wait Customer" name="action_wait_customer" type="object" invisible="state != 'in_progress'"/>
                    <button string="Resolve" name="action_resolve" type="object" class="oe_highlight" invisible="state in ['resolved','closed']"/>
                    <button string="Close" name="action_close" type="object" invisible="state != 'resolved'"/>
                    <button string="Reopen" name="action_reopen" type="object" invisible="state not in ['resolved','closed']"/>
                    <button string="Escalate" name="action_escalate" type="object" class="btn-danger" invisible="state in ['closed','escalated']"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,waiting_customer,resolved,closed,escalated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="subject"/>
                            <field name="order_id"/>
                            <field name="customer_id"/>
                            <field name="provider_id" readonly="1" optional="hide"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="assigned_to_id"/>
                            <field name="create_date" readonly="1"/>
                            <field name="resolved_date" readonly="1" optional="show"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group>
                        <field name="attachments" widget="many2many_binary"/>
                    </group>
                    <group string="Resolution" invisible="state not in ['resolved','closed']">
                        <field name="resolution_notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
