<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screen 9: Login (Simplified - NO OTP) -->
    <template id="mockup2_login_page" name="Logspace Login">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-5">
                            <div class="card shadow-sm">
                                <div class="card-body p-4">
                                    <div class="text-center mb-4">
                                        <i class="fa fa-user-circle fa-3x text-primary mb-2"></i>
                                        <h3>Welcome Back</h3>
                                        <p class="text-muted small">Sign in to your Logspace account</p>
                                    </div>

                                    <form action="/logspace/my/orders" method="GET">
                                        <div class="mb-3">
                                            <label class="form-label">Email or Phone</label>
                                            <input type="text" class="form-control" placeholder="Enter email or phone number" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Password</label>
                                            <input type="password" class="form-control" placeholder="Enter your password" required="required"/>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="remember"/>
                                                <label class="form-check-label small" for="remember">Remember me</label>
                                            </div>
                                            <a href="#" class="small text-decoration-none">Forgot password?</a>
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100">Sign In</button>
                                    </form>

                                    <div class="text-center mt-4">
                                        <p class="text-muted">Don't have an account? <a href="/logspace/signup">Create one</a></p>
                                    </div>

                                    <div class="text-center mt-3">
                                        <p class="text-muted small mb-2">Or continue with</p>
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-outline-secondary btn-sm"><i class="fa fa-google"></i> Google</button>
                                            <button class="btn btn-outline-secondary btn-sm"><i class="fa fa-facebook"></i> Facebook</button>
                                            <button class="btn btn-outline-secondary btn-sm"><i class="fa fa-apple"></i> Apple</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center mt-3">
                                <p class="small text-muted">Want to book without signing in? <a href="/logspace">Continue as guest</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 10: Signup (Simplified - NO OTP) -->
    <template id="mockup2_signup_page" name="Logspace Signup">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-5">
                            <div class="card shadow-sm">
                                <div class="card-body p-4">
                                    <div class="text-center mb-4">
                                        <i class="fa fa-user-plus fa-3x text-primary mb-2"></i>
                                        <h3>Create Account</h3>
                                        <p class="text-muted small">Join Logspace for faster bookings</p>
                                    </div>

                                    <form action="/logspace/my/profile" method="GET">
                                        <div class="mb-3">
                                            <label class="form-label">Full Name</label>
                                            <input type="text" class="form-control" placeholder="Enter your full name" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Email Address</label>
                                            <input type="email" class="form-control" placeholder="Enter your email" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Phone Number</label>
                                            <input type="tel" class="form-control" placeholder="Enter phone number" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Password</label>
                                            <input type="password" class="form-control" placeholder="Create a password (min 8 chars)" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Confirm Password</label>
                                            <input type="password" class="form-control" placeholder="Confirm password" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="terms" required="required"/>
                                                <label class="form-check-label small" for="terms">
                                                    I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
                                                </label>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100">Create Account</button>
                                    </form>

                                    <div class="text-center mt-4">
                                        <p class="text-muted">Already have an account? <a href="/logspace/login">Sign in</a></p>
                                    </div>

                                    <div class="text-center mt-3">
                                        <p class="text-muted small mb-2">Or sign up with</p>
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-outline-secondary btn-sm"><i class="fa fa-google"></i> Google</button>
                                            <button class="btn btn-outline-secondary btn-sm"><i class="fa fa-facebook"></i> Facebook</button>
                                            <button class="btn btn-outline-secondary btn-sm"><i class="fa fa-apple"></i> Apple</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center mt-3">
                                <p class="small text-muted">Want to book without an account? <a href="/logspace">Continue as guest</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
