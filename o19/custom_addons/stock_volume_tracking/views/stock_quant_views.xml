<odoo>
    <record id="stock_quant_form_inherit" model="ir.ui.view">
        <field name="name">stock_quant_form_inherit</field>
        <field name="model">stock.quant</field>
        <field name="priority" eval="25" />
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="volume_display" optional="show" invisible="not lot_id"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume" optional="show" invisible="not lot_id"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_total" optional="show" sum="Total Volume"
                    invisible="not lot_id"
                    groups="stock_volume_tracking.group_volume_only" />
            </field>
        </field>
    </record>
</odoo>