<odoo>
    <!-- mrp.mrp_production_form_view -->
    <record id="mrp_production_form_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <!-- Add lot selection to order lines -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="is_volume_tracked" widget="boolean_toggle" readonly="1" invisible="1" />
                <label for="volume_length" string="Volumn in cm (L × W × H)"
                    invisible="not is_volume_tracked"
                    groups="stock_volume_tracking.group_volume_only" />
                <div class="o_row" name="volume" invisible="not is_volume_tracked"
                    groups="stock_volume_tracking.group_volume_only">
                    <field name="volume_length" placeholder="Length" class="oe_inline"
                        readonly="state != 'draft'" />
                    <span>×</span>
                    <field name="volume_width" placeholder="Width" class="oe_inline"
                        readonly="state != 'draft'" />
                    <span>×</span>
                    <field name="volume_height" placeholder="Height" class="oe_inline"
                        readonly="state != 'draft'" />
                </div>
                <field name="volume_display"/>
                <field name="product_yield" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_qty']"
                position="before">
                <field name="product_yield" 
                    invisible="not is_volume_tracked"
                    optional="hide"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="sale_mrp_lot_id" string="Sales Recommended LOT/Serial No"
                    optional="hide" groups="stock_volume_tracking.group_volume_only" />
            </xpath>

            <xpath expr="//field[@name='move_byproduct_ids']/list/field[@name='product_uom_qty']"
                position="before">
                <field name="is_volume_tracked" column_invisible="True"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_length"
                    invisible="not is_volume_tracked "
                    optional="show"
                    string="L (cm)"
                    force_save="1"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_width"
                    invisible="not is_volume_tracked"
                    optional="show"
                    string="W (cm)"
                    force_save="1"
                    groups="stock_volume_tracking.group_volume_only" />
                    <!-- readonly="parent.state != 'draft' and ((parent.state not in ('confirmed', 'progress', 'to_close') and not parent.is_planned) or parent.is_locked)" -->
                <field name="volume_height"
                    invisible="not is_volume_tracked"
                    optional="show"
                    string="H (cm)"
                    force_save="1"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_display"
                    invisible="not is_volume_tracked"
                    optional="show"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume"
                    invisible="not is_volume_tracked"
                    optional="hide"
                    string="Volume"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_total"
                    invisible="not is_volume_tracked"
                    optional="hide"
                    string="Volume Total"
                    sum="Total Volume"
                    groups="stock_volume_tracking.group_volume_only" />
            </xpath>
            
        </field>
    </record>
</odoo>