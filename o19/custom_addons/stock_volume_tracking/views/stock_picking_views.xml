<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_form_view_volume" model="ir.ui.view">
        <field name="name">stock.picking.form.volume</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']"
                position="before">
                <field name="is_volume_tracked" column_invisible="True"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_length"
                    invisible="not is_volume_tracked or parent.picking_type_code not in ['incoming', 'outgoing']"
                    column_invisible="parent.picking_type_code not in ['incoming', 'outgoing']"
                    optional="show"
                    string="L (cm)"
                    readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0 or origin"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_width"
                    invisible="not is_volume_tracked or parent.picking_type_code not in ['incoming', 'outgoing']"
                    column_invisible="parent.picking_type_code not in ['incoming', 'outgoing']"
                    optional="show"
                    string="W (cm)"
                    readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0 or origin"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_height"
                    invisible="not is_volume_tracked or parent.picking_type_code not in ['incoming', 'outgoing']"
                    column_invisible="parent.picking_type_code not in ['incoming', 'outgoing']"
                    optional="show"
                    string="H (cm)"
                    readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0 or origin"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_display"
                    invisible="not is_volume_tracked or parent.picking_type_code not in ['incoming', 'outgoing']"
                    column_invisible="parent.picking_type_code not in ['incoming', 'outgoing']"
                    optional="show"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume"
                    invisible="not is_volume_tracked or parent.picking_type_code not in ['incoming', 'outgoing']"
                    column_invisible="parent.picking_type_code not in ['incoming', 'outgoing']"
                    optional="hide"
                    string="Volume"
                    groups="stock_volume_tracking.group_volume_only" />
                <field name="volume_total"
                    invisible="not is_volume_tracked or parent.picking_type_code not in ['incoming', 'outgoing']"
                    column_invisible="parent.picking_type_code not in ['incoming', 'outgoing']"
                    optional="hide"
                    string="Volume Total"
                    sum="Total Volume"
                    groups="stock_volume_tracking.group_volume_only" />
            </xpath>
            <xpath expr="//button[@name='action_put_in_pack']" position="after">
                <group name="package_group" col="8" class="mt-2 mt-md-0">
                    <group colspan="4" class="order-1 order-lg-0">
                    </group>
                    <group colspan="4" class="oe_subtotal_footer order-0 order-lg-1">
                        <field name="packages_count" string="Total Packages"/>
                        <field name="total_products" string="Total Quantities"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

        
</odoo>