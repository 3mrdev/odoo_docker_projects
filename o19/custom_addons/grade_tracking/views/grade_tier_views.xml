<odoo>

    <record id="grade_tier_view_list" model="ir.ui.view">
        <field name="name">grade.tier.view.list</field>
        <field name="model">grade.tier</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="min_grade" />
                <field name="max_grade" />
            </list>
        </field>
    </record>

    <record id="grade_tier_view_form" model="ir.ui.view">
        <field name="name">grade.tier.view.form</field>
        <field name="model">grade.tier</field>
        <field name="arch" type="xml">
            <form string="Grade Tier">
                <header>
                    <button name="action_update_all_grade_tiers"
                        string="Update All Grade Tiers"
                        type="object"
                        class="oe_highlight"
                        help="Recompute the Grade Tier of all lots from the current tier ranges." />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg="bg-danger" invisible="active" />
                    <group>
                        <field name="active" invisible="1" />
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="min_grade" />
                            <field name="max_grade" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_grade_tier" model="ir.actions.act_window">
        <field name="name">Grade Tiers</field>
        <field name="res_model">grade.tier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first grade tier
            </p>
            <p>
                Grade tiers (e.g. HGO / MGO / LGO) define the grade ranges used to
                classify lots automatically. Use the lowest sequence for priority
                when ranges overlap.
            </p>
        </field>
    </record>

    <!-- List-bound server action: Actions > Update All Grade Tiers -->
    <record id="action_update_all_grade_tiers_server" model="ir.actions.server">
        <field name="name">Update All Grade Tiers</field>
        <field name="model_id" ref="grade_tracking.model_grade_tier" />
        <field name="binding_model_id" ref="grade_tracking.model_grade_tier" />
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('grade_tracking.group_grade_tracked'))]" />
        <field name="state">code</field>
        <field name="code">action = records.action_update_all_grade_tiers()</field>
    </record>

    <menuitem id="menu_grade_tracking_config"
        name="Grade Tracking"
        parent="stock.menu_stock_config_settings"
        sequence="45"
        groups="stock.group_stock_manager" />

    <menuitem id="menu_grade_tier"
        name="Grade Tiers"
        action="action_grade_tier"
        parent="menu_grade_tracking_config"
        sequence="10" />

</odoo>
