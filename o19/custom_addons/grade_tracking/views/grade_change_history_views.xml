<odoo>

    <record id="grade_change_history_view_list" model="ir.ui.view">
        <field name="name">grade.change.history.view.list</field>
        <field name="model">grade.change.history</field>
        <field name="group_ids" eval="[(4, ref('grade_tracking.group_grade_history_user'))]" />
        <field name="arch" type="xml">
            <list>
                <field name="change_datetime" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="level_from" optional="show" />
                <field name="level_to" optional="show" />
                <field name="average_grade_from" optional="show" />
                <field name="average_grade_to" optional="show" />
                <field name="quantity" optional="show" />
                <field name="gold_content" optional="show" />
                <field name="lot_id" invisible="1" />
            </list>
        </field>
    </record>

    <record id="grade_change_history_view_form" model="ir.ui.view">
        <field name="name">grade.change.history.view.form</field>
        <field name="model">grade.change.history</field>
        <field name="group_ids" eval="[(4, ref('grade_tracking.group_grade_history_user'))]" />
        <field name="arch" type="xml">
            <form string="Grade Change">
                <sheet>
                    <group>
                        <group>
                            <field name="lot_id" readonly="1" />
                            <field name="change_datetime" readonly="1" />
                            <field name="user_id" readonly="1" widget="many2one_avatar_user" />
                        </group>
                        <group>
                            <field name="level_from" readonly="1" />
                            <field name="level_to" readonly="1" />
                            <field name="average_grade_from" readonly="1" />
                            <field name="average_grade_to" readonly="1" />
                            <field name="quantity" readonly="1" />
                            <field name="gold_content" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_grade_change_history" model="ir.actions.act_window">
        <field name="name">Grade History</field>
        <field name="res_model">grade.change.history</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[(4, ref('grade_tracking.group_grade_history_user'))]" />
    </record>

</odoo>
