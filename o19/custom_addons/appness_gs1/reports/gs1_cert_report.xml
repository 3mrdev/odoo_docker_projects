<odoo>

    <record id="paperformat_cert" model="report.paperformat">
        <field name="name">GS1 Certificates</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="disable_shrinking" eval="True" />
        <field name="dpi">96</field>
    </record>

    <record id="action_report_gs1_cert_gln" model="ir.actions.report">
        <field name="name">GLN Certificate</field>
        <field name="model">gln.cert</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">appness_gs1.report_gs1_cert_document_gln</field>
        <field name="report_file">appness_gs1.report_gs1_cert_document_gln</field>
        <field name="print_report_name">'GLN Certificate - %s' % (object.name)</field>
        <field name="binding_model_id" ref="appness_gs1.model_gln_cert" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="appness_gs1.paperformat_cert" />
        <field name="group_ids" eval="[(4, ref('appness_gs1.group_certificates_user'))]" />
    </record>

    <record id="action_report_gs1_cert_gcp" model="ir.actions.report">
        <field name="name">GCP Certificate</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">appness_gs1.report_gs1_cert_document_gcp</field>
        <field name="report_file">appness_gs1.report_gs1_cert_document_gcp</field>
        <field name="print_report_name">'GCP Certificate - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="appness_gs1.paperformat_cert" />
        <field name="group_ids" eval="[(4, ref('appness_gs1.group_certificates_user'))]" />
    </record>

    <template id="report_gs1_cert_document_gcp">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="line" t-value="doc" />
                <t t-set="is_gcp" t-value="True" />
                <t t-set="is_gln" t-value="False" />
                <t t-call="appness_gs1.report_gs1_cert_document" />
            </t>
        </t>
    </template>

    <template id="report_gs1_cert_document_gln">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="line" t-value="doc" />
                <t t-set="is_gcp" t-value="False" />
                <t t-set="is_gln" t-value="doc.sale_order_line_id.product_id.is_gln_cert" />
                <t t-call="appness_gs1.report_gs1_cert_document" />
            </t>
        </t>
    </template>

