    <template id="appness_logspace_portal.user_sign_in_with_otp" name="User Sign In redirect" inherit_id="portal.user_sign_in">
        <xpath expr="//a" position="replace">
            <a t-attf-href="/web/request_otp" class="btn btn-outline-primary">Portal Login</a>
        </xpath>
    </template>

    <template id="appness_logspace_portal.otp_login_fields" name="Logspace Auth Signup/ResetPassword form fields">
        <h4>Portal Login </h4><br></br>

        <!-- <div class="form-group field-name" >
            <label>Mobile</label>
            <div class="input-group">
                <span class="input-group-addon">+968</span>
                <input type="text" name="mobile" t-att-value="mobile" id="mobile" 
                    pattern="[1-9]{1}[0-9]{7}" minlength="7"
                    class="form-control form-control-sm" required="required"/>
            </div>
        </div> -->
        <div id="logspace_intl_tel_widget" class="form-group field-phone">
            <label for="phone">Mobile Phone</label><br></br>
            <input type="tel" name="phone1" t-att-value="mobile" id="phone" class="form-control form-control-sm intl_tel_widget" placeholder="e.g. 12345678"
                required="required" t-att-readonly="'readonly' if only_passwords else None"
                t-att-autofocus="'autofocus' if login and not only_passwords else None" style="font-size: 1rem; width: 300px;"/>
            <p class="phone_output mt-2 alert d-none" role="alert"></p>
            <input type="hidden" class="phone_value" name="mobile"/> 
        </div>
        <br></br>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="warn" name="warn" value="1" required="1"/>
            <label class="form-check-label" for="warn">
                By clicking this checkbox i confirm that this number will not be given to another person or 
                transferred <span style="color:red;">without the family's knowledge.</span> If i wish to give away my number in the future, 
                i will visit the association's office <span style="color:red;">to transfer the access to another family member.</span>
            </label>
        </div>
    </template>

    <template id="appness_logspace_portal.otp_fields" name="Logspace Auth OTP form fields">
        <h4>Verify OTP</h4><br></br>
        <div id="otp_container" class="form-group field-name ot_var" style="direction: ltr; position: absolute; left: 0px;font-size: 1.5rem;">     
            <input type="text" name="otp_one" minlength="1" maxlength="1" 
            t-att-value="otp" id="otp_o" 
            class="form-control form-control-sm otp_one otp_input" required="required"/>
            <input type="text" name="otp_two" minlength="1" maxlength="1" 
            t-att-value="otp" id="otp_t" 
            class="form-control form-control-sm otp_two otp_input" required="required"/>
            <input type="text" name="otp_three"  minlength="1" maxlength="1" 
            t-att-value="otp" id="otp_th" 
            class="form-control form-control-sm otp_three otp_input" required="required"/>
            <input type="text" name="otp_four" minlength="1" maxlength="1" 
            t-att-value="otp" id="otp_f"
            class="form-control form-control-sm otp_four otp_input" required="required"/>
        </div>
        <br></br>
        <br></br>
        <br></br>
        <!-- Test OTP: <span t-esc="otp_original"></span> -->
    </template>

    <template id="appness_logspace_portal.request_otp" name="Portal Login">
        <t t-call="web.login_layout">
            <form class="oe_signup_form" role="form" method="post" t-if="not message">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <t t-call="appness_logspace_portal.otp_login_fields">
                    <t t-set="only_passwords" t-value="bool(token and not invalid_token)"/>
                </t>

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <div class="text-center oe_login_buttons d-grid pt-3">
                    <button type="submit" class="btn btn-primary"> Send OTP</button>
                    <!-- <p class="mt-2 text-center">
                        <a class="btn btn-link btn-sm" t-attf-href="/web/login?{{ keep_query() }}">Login with Email ?</a>
                    </p> -->
                    <div class="o_login_auth"/>
                </div>
            </form>
        </t>
    </template>

    <template id="appness_logspace_portal.verify_otp" name="Verify OTP">
        <t t-call="web.login_layout">
            
            <form class="oe_signup_form" role="form" method="post" t-if="not message">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <t t-call="appness_logspace_portal.otp_fields">
                    <t t-set="only_passwords" t-value="bool(token and not invalid_token)"/>
                </t>

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <div class="text-center oe_login_buttons d-grid pt-3">
                    <button type="submit" class="btn btn-primary"> Verify OTP</button>
                    <!-- <p class="mt-2 text-center">
                        <a class="btn btn-link btn-sm" t-attf-href="/web/login?{{ keep_query() }}">Login with Email ?</a>
                    </p> -->
                    <div class="o_login_auth"/>
                </div>
            </form>
        </t>
    </template>

    <template id="appness_logspace_portal.portal_my_logspace_account" name="Family Profile">
