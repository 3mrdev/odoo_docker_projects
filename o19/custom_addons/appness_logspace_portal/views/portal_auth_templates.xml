                            Close
                        </a>
                        <a t-if="not update_member and page_id &gt; 1" t-attf-href="/my/logspace_account/{{page_id-1 if page_id &gt; 1 else 1}}" class="btn btn-light me-2 mt-2">
                            Discard and Back
                        </a>
                        <a t-if="update_member and page_id &gt; 1" t-attf-href="/my/logspace_account/{{page_id-1 if page_id &gt; 1 else 1}}/{{member_id}}" class="btn btn-light me-2 mt-2">
                            Discard and Back
                        </a>
                        <button t-if="page_id &lt; count-1" type="submit" class="btn btn-primary mt-2 float-end">
                            Save and Next
                        </button>
                        <button t-if="page_id == count-1" type="submit" class="btn btn-primary mt-2 loat-end">
                            Save and Finish
                        </button>
                    </div>
                    <hr class="mb-3"/>

                    <ol t-if="not update_member and father_name != 'Father Name'" class="o_portal_submenu breadcrumb mb-0 flex-grow-1 px-0">
                        <li class="breadcrumb-item ms-1"><a href="/my/home" aria-label="Home" title="Home"><i class="fa fa-home"/></a></li>
                        <li t-attf-class="breadcrumb-item #active">
                            <span t-if="father_name" t-esc="father_name"/>
                            (Family)
                        </li>
                    </ol>
                    <ol t-if="update_member" class="o_portal_submenu breadcrumb mb-0 flex-grow-1 px-0">
