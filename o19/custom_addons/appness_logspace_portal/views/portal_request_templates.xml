                <t t-set="additional_title">Service Request</t>
                <t t-set="no_breadcrumbs" t-value="1"/>
                <t t-set="my_details" t-value="False"/>
                <div class="d-flex gap-2 my-3">
                    <a t-if="not update_request" href="/logspace/services" title="Go Back" class="btn btn-light px-2"><i class="oi oi-chevron-left"/></a>
                    <a t-if="update_request" href="/my/requests" title="Go Back" class="btn btn-light px-2"><i class="oi oi-chevron-left"/></a>
                    <h3 class="my-0" t-esc="service_name"></h3>
