                                    <div class="step-icon-wrap">
                                    <t t-set="count" t-value="count+1"/>
                                    <div class="step-icon"><i t-attf-class="{{'fa fa-check' if page_id >= count else step['icon']}}"></i></div>
                                    </div>
                                    <h4 class="step-title" t-esc="step['name']"></h4>
                                </a>
                                <a t-if="update_request" t-attf-href="/logspace/service_request/{{service_id}}/{{count}}/{{request_id}}">
                                    <div class="step-icon-wrap">
                                    <t t-set="count" t-value="count+1"/>
                                    <div class="step-icon"><i t-attf-class="{{'fa fa-check' if page_id >= count else step['icon']}}"></i></div>
                                    </div>
                                    <h4 class="step-title" t-esc="step['name']"></h4>
                                </a>
                            </div> -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt16 o_project_portal_sidebar">
                <!-- <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                    <t t-set="entries">
                        <div class="o_portal_index_card col-md-12 order-2">
                            <div class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none">
                                <div class="o_portal_icon">
                                    <img t-attf-src="#{'/portal/static/src/img/portal-connection.svg'}"/>
                                </div>
                                <div>
                                    <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                                        <span t-esc="service_name"/>
                                    </div>
                                    <div class="opacity-75">
                                        Follow all your service requests
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-column">
                            <div class="col-12 d-xl-block">
                                <small class="form-text text-muted" t-esc="description"></small>
                            </div>
                            <div class="mt-4">
                                <div t-attf-class="col-12 col-md-12 mt-3" >
                                    <h6>
                                        <small t-esc="service_desc" class="text-muted"></small>
