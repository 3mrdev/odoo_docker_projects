<odoo>
    <template id="portal_logspace_services" name="All Services">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="False"/>
            <div class="o_portal_my_home">
                <div class="o_portal_docs row g-2">
                    <t t-if="not services">
                        <div class="col-12">
                            <div class="alert alert-info">
                                Sorry but there is no services available in your area.
                            </div>
                        </div>
                    </t>
                    <t t-else="" t-foreach="services" t-as="service" >
                    <!-- t-call="portal.portal_docs_entry" -->
                        <!-- <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                        <t t-set="title"><span t-esc="service.name"/></t>
                        <t t-set="text"><span t-esc="service.description_sale"/></t>
                        <t t-set="url" t-value="'/logspace/service/%s' % (service.id)"/>
                        <t t-set="config_card" t-value="True"/> -->
                        <div class="o_portal_index_card col-md-6 order-2">
                            <a t-attf-href="/logspace/service/{{service.id}}" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                                <div class="o_portal_icon">
                                    <!-- <img t-attf-src="#{'/appness_logspace_portal/static/img/helphand.png'}"/> -->
                                    <img src="data:image/png;base64,"/>
                                </div>
                                <div>
                                    <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                                        <span t-esc="service.name"/>
                                    </div>
                                    <div class="opacity-75">
                                        <span t-esc="service.description_sale"/>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                    <div class="o_portal_doc_spinner spinner-border text-o-color-2 align-self-center mt-5"/>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_logspace_service" name="Service Details">
        <t t-call="portal.portal_layout">
            <div class="o_portal_security_body w-md-75 w-lg-50 pb-5">
                <t t-set="additional_title">Service Details</t>
                <t t-set="no_breadcrumbs" t-value="1"/>
                <t t-set="my_details" t-value="False"/>
                <div class="d-flex gap-2 my-3">
                    <a href="/logspace/services" title="Go Back" class="btn btn-light px-2"><i class="oi oi-chevron-left"/></a>
                    <h3 class="my-0"><span t-esc="service_name"/></h3>
                </div>
            </div>
            <div class="row mt16 o_project_portal_sidebar">
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                    <t t-set="entries">
                        <div class="d-flex flex-column">
                            <div id="ticket-nav" class="flex-grow-1 p-0" t-ignore="true" role="complementary">
                                <ul class="nav flex-column">
                                    <li class="nav-item" id="nav-header">
                                        <a class="nav-link p-0" href="#card_header">
                                            Service Details
                                        </a>
                                    </li>
                                    <li class="nav-item" id="nav-chat">
                                        <a class="nav-link p-0" href="#required_documents">
                                            Required Documents
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <div class="mt-4">
                                <div t-attf-class="col-12 col-md-12 mt-3" >
                                    <h6>
                                        <small class="text-muted">Are you sure you have all the required documents ?</small>
                                    </h6>
                                    <a t-attf-href="/logspace/service_request/{{service_id}}/1?{{ keep_query() }}" class="btn btn-primary mb-2" role="button">Apply</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
                <div id="service_content" class="o_portal_content col-12 col-lg-8 col-xxl-9 mt-5 mt-lg-0">
                    <div id="card">
                        <div id="card_header" class="container" data-anchor="true">
                            <div class="row gs-0">
                                <div class="col-md">
                                    <h5 class="row justify-content-between">
                                        <div class="col-md-9 text-truncate">
                                            <span t-esc="service_name" class="h3"/>
                                            <!-- <small class="text-muted"> Follow all your service requests </small> -->
                                        </div>
                                        <div class="col col-auto">
                                            <small>Status:</small>
                                            <small t-attf-class="badge rounded-pill smaller #text-bg-light bg-200}" title="Service Status">Available</small>
                                        </div>
                                    </h5>
                                </div>
                            </div>
                        </div>
                        <div id="card_body">
                            <div class="row mt-3" name="description">
                                <div class="col-lg-12" t-esc="service_desc"/>
                            </div>
                        </div>
                        <div id="required_documents" class="row mt-5">
                            <h4>Required Documents</h4>
                            <div class="row">
                                <t t-foreach="required_documents" t-as="required_document">
                                    <div class="o_portal_index_card col-12 col-md-6 order-2 mt-3">
                                        <div class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none alert alert-primary align-items-center">
                                            <div class="alert-link">
                                                <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                                                    <span class="fw-bold">1</span>
                                                    <span t-esc="required_document['name']"></span>
                                                </div>
                                                <div class="opacity-75">
                                                    <span t-esc="required_document['description']"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- <div class="o_portal_doc_spinner spinner-border text-o-color-2 align-self-center mt-5"/> -->
        </t>
    </template>
</odoo>