<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================ -->
        <!-- SAME-ZONE (INTRA-GOVERNORATE) DISTANCES                          -->
        <!-- One "gov → gov" row per governorate: zones are areas, not        -->
        <!-- points, so a Muscat → Muscat move is a real intra-zone trip.     -->
        <!-- The zone setup wizard reads these for its generated local        -->
        <!-- self-routes, and get_distance() prefers them over the 5.0 km     -->
        <!-- default. Estimates only - refine per governorate as needed.      -->
        <!-- ================================================================ -->

        <record id="om_zone_dist_muscat_self" model="logspace.zone.distance">
            <field name="zone_from_id" ref="om_zone_muscat"/>
            <field name="zone_to_id" ref="om_zone_muscat"/>
            <field name="estimated_km">25</field>
            <field name="estimated_minutes">40</field>
        </record>

