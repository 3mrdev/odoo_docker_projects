<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================ -->
        <!-- PRODUCT CATEGORY: Logspace Services -->
        <!-- ============================================ -->
        <record id="product_category_logspace" model="product.category">
            <field name="name">Logspace Services</field>
        </record>

        <!-- ============================================ -->
        <!-- PRODUCTS: Logspace Main Service -->
        <!-- ============================================ -->
        <record id="product_logspace_service_product_template" model="product.template">
            <field name="name">Logspace Transport Service</field>
            <field name="categ_id" ref="product_category_logspace"/>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="default_code">LOGSPACE-SVC</field>
            <field name="description_sale">Logistics transport service including vehicle and driver</field>
        </record>

        <!-- ============================================ -->
        <!-- PRODUCTS: Add-on Services -->
        <!-- ============================================ -->
        <record id="product_addon_loading_product_template" model="product.template">
            <field name="name">Loading Assistance</field>
            <field name="categ_id" ref="product_category_logspace"/>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="default_code">LOGSPACE-LOAD</field>
            <field name="description_sale">Professional help loading items onto the truck</field>
        </record>

        <record id="product_addon_unloading_product_template" model="product.template">
            <field name="name">Unloading Assistance</field>
            <field name="categ_id" ref="product_category_logspace"/>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="default_code">LOGSPACE-UNLOAD</field>
            <field name="description_sale">Professional help unloading at destination</field>
        </record>

        <record id="product_addon_express_product_template" model="product.template">
            <field name="name">Express Delivery</field>
            <field name="categ_id" ref="product_category_logspace"/>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="default_code">LOGSPACE-EXPR</field>
            <field name="description_sale">Priority delivery within 4 hours</field>
        </record>

        <record id="product_addon_helper_product_template" model="product.template">
            <field name="name">Extra Helper</field>
            <field name="categ_id" ref="product_category_logspace"/>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="default_code">LOGSPACE-HELP</field>
            <field name="description_sale">Additional helper for heavy items</field>
        </record>

        <record id="product_addon_protection_product_template" model="product.template">
            <field name="name">Furniture Protection</field>
            <field name="categ_id" ref="product_category_logspace"/>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="default_code">LOGSPACE-PROT</field>
            <field name="description_sale">Wrapping and padding for delicate furniture</field>
        </record>

        <record id="product_addon_gps_product_template" model="product.template">
            <field name="name">GPS Tracking</field>
            <field name="categ_id" ref="product_category_logspace"/>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="default_code">LOGSPACE-GPS</field>
            <field name="description_sale">Real-time tracking of your delivery</field>
        </record>

        <record id="product_addon_insurance_product_template" model="product.template">
            <field name="name">Cargo Insurance</field>
            <field name="categ_id" ref="product_category_logspace"/>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="default_code">LOGSPACE-INS</field>
            <field name="description_sale">Full coverage insurance for valuable items</field>
        </record>
    </data>
</odoo>
