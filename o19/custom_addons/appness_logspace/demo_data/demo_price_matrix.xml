        <!-- PRICE MATRIX (Zone-to-Zone Pricing) -->
        <!--                                            -->
        <!-- Demonstrates two pricing granularity levels: -->
        <!--   1. City-level: specific zone pairs (e.g. Seeb → Bousher) -->
