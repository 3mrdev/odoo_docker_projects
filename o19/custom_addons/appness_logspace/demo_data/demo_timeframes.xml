<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- ============================================ -->
    <!-- PROVIDER TIME FRAMES                         -->
    <!-- Separate file to ensure time_slot refs work  -->
    <!-- ============================================ -->

    <!-- ABC Logistics Time Frames -->
    <record id="tf_abc_flatbed" model="logspace.provider.time.frame">
        <field name="partner_id" ref="partner_abc_logistics"/>
        <field name="vehicle_type_id" ref="vehicle_type_flatbed_3t"/>
        <field name="time_slot_ids" eval="[(6, 0, [ref('time_slot_morning'), ref('time_slot_afternoon')])]"/>
    </record>
