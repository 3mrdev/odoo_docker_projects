<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================================
         Vehicle Actions
         ============================================================================ -->
    <record id="action_logspace_vehicle_list" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">logspace.vehicle</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle!
            </p>
            <p>
                Vehicles are linked to providers and represent the actual trucks/vans
                available for logistics services.
            </p>
        </field>
    </record>

    <!-- ============================================================================
         Vehicle Tree View
         ============================================================================ -->
    <record id="view_logspace_vehicle_tree" model="ir.ui.view">
        <field name="name">logspace.vehicle.tree</field>
        <field name="model">logspace.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="vehicle_type_id"/>
                <field name="zone_id"/>
                <field name="plate_number"/>
                <field name="driver_id" domain="[('is_company','=',True)]"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="provider_state" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================================
         Vehicle Form View
         ============================================================================ -->
    <record id="view_logspace_vehicle_form" model="ir.ui.view">
        <field name="name">logspace.vehicle.form</field>
        <field name="model">logspace.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider_id" options="{'no_create': True}" domain="[('is_provider', '=', True),('is_company','=',True)]"/>
                            <field name="vehicle_type_id"/>
                            <field name="zone_id"/>
                            <field name="plate_number"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="provider_state" readonly="1"/>
                            <field name="driver_id" domain="[('is_company','=',True)]"/>
                            <field name="registration_doc_id"/>
                            <field name="insurance_doc_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================================
         Vehicle Kanban View
         ============================================================================ -->
    <record id="view_logspace_vehicle_kanban" model="ir.ui.view">
        <field name="name">logspace.vehicle.kanban</field>
        <field name="model">logspace.vehicle</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="vehicle_type_id"/>
                <field name="provider_id"/>
                <field name="zone_id"/>
                <field name="is_active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_content">
                                <div class="o_kanban_header">
                                    <span class="o_kanban_title">
                                        <strong><t t-esc="record.name.value"/></strong>
                                    </span>
                                </div>
                                <div class="text-muted">
                                    <t t-esc="record.vehicle_type_id.value"/>
                                </div>
                                <div class="mt-2">
                                    <i class="fa fa-building-o text-muted"/>
                                    <t t-esc="record.provider_id.value"/>
                                </div>
                                <div class="mt-1">
                                    <i class="fa fa-map-marker text-muted"/>
                                    <t t-esc="record.zone_id.value"/>
                                </div>
                                <div class="mt-2">
                                    <span t-if="record.is_active.raw_value" class="badge bg-success">Active</span>
                                    <span t-if="!record.is_active.raw_value" class="badge bg-danger">Inactive</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================================
         Vehicle Search View
         ============================================================================ -->
    <record id="view_logspace_vehicle_search" model="ir.ui.view">
        <field name="name">logspace.vehicle.search</field>
        <field name="model">logspace.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plate_number"/>
                <field name="provider_id"/>
                <field name="vehicle_type_id"/>
                <field name="zone_id"/>
                <filter name="filter_active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('is_active', '=', False)]"/>
                <separator/>
                <filter name="group_by_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                <filter name="group_by_vehicle_type" string="Vehicle Type" context="{'group_by': 'vehicle_type_id'}"/>
                <filter name="group_by_zone" string="Zone" context="{'group_by': 'zone_id'}"/>
            </search>
        </field>
    </record>

</odoo>
