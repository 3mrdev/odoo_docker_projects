<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Category Action -->
    <record id="action_logspace_vehicle_category" model="ir.actions.act_window">
        <field name="name">Vehicle Categories</field>
        <field name="res_model">logspace.vehicle.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle category!
            </p>
        </field>
    </record>

    <!-- Vehicle Category Tree View -->
    <record id="view_logspace_vehicle_category_tree" model="ir.ui.view">
        <field name="name">logspace.vehicle.category.tree</field>
        <field name="model">logspace.vehicle.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="vehicle_type_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Category Form View -->
    <record id="view_logspace_vehicle_category_form" model="ir.ui.view">
        <field name="name">logspace.vehicle.category.form</field>
        <field name="model">logspace.vehicle.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Vehicle Types">
                        <field name="vehicle_type_ids" nolabel="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="default_capacity_kg"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
