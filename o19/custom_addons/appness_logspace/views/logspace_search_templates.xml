<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screen 1 & 2: Search and Results Page with Real Data -->
    <template id="logspace_search_page" name="Logspace Search">
        <t t-call="appness_logspace.logspace_layout">
            <!-- Hero Search Section -->
            <section class="py-5 bg-light">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <h1 class="text-center mb-4">Find the Perfect Vehicle for Your Move</h1>
                            <p class="text-center text-muted mb-4">Compare prices, read reviews, and book instantly</p>

                            <div class="card shadow-sm">
                                <div class="card-body p-4">
                                    <form action="/logspace/search" method="POST" enctype="multipart/form-data" class="logspace-search-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <script type="application/json" id="logspace-zones-data">
                                             <t t-out="zones_json"/>
                                         </script>
                                        <script type="application/json" id="logspace-vehicle-types-data">
                                             <t t-out="vehicle_types_json"/>
                                         </script>
                                        <!-- Row 1: Pickup / Dropoff / Date -->
                                        <div class="row g-3 mb-3">
                                            <!-- Pickup Zone -->
                                            <div class="col-md-4 zone-autocomplete-wrapper position-relative">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-circle text-primary me-1"/>
                                                    Pickup From
                                                </label>
                                                <input type="text" class="form-control zone-autocomplete-input" placeholder="Type pickup address..." t-att-value="search_params.get('pickup_address_text', '')" autocomplete="off" data-role="zone-autocomplete" data-target-id="zone_from_id" data-target-text="pickup_address_text" required="required"/>
                                                <input type="hidden" name="zone_from_id" id="zone_from_id" t-att-value="search_params.get('zone_from_id', '')"/>
                                                <input type="hidden" name="pickup_address_text" id="pickup_address_text" t-att-value="search_params.get('pickup_address_text', '')"/>
                                            </div>
                                            <!-- Dropoff Zone -->
                                            <div class="col-md-4 zone-autocomplete-wrapper position-relative">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-map-marker text-danger me-1"/>
                                                    Dropoff To
                                                </label>
                                                <input type="text" class="form-control zone-autocomplete-input" placeholder="Type dropoff address..." t-att-value="search_params.get('dropoff_address_text', '')" autocomplete="off" data-role="zone-autocomplete" data-target-id="zone_to_id" data-target-text="dropoff_address_text" required="required"/>
                                                <input type="hidden" name="zone_to_id" id="zone_to_id" t-att-value="search_params.get('zone_to_id', '')"/>
                                                <input type="hidden" name="dropoff_address_text" id="dropoff_address_text" t-att-value="search_params.get('dropoff_address_text', '')"/>
                                            </div>
                                            <!-- Pickup Date -->
                                            <div class="col-md-4">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-calendar me-1"/>
                                                    Pickup Date
                                                </label>
                                                <input type="date" class="form-control" name="pickup_date" required="required" t-att-value="search_params.get('pickup_date')" t-att-min="(datetime.date.today()+ datetime.timedelta(days=1)).strftime('%Y-%m-%d')"/>
                                            </div>
                                        </div>
                                        <!-- Row 2: Category / Type / Search.
                                             The pickup timeframe moved to the booking item-details
                                             page, where the customer already knows which provider
                                             and vehicle he is booking. -->
                                        <div class="row g-3 align-items-end">
                                            <!-- Vehicle Category -->
                                            <div class="col-md-4">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-tags me-1"/>
                                                    Vehicle Category
                                                </label>
                                                <select class="form-select" name="vehicle_category_id">
                                                    <option value="">All Categories</option>
                                                    <t t-foreach="vehicle_categories" t-as="vc">
                                                        <option t-att-value="vc.id" t-att-selected="search_params.get('vehicle_category_id') and str(vc.id) == str(search_params.get('vehicle_category_id'))">
                                                            <t t-esc="vc.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            <!-- Vehicle Type -->
                                            <div class="col-md-4">
                                                <label class="form-label small text-muted mb-1">
                                                    <i class="fa fa-truck me-1"/>
                                                    Vehicle Type
                                                </label>
                                                <select class="form-select" name="vehicle_type_id">
                                                    <!-- Once a category is chosen every type in it is a
                                                         valid answer, so "All Vehicle Types" would only
                                                         let the customer submit a filter he just set. -->
                                                    <option value="" t-if="not search_params.get('vehicle_category_id')">All Vehicle Types</option>
                                                    <t t-foreach="vehicle_types" t-as="vt">
                                                        <option t-att-value="vt.id" t-att-selected="search_params.get('vehicle_type_id') and str(vt.id) == str(search_params.get('vehicle_type_id'))">
                                                            <t t-esc="vt.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            <!-- Search Button -->
                                            <div class="col-md-4">
                                                <button type="submit" class="btn btn-primary w-100">
                                                    <i class="fa fa-search me-2"/>
                                                    Search Available Vehicles
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Results Section -->
            <t t-if="search_error">
                <section class="py-4">
                    <div class="container">
                        <div class="alert alert-warning text-center" role="alert">
                            <i class="fa fa-calendar me-2"/>
                            <t t-esc="search_error"/>
                        </div>
                    </div>
                </section>
            </t>
            <t t-if="show_results">
                <section class="py-4">
                    <div class="container logspace-results">
                        <!-- No Results Message -->
                        <t t-if="not results">
                            <div class="alert alert-info text-center py-5">
                                <i class="fa fa-info-circle fa-3x mb-3"/>
                                <h4>No Vehicles available for this route</h4>
                                <p class="mb-0">Try selecting different zones or vehicle type.</p>
                            </div>
                        </t>

                        <!-- Results Found -->
                        <t t-if="results">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="mb-0">
                                    <t t-esc="total_results"/>
                                    <t t-if="total_results != 1"> Providers Available</t>
                                    <t t-else=""> Provider Available</t>
                                </h5>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-secondary js-view-grid">
                                        <i class="fa fa-th-large"/> Grid
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary js-view-list active">
                                        <i class="fa fa-list"/> List
                                    </button>
                                </div>
                            </div>

                            <!-- Grid View (Hidden by default) -->
                            <div class="row g-4 d-none" id="grid-view">
                                <t t-foreach="page_results" t-as="result">
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 shadow-sm border-0">
                                            <div class="card-img-top bg-light text-center">
                                                <img t-att-src="result['vehicle_type_image']" class="img-fluid" style="width: 100%; height: 200px; object-fit: cover;" t-att-alt="result['vehicle_type_name']"/>
                                            </div>
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h5 class="card-title mb-0" t-esc="result['vehicle_type_name']"/>
                                                    <span class="badge bg-success">
                                                        <t t-esc="result['formatted_price']"/>
                                                    </span>
                                                </div>
                                                <p class="text-muted small mb-2">
                                                    <i class="fa fa-building-o me-1"/>
                                                    <span t-esc="result['provider_name']"/>
                                                </p>
                                                <div class="mb-2">
                                                    <span class="text-warning">
                                                        <i class="fa fa-star"/>
                                                        <span t-esc="'%.1f' % result['rating'] if result['rating'] else 'N/A'"/>
                                                    </span>
                                                    <span class="text-muted small ms-1">
                                                        (<span t-esc="result['reviews']"/> reviews)
                                                    </span>
                                                </div>
                                                <!-- Zones -->
                                                <div class="mb-2 small bg-light p-2 rounded">
                                                    <p class="mb-1">
                                                        <i class="fa fa-circle text-primary me-1"/>
                                                        <strong>From:</strong> <span t-esc="result['zone_from']"/>
                                                    </p>
                                                    <p class="mb-0">
                                                        <i class="fa fa-map-marker text-danger me-1"/>
                                                        <strong>To:</strong> <span t-esc="result['zone_to']"/>
                                                    </p>
                                                </div>
                                                <!-- Available Timeframes -->
                                                <div class="mb-2 small">
                                                    <p class="mb-1 text-muted">
                                                        <i class="fa fa-clock-o text-primary me-1"/>
                                                        <strong>Available Times:</strong>
                                                    </p>
                                                    <t t-foreach="result['timeframes']" t-as="tf">
                                                        <span class="badge bg-light text-dark me-1" t-esc="tf.name"/>
                                                    </t>
                                                    <t t-if="not result['timeframes']">
                                                        <span class="text-muted">Contact for availability</span>
                                                    </t>
                                                </div>
                                                <a t-att-href="result['vehicle_info_url']" class="btn btn-primary w-100">
                                                    View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <!-- List View (Default) -->
                            <div id="list-view">
                                <div class="card">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Vehicle</th>
                                                    <th>Provider</th>
                                                    <th>Route</th>
                                                    <th>Available Times</th>
                                                    <th>Price</th>
                                                    <th>Rating</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="page_results" t-as="result">
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                <img t-att-src="result['vehicle_type_image']" class="rounded me-3 logspace-list-img" t-att-alt="result['vehicle_type_name']"/>
                                                                <div>
                                                                    <strong t-esc="result['vehicle_type_name']"/>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td t-esc="result['provider_name']"/>
                                                        <td>
                                                            <small>
                                                                <i class="fa fa-circle text-primary me-1"/>
                                                                <span t-esc="result['zone_from']"/>
                                                                <br/>
                                                                <i class="fa fa-map-marker text-danger me-1"/>
                                                                <span t-esc="result['zone_to']"/>
                                                            </small>
                                                        </td>
                                                        <td>
                                                            <t t-foreach="result['timeframes'][:2]" t-as="tf">
                                                                <span class="badge bg-light text-dark me-1" t-esc="tf.name"/>
                                                            </t>
                                                            <t t-if="len(result['timeframes']) &gt; 2">
                                                                <span class="badge bg-secondary">+<span t-esc="len(result['timeframes']) - 2"/> more</span>
                                                            </t>
                                                        </td>
                                                        <td>
                                                            <span class="fw-bold text-success">
                                                                <t t-esc="result['formatted_price']"/>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="text-warning">
                                                                <i class="fa fa-star"/>
                                                                <span t-esc="'%.1f' % result['rating'] if result['rating'] else 'N/A'"/>
                                                            </span>
                                                            <small class="text-muted">(<span t-esc="result['reviews']"/>)</small>
                                                        </td>
                                                        <td>
                                                            <a t-att-href="result['vehicle_info_url']" class="btn btn-primary btn-sm">View Details</a>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Pagination -->
                            <t t-if="total_pages &gt; 1">
                                <nav aria-label="Search results pagination" class="mt-4">
                                    <ul class="pagination justify-content-center gap-1">
                                        <li t-attf-class="page-item #{not has_prev and 'disabled' or ''}">
                                            <a class="page-link" t-att-href="page_urls.get(current_page - 1, '#')">
                                                <i class="fa fa-chevron-left"/> Previous
                                            </a>
                                        </li>
                                        <t t-foreach="page_range" t-as="p">
                                            <li t-attf-class="page-item #{p == current_page and 'active' or ''}">
                                                <a class="page-link" t-att-href="page_urls[p]" t-esc="p"/>
                                            </li>
                                        </t>
                                        <li t-attf-class="page-item #{not has_next and 'disabled' or ''}">
                                            <a class="page-link" t-att-href="page_urls.get(current_page + 1, '#')">
                                                Next <i class="fa fa-chevron-right"/>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </t>
                        </t>
                    </div>
                </section>
            </t>

            <!-- Initial State - No Search Yet -->
            <t t-if="not show_results">
                <section class="py-5">
                    <div class="container text-center">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <i class="fa fa-search fa-4x text-muted mb-4"/>
                                <h3>Start Your Search</h3>
                                <p class="text-muted">Select your pickup and dropoff zones, a vehicle category or type, and your pickup date to find available Vehicles.</p>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </t>
    </template>
</odoo>
