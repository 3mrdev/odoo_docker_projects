<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Provider Registration Layout -->
    <template id="logspace_provider_layout" name="Logspace Provider Layout">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-4">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="text-center mb-4">
                                <h2>Become a Logspace Provider</h2>
                                <p class="text-muted">Join our network of professional drivers and logistics providers</p>
                            </div>
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Stepper for Provider (reuses base stepper) -->
    <template id="logspace_provider_stepper" name="Logspace Provider Stepper">
        <t t-call="appness_logspace.logspace_stepper"/>
    </template>

    <!-- Screen 18: Provider Step 1 - Business Details -->
    <template id="logspace_provider_step1" name="Logspace Provider - Step 1">
        <t t-call="appness_logspace.logspace_provider_layout">
            <t t-set="current_step" t-value="1"/>
            <t t-set="total_steps" t-value="5"/>
            <t t-set="steps" t-value="['Business', 'Contacts', 'Fleet', 'Documents', 'Review']"/>
            <t t-call="appness_logspace.logspace_provider_stepper"/>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Business Details</h5>

                    <t t-if="email_error">
                        <div class="alert alert-danger mb-4">
                            <i class="fa fa-exclamation-circle me-2"/>
                            <t t-esc="email_error"/>
                        </div>
                    </t>

                    <form method="POST">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <!-- Login Credentials -->
                        <div class="alert alert-info mb-4">
                            <i class="fa fa-info-circle me-2"></i>
                            The below credentials are for the main contact of the business and will be used for login.
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email Address *</label>
                                <input type="email" name="email" class="form-control" placeholder="Your login email" required="required" t-att-value="provider_data.get('business', {}).get('email', '')"/>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Phone *</label>
                                <div class="logspace_intl_tel_widget">
                                    <input type="tel" class="form-control intl_tel_widget"
                                           name="phone_display"
                                           placeholder="e.g., +968 9999 9999" required="required"
                                           t-att-data-value="provider_data.get('business', {}).get('phone', '')"/>
                                    <p class="phone_output mt-2 alert d-none" role="alert"></p>
                                    <input type="hidden" class="phone_value" name="phone"
                                           t-att-value="provider_data.get('business', {}).get('phone', '')"/>
                                </div>
                            </div>
                        </div>
                        <hr class="my-4"/>

                        <div class="mb-3">
                            <label class="form-label">Business Name *</label>
                            <input type="text" name="business_name" class="form-control" placeholder="Your business name" required="required" t-att-value="provider_data.get('business', {}).get('name', '')"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tax ID / EIN</label>
                            <input type="text" name="tax_id" class="form-control" t-att-value="provider_data.get('business', {}).get('tax_id', '')"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">CR Number (Commercial Registration) *</label>
                            <input type="text" name="cr_number" class="form-control" placeholder="Enter your Commercial Registration Number" required="required" t-att-value="provider_data.get('business', {}).get('cr_number', '')"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Years of Experience</label>
                            <select name="years_experience" class="form-select">
                                <option value="Less than 1 year" t-att-selected="provider_data.get('business', {}).get('years_experience') == 'Less than 1 year'">Less than 1 year</option>
                                <option value="1-2 years" t-att-selected="provider_data.get('business', {}).get('years_experience') == '1-2 years'">1-2 years</option>
                                <option value="3-5 years" t-att-selected="provider_data.get('business', {}).get('years_experience') == '3-5 years' or not provider_data.get('business', {}).get('years_experience')">3-5 years</option>
                                <option value="5-10 years" t-att-selected="provider_data.get('business', {}).get('years_experience') == '5-10 years'">5-10 years</option>
                                <option value="More than 10 years" t-att-selected="provider_data.get('business', {}).get('years_experience') == 'More than 10 years'">More than 10 years</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Business Address</label>
                            <textarea name="address" class="form-control" rows="2" placeholder="Primary business address" t-esc="provider_data.get('business', {}).get('address', '')"/>
                        </div>
                        <div class="d-flex justify-content-end">
                            <t t-if="from_review">
                                <a href="/logspace/provider/register/5" class="btn btn-outline-secondary me-2">
                                    <i class="fa fa-arrow-left me-1"></i> Back to Review
                                </a>
                            </t>
                            <button type="submit" class="btn btn-primary">Next: Contacts</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 19: Provider Step 2 - Contacts (Table-based like Fleet) -->
    <template id="logspace_provider_step2" name="Logspace Provider - Step 2">
        <t t-call="appness_logspace.logspace_provider_layout">
            <t t-set="current_step" t-value="2"/>
            <t t-set="total_steps" t-value="5"/>
            <t t-set="steps" t-value="['Business', 'Contacts', 'Fleet', 'Documents', 'Review']"/>
            <t t-call="appness_logspace.logspace_provider_stepper"/>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Contacts</h5>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addContactRow()">
                            <i class="fa fa-plus me-1"></i> Add Contact
                        </button>
                    </div>

                    <form method="POST">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="table-responsive mb-4" style="overflow-x: auto;">
                            <table class="table table-bordered" id="contactsTable" style="min-width: 700px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="min-width: 140px;">Name *</th>
                                        <th style="min-width: 120px;">Role *</th>
                                        <th style="min-width: 140px;">Phone *</th>
                                        <th style="min-width: 160px;">Email</th>
                                        <th style="min-width: 40px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="existing_contacts or []" t-as="contact">
                                        <tr class="contact-row">
                                            <input type="hidden" name="contact_id[]" t-att-value="contact.get('id', 0)"/>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" name="contact_name[]" placeholder="Full name" required="required" t-att-value="contact.get('name', '')"/>
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm" name="contact_role[]" required="required">
                                                    <option value="">Select...</option>
                                                    <option value="owner" t-att-selected="contact.get('role') == 'owner'">Owner</option>
                                                    <option value="manager" t-att-selected="contact.get('role') == 'manager'">Manager</option>
                                                    <option value="driver" t-att-selected="contact.get('role') == 'driver'">Driver</option>
                                                    <option value="dispatcher" t-att-selected="contact.get('role') == 'dispatcher'">Dispatcher</option>
                                                    <option value="accountant" t-att-selected="contact.get('role') == 'accountant'">Accountant</option>
                                                    <option value="other" t-att-selected="contact.get('role') == 'other'">Other</option>
                                                </select>
                                            </td>
                                            <td>
                                                <div class="logspace_intl_tel_widget">
                                                    <input type="tel" class="form-control form-control-sm intl_tel_widget"
                                                           name="contact_phone_display[]"
                                                           placeholder="+968 9999 9999" required="required"
                                                           t-att-data-value="contact.get('phone', '')"/>
                                                    <p class="phone_output mt-1 alert d-none" role="alert" style="font-size:0.75rem;"></p>
                                                    <input type="hidden" class="phone_value" name="contact_phone[]"
                                                           t-att-value="contact.get('phone', '')"/>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="email" class="form-control form-control-sm" name="contact_email[]" placeholder="email@example.com" t-att-value="contact.get('email', '')"/>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-link text-danger btn-sm p-0" onclick="removeContactRow(this)">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="contact-row d-none" id="contactTemplate">
                                        <input type="hidden" name="contact_id[]" value="0"/>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" name="contact_name[]" placeholder="Full name" disabled="disabled" required="required"/>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" name="contact_role[]" disabled="disabled" required="required">
                                                <option value="">Select...</option>
                                                <option value="owner">Owner</option>
                                                <option value="manager">Manager</option>
                                                <option value="driver">Driver</option>
                                                <option value="dispatcher">Dispatcher</option>
                                                <option value="accountant">Accountant</option>
                                                <option value="other">Other</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="logspace_intl_tel_widget">
                                                <input type="tel" class="form-control form-control-sm intl_tel_widget"
                                                       name="contact_phone_display[]"
                                                       placeholder="+968 9999 9999" disabled="disabled" required="required"/>
                                                <p class="phone_output mt-1 alert d-none" role="alert" style="font-size:0.75rem;"></p>
                                                <input type="hidden" class="phone_value" name="contact_phone[]" disabled="disabled"/>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="email" class="form-control form-control-sm" name="contact_email[]" placeholder="email@example.com" disabled="disabled"/>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-link text-danger btn-sm p-0" onclick="removeContactRow(this)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="/logspace/provider/register/1" class="btn btn-outline-secondary">Back</a>
                                <t t-if="from_review">
                                    <a href="/logspace/provider/register/5" class="btn btn-outline-secondary ms-2">
                                        <i class="fa fa-arrow-left me-1"></i> Back to Review
                                    </a>
                                </t>
                            </div>
                            <button type="submit" class="btn btn-primary">Next: Fleet</button>
                        </div>
                    </form>
                </div>
            </div>

            <script><![CDATA[
                function addContactRow() {
                    const table = document.getElementById('contactsTable');
                    const tbody = table.querySelector('tbody');
                    const template = document.getElementById('contactTemplate');
                    const newRow = template.cloneNode(true);

                    // Enable and clear inputs
                    newRow.querySelectorAll('input, select').forEach(input => {
                        input.removeAttribute('disabled');
                        input.value = '';
                    });

                    // Remove d-none class to make it visible
                    newRow.classList.remove('d-none');

                    tbody.appendChild(newRow);

                    // Initialize intl-tel-input on the new phone field
                    if (window.initLogspacePhoneInput) {
                        const phoneWrapper = newRow.querySelector('.logspace_intl_tel_widget');
                        if (phoneWrapper) {
                            window.initLogspacePhoneInput(phoneWrapper);
                        }
                    }
                }

                function removeContactRow(btn) {
                    const row = btn.closest('tr');
                    // Destroy intl-tel-input instance if present
                    const phoneInput = row.querySelector('.intl_tel_widget');
                    if (phoneInput && phoneInput._iti) {
                        phoneInput._iti.destroy();
                    }
                    row.remove();
                }
            ]]></script>
        </t>
    </template>

    <!-- Screen 20: Provider Step 3 - Fleet (Simplified) -->
    <template id="logspace_provider_step3" name="Logspace Provider - Step 3">
        <t t-call="appness_logspace.logspace_provider_layout">
            <t t-set="current_step" t-value="3"/>
            <t t-set="total_steps" t-value="5"/>
            <t t-set="steps" t-value="['Business', 'Contacts', 'Fleet', 'Documents', 'Review']"/>
            <t t-call="appness_logspace.logspace_provider_stepper"/>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Fleet Information</h5>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addVehicleRow()">
                            <i class="fa fa-plus me-1"></i> Add Vehicle
                        </button>
                    </div>

                    <div class="alert alert-info mb-4">
                        <i class="fa fa-info-circle me-2"></i>
                        The below info is about your fleet capacity for each vehicle type e.g. you have 10 vehicles of type <b>Flatbed Truck 3T</b> , 5 vehicles of type <b>Flatbed Truck 5T</b>, etc. Detailed vehicle information will be asked later.
                    </div>

                    <form method="POST">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="table-responsive mb-4" style="overflow-x: auto;">
                            <table class="table table-bordered" id="vehiclesTable" style="min-width: 700px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="min-width: 140px;">Vehicle Type *</th>
                                        <th style="min-width: 90px;">Fleet Count *</th>
                                        <th style="min-width: 90px;">Capacity</th>
                                        <th style="min-width: 150px;">Dimensions</th>
                                        <th style="min-width: 40px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="existing_fleet or []" t-as="fleet_item">
                                        <tr class="vehicle-row">
                                            <input type="hidden" name="fleet_id[]" t-att-value="fleet_item.get('id', 0)"/>
                                            <td>
                                                <select class="form-select form-select-sm" name="vehicle_type[]" required="required">
                                                    <option value="">Select...</option>
                                                    <t t-foreach="vehicle_types" t-as="vt">
                                                        <option t-att-value="vt[0]" t-esc="vt[1]" t-att-selected="fleet_item.get('vehicle_type_code') == vt[0]"/>
                                                    </t>
                                                </select>
                                            </td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm" name="fleet_count[]" placeholder="e.g., 5" min="1" required="required" t-att-value="fleet_item.get('fleet_count', 1)"/>
                                            </td>
                                            <td>
                                                <select class="form-select form-control-sm" name="capacity[]">
                                                    <option t-att-selected="fleet_item.get('capacity') == '1 Ton'">1 Ton</option>
                                                    <option t-att-selected="fleet_item.get('capacity') == '3 Tons'">3 Tons</option>
                                                    <option t-att-selected="fleet_item.get('capacity') == '5 Tons' or not fleet_item.get('capacity')">5 Tons</option>
                                                    <option t-att-selected="fleet_item.get('capacity') == '7.5 Tons'">7.5 Tons</option>
                                                    <option t-att-selected="fleet_item.get('capacity') == '10+ Tons'">10+ Tons</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" name="dimensions[]" placeholder="e.g., 300x200x150 cm" t-att-value="fleet_item.get('dimensions', '')"/>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-link text-danger btn-sm p-0" onclick="removeRow(this)">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="vehicle-row d-none" id="vehicleTemplate">
                                        <input type="hidden" name="fleet_id[]" value="0"/>
                                        <td>
                                            <select class="form-select form-select-sm" name="vehicle_type[]" disabled="disabled" required="required">
                                                <option value="">Select...</option>
                                                <t t-foreach="vehicle_types" t-as="vt">
                                                    <option t-att-value="vt[0]" t-esc="vt[1]"/>
                                                </t>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" name="fleet_count[]" placeholder="e.g., 5" min="1" disabled="disabled" required="required"/>
                                        </td>
                                        <td>
                                            <select class="form-select form-control-sm" name="capacity[]" disabled="disabled">
                                                <option>1 Ton</option>
                                                <option>3 Tons</option>
                                                <option selected="selected">5 Tons</option>
                                                <option>7.5 Tons</option>
                                                <option>10+ Tons</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" name="dimensions[]" placeholder="e.g., 300x200x150 cm" disabled="disabled"/>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-link text-danger btn-sm p-0" onclick="removeRow(this)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="/logspace/provider/register/2" class="btn btn-outline-secondary">Back</a>
                                <t t-if="from_review">
                                    <a href="/logspace/provider/register/5" class="btn btn-outline-secondary ms-2">
                                        <i class="fa fa-arrow-left me-1"></i> Back to Review
                                    </a>
                                </t>
                            </div>
                            <button type="submit" class="btn btn-primary">Next: Documents</button>
                        </div>
                    </form>
                </div>
            </div>

            <script>
                function addVehicleRow() {
                    const table = document.getElementById('vehiclesTable');
                    const tbody = table.querySelector('tbody');
                    const template = document.getElementById('vehicleTemplate');
                    const newRow = template.cloneNode(true);

                    // Enable and clear inputs
                    newRow.querySelectorAll('input, select').forEach(input => {
                        input.removeAttribute('disabled');
                        input.value = '';
                    });

                    // Remove d-none class to make it visible
                    newRow.classList.remove('d-none');

                    tbody.appendChild(newRow);
                }

                function removeRow(btn) {
                    const row = btn.closest('tr');
                    row.remove();
                }
            </script>
        </t>
    </template>

    <!-- Screen 21: Provider Step 4 - Documents -->
    <template id="logspace_provider_step4" name="Logspace Provider - Step 4">
        <t t-call="appness_logspace.logspace_provider_layout">
            <t t-set="current_step" t-value="4"/>
            <t t-set="total_steps" t-value="5"/>
            <t t-set="steps" t-value="['Business', 'Contacts', 'Fleet', 'Documents', 'Review']"/>
            <t t-call="appness_logspace.logspace_provider_stepper"/>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Upload Documents</h5>

                    <!-- Validation Error Alert -->
                    <t t-if="document_error">
                        <div class="alert alert-danger mb-4">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            <strong>Required documents missing:</strong>
                            <ul class="mb-0 mt-2">
                                <t t-foreach="missing_documents" t-as="doc">
                                    <li t-esc="doc"/>
                                </t>
                            </ul>
                            <p class="mb-0 mt-2 small">Please upload all required documents before proceeding.</p>
                        </div>
                    </t>

                    <form method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-4">
                            <label class="form-label">Vehicles Documents *</label>
                            <div class="border rounded p-3 bg-light">
                                <div class="text-center">
                                    <i class="fa fa-id-card-o fa-3x text-muted mb-2"></i>
                                    <p class="text-muted mb-2">Upload a pdf that contains images of all Vehicles and their documents (20MB Max)</p>
                                    <t t-set="vehicles_doc" t-value="provider_data.get('documents', {}).get('vehicles_doc', {})"/>
                                    <t t-if="vehicles_doc and vehicles_doc.get('filename')">
                                        <div class="alert alert-success mb-2">
                                            <i class="fa fa-check me-1"></i> <span t-esc="vehicles_doc.get('filename')"/> already uploaded
                                        </div>
                                        <p class="text-muted small">Upload a new file to replace it, or leave empty to keep the existing file.</p>
                                    </t>
                                    <input type="file" name="vehicles_doc" class="form-control" accept="application/pdf"
                                           t-att-required="'required' if not (vehicles_doc and vehicles_doc.get('filename')) else None"/>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Company Registration Documents *</label>
                            <div class="border rounded p-3 bg-light">
                                <div class="text-center">
                                    <i class="fa fa-file-text-o fa-3x text-muted mb-2"></i>
                                    <p class="text-muted mb-2">Upload the files as PDF Format (20MB Max)</p>
                                    <t t-set="company_doc" t-value="provider_data.get('documents', {}).get('company_doc', {})"/>
                                    <t t-if="company_doc and company_doc.get('filename')">
                                        <div class="alert alert-success mb-2">
                                            <i class="fa fa-check me-1"></i> <span t-esc="company_doc.get('filename')"/> already uploaded
                                        </div>
                                        <p class="text-muted small">Upload a new file to replace it, or leave empty to keep the existing file.</p>
                                    </t>
                                    <input type="file" name="company_doc" class="form-control" accept="application/pdf"
                                           t-att-required="'required' if not (company_doc and company_doc.get('filename')) else None"/>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Bank Statement *</label>
                            <div class="border rounded p-3 bg-light">
                                <div class="text-center">
                                    <i class="fa fa-university fa-3x text-muted mb-2"></i>
                                    <p class="text-muted mb-2">Bank statement valid for 3 months (20MB Max)</p>
                                    <t t-set="bank_statement" t-value="provider_data.get('documents', {}).get('bank_statement', {})"/>
                                    <t t-if="bank_statement and bank_statement.get('filename')">
                                        <div class="alert alert-success mb-2">
                                            <i class="fa fa-check me-1"></i> <span t-esc="bank_statement.get('filename')"/> already uploaded
                                        </div>
                                        <p class="text-muted small">Upload a new file to replace it, or leave empty to keep the existing file.</p>
                                    </t>
                                    <input type="file" name="bank_statement" class="form-control" accept="application/pdf"
                                           t-att-required="'required' if not (bank_statement and bank_statement.get('filename')) else None"/>
                                </div>
                            </div>
                            <div class="form-text small text-muted mt-1">
                                <i class="fa fa-info-circle me-1"></i> Required for payment processing and payouts
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input" name="confirm_documents" type="checkbox" required="required"/>
                                <label class="form-check-label">
                                    I confirm all documents are genuine and valid
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="/logspace/provider/register/3" class="btn btn-outline-secondary">Back</a>
                                <t t-if="from_review">
                                    <a href="/logspace/provider/register/5" class="btn btn-outline-secondary ms-2">
                                        <i class="fa fa-arrow-left me-1"></i> Back to Review
                                    </a>
                                </t>
                            </div>
                            <button type="submit" class="btn btn-primary">Next: Review</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- Step 5: Review - Now with dynamic data -->
    <template id="logspace_provider_step5" name="Logspace Provider - Step 5 (Review)">
        <t t-call="appness_logspace.logspace_provider_layout">
            <t t-set="current_step" t-value="5"/>
            <t t-set="total_steps" t-value="5"/>
            <t t-set="steps" t-value="['Business', 'Contacts', 'Fleet', 'Documents', 'Review']"/>
            <t t-call="appness_logspace.logspace_provider_stepper"/>

            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Review Your Application</h5>
                </div>
                <div class="card-body">
                    <!-- Business Info Summary -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Business Details</h6>
                            <a href="/logspace/provider/register/1?from_review=1" class="btn btn-sm btn-outline-primary">Edit</a>
                        </div>
                        <div class="border rounded p-3 bg-light">
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Email:</strong> <span t-esc="business.get('email', 'N/A')"/></p>
                                    <p class="mb-1"><strong>Phone:</strong> <span t-esc="business.get('phone', 'N/A')"/></p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Business Name:</strong> <span t-esc="business.get('name', 'N/A')"/></p>
                                    <p class="mb-1"><strong>CR Number:</strong> <span t-esc="business.get('cr_number', 'N/A')"/></p>
                                    <p class="mb-1"><strong>Tax ID:</strong> <span t-esc="business.get('tax_id', 'N/A')"/></p>
                                    <p class="mb-1"><strong>Experience:</strong> <span t-esc="business.get('years_experience', 'N/A')"/></p>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <p class="mb-1"><strong>Address:</strong> <span t-esc="business.get('address', 'N/A')"/></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contacts Summary -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Contacts</h6>
                            <a href="/logspace/provider/register/2?from_review=1" class="btn btn-sm btn-outline-primary">Edit</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered bg-light">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Role</th>
                                        <th>Phone</th>
                                        <th>Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="contacts and len(contacts) > 0">
                                        <t t-foreach="contacts" t-as="contact">
                                            <tr>
                                                <td t-esc="contact.get('name', '')"/>
                                                <td t-esc="contact.get('role', '').title()"/>
                                                <td t-esc="contact.get('phone', '')"/>
                                                <td t-esc="contact.get('email', '')"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="not contacts or len(contacts) == 0">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">No contacts added</td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Fleet Info Summary -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Fleet Information</h6>
                            <a href="/logspace/provider/register/3?from_review=1" class="btn btn-sm btn-outline-primary">Edit</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered bg-light">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>Fleet Count</th>
                                        <th>Capacity</th>
                                        <th>Dimensions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="fleet and len(fleet) > 0">
                                        <t t-foreach="fleet" t-as="fleet_item">
                                            <tr>
                                                <td t-esc="fleet_item.get('vehicle_type_code', '').title()"/>
                                                <td t-esc="fleet_item.get('fleet_count', 1)"/>
                                                <td t-esc="fleet_item.get('capacity', '')"/>
                                                <td t-esc="fleet_item.get('dimensions', '')"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="not fleet or len(fleet) == 0">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">No fleet information added</td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Documents Summary -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Documents</h6>
                            <a href="/logspace/provider/register/4?from_review=1" class="btn btn-sm btn-outline-primary">Edit</a>
                        </div>
                        <div class="border rounded p-3 bg-light">
                            <p class="mb-1">
                                <i t-att-class="'fa fa-check-circle me-1 ' + (documents and documents.get('vehicles_doc') and documents.get('vehicles_doc').get('filename') and 'text-success' or 'text-muted')"/>
                                Vehicles Documents
                                <t t-if="documents and documents.get('vehicles_doc') and documents.get('vehicles_doc').get('filename')">
                                    <span class="text-muted small">(<t t-esc="documents.get('vehicles_doc').get('filename', '')"/>)</span>
                                </t>
                            </p>
                            <p class="mb-1">
                                <i t-att-class="'fa fa-check-circle me-1 ' + (documents and documents.get('company_doc') and documents.get('company_doc').get('filename') and 'text-success' or 'text-muted')"/>
                                Company Registration Documents
                                <t t-if="documents and documents.get('company_doc') and documents.get('company_doc').get('filename')">
                                    <span class="text-muted small">(<t t-esc="documents.get('company_doc').get('filename', '')"/>)</span>
                                </t>
                            </p>
                            <p class="mb-1">
                                <i t-att-class="'fa fa-check-circle me-1 ' + (documents and documents.get('bank_statement') and documents.get('bank_statement').get('filename') and 'text-success' or 'text-muted')"/>
                                Bank Statement
                                <t t-if="documents and documents.get('bank_statement') and documents.get('bank_statement').get('filename')">
                                    <span class="text-muted small">(<t t-esc="documents.get('bank_statement').get('filename', '')"/>)</span>
                                </t>
                            </p>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <i class="fa fa-info-circle me-2"></i>
                        By submitting, you agree to our <a href="#">Terms of Service</a> and confirm all information is accurate.
                    </div>

                    <form method="POST" action="/logspace/provider/done">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="submit" value="true"/>
                        <div class="d-flex justify-content-between">
                            <a href="/logspace/provider/register/4" class="btn btn-outline-secondary">Back</a>
                            <button type="submit" class="btn btn-success btn-lg">Submit Application</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 23: Provider Step 6 - kept as alias to step 5 for backward compat -->
    <template id="logspace_provider_step6" name="Logspace Provider - Step 6 (Alias)">
        <t t-call="appness_logspace.logspace_provider_step5"/>
    </template>

    <!-- Provider Registration Done -->
    <template id="logspace_provider_done" name="Logspace Provider - Done">
        <t t-call="appness_logspace.logspace_provider_layout">
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="fa fa-check-circle fa-5x text-success"></i>
                </div>
                <h2 class="mb-3">Application Submitted!</h2>
                <p class="lead text-muted mb-4">Thank you for joining Logspace as a provider.</p>

                <div class="card mb-4 mx-auto" style="max-width: 400px;">
                    <div class="card-body">
                        <h5 class="text-warning">Status: Pending Approval</h5>
                        <p class="text-muted small mb-0">We're reviewing your documents.<br/>This usually takes 1-2 business days.</p>
                    </div>
                </div>

                <p class="text-muted mb-4">You'll receive an email notification once approved.</p>

                <div class="d-grid gap-2 d-md-block">
                    <a href="/logspace" class="btn btn-primary me-md-2">Back to Home</a>
                </div>
            </div>
        </t>
    </template>

</odoo>
