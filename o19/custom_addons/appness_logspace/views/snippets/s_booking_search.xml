<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_booking_search" name="Booking Search">
        <section class="s_cover bg-primary o_colored_level" style="padding-top: 6rem; padding-bottom: 6rem;">
            <div class="container text-center text-white">
                <h1 class="display-5 fw-bold mb-3">Find Your Perfect Truck</h1>
                <p class="lead mb-5" style="opacity: 0.9;">Search and book trucks for your transportation needs</p>
                
                <section class="s_booking_search bg-white rounded shadow p-3 my-3">
                    <div class="container-fluid">
                        <form action="/booking" method="get">
                            <div class="row align-items-center g-3 text-start">
                                <!-- Service Type -->
                                <div class="col-12 col-md border-end-md">
                                    <label class="form-label small text-muted mb-0"><i class="fa fa-truck me-2"></i>Service Type</label>
                                    <select class="form-select border-0 shadow-none ps-0" name="service_type" style="cursor: pointer;">
                                        <option>Refrigerated</option>
                                        <option>Flatbed</option>
                                        <option>Box Truck</option>
                                    </select>
                                </div>
                                <!-- Pickup Location -->
                                <div class="col-12 col-md border-end-md">
                                    <label class="form-label small text-muted mb-0"><i class="fa fa-map-marker me-2"></i>Pickup Location</label>
                                    <input type="text" class="form-control border-0 shadow-none ps-0" name="pickup" placeholder="Enter city or address" />
                                </div>
                                <!-- Drop Off Location -->
                                <div class="col-12 col-md border-end-md">
                                    <label class="form-label small text-muted mb-0"><i class="fa fa-map-marker me-2"></i>Drop Off Location</label>
                                    <input type="text" class="form-control border-0 shadow-none ps-0" name="dropoff" placeholder="Enter city or address" />
                                </div>
                                <!-- Date -->
                                <div class="col-12 col-md border-end-md">
                                    <label class="form-label small text-muted mb-0"><i class="fa fa-calendar me-2"></i>Date</label>
                                    <input type="text" class="form-control border-0 shadow-none ps-0" name="date" placeholder="dd/mm/yyyy" />
                                </div>
                                <!-- Search Button -->
                                <div class="col-12 col-md-auto text-end mt-3 mt-md-0">
                                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded text-nowrap px-4 py-2" style="font-size: 1rem;">
                                        <i class="fa fa-search me-1"></i> Search
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </section>
    </template>
</odoo>
