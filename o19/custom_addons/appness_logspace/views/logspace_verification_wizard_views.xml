<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="logspace_verification_wizard_view_form" model="ir.ui.view">
        <field name="name">logspace.verification.wizard.form</field>
        <field name="model">logspace.verification.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Verification">
                <field name="order_id" invisible="1"/>
                <field name="code_type" invisible="1"/>
                <group>
                    <div colspan="2" class="alert alert-info" role="alert" invisible="code_type != 'pickup'">
                        <i class="fa fa-shield me-1"/>
                        To complete the pickup, ask the customer for their
                        <strong>4-digit pickup verification code</strong> shown on their order tracking page.
                    </div>
                    <div colspan="2" class="alert alert-info" role="alert" invisible="code_type != 'dropoff'">
                        <i class="fa fa-shield me-1"/>
                        To complete the drop-off, ask the customer for their
                        <strong>4-digit drop-off verification code</strong> shown on their order tracking page.
                    </div>
                    <field name="entered_code" placeholder="Enter code from customer"
                        class="fw-bold text-center" style="font-size: 1.6em; letter-spacing: 0.5em;"/>
                </group>
                <footer>
                    <button name="action_verify" string="Verify &amp; Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
