<odoo>
    <data>
        <record id="swms_product_form_inherit" model="ir.ui.view">
            <field name="name">swms.product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view" />
            <field name="arch" type="xml">

                <div name="options" position="inside">
                    <span class="d-inline-flex">
                        <field name="is_logspace" string="Logspace" />
                        <label for="is_logspace" />
                    </span>
                </div>

                <xpath expr="//notebook/page[1]" position="before">
                    <page string="Logspace" invisible="not is_logspace"
                        groups="sales_team.group_sale_salesman">
                        <group>
                            <group>
                                <field name="document_types" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="is_published_logspace" widget="boolean_toggle" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>