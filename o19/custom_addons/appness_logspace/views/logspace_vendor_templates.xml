<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screen 3: Vendor/Item Page -->
    <template id="logspace_vendor_page" name="Logspace Vendor Details">
        <t t-call="appness_logspace.logspace_layout">
            <div class="container py-4">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/logspace">Home</a></li>
                        <li class="breadcrumb-item"><a href="/logspace/search">Trucks</a></li>
                        <li class="breadcrumb-item active" t-esc="vendor['name']"/>
                    </ol>
                </nav>

                <div class="row">
                    <!-- Main Content -->
                    <div class="col-lg-8">
                        <!-- Service Header Card -->
                        <div class="card mb-4">
                            <div class="card-img-top text-center">
                                <img t-att-src="vendor['image']" class="img-fluid w-100" style="height: 300px; object-fit: cover;" t-att-alt="vendor['service_name']"/>
                            </div>
                            <div class="card-body text-center">
                                <h3 t-esc="vendor['service_name']"/>
                                <!-- <p class="text-muted mb-0">
                                    <i class="fa fa-map-marker me-1"></i>
                                    <span t-esc="vendor['city_location']"/>
                                </p> -->
                            </div>
                        </div>

                        <!-- Vendor Info -->
                        <div class="card mb-4">
                            <div class="card-body">
                                
                                <div class="d-flex align-items-center mb-3">
                                    <div class="flex-grow-1">
                                        <h4>
                                            <img t-att-src="vendor['logo']" class="img-fluid" style="height: 50px; width: 50px; object-fit: contain;" t-att-alt="vendor['service_name']"/>
                                            <span t-esc="vendor['name']"/>
                                        </h4>
                                        <p class="text-muted mb-0">
                                            <span class="text-warning"><i class="fa fa-star"></i> <span t-esc="vendor['rating']"/></span>
                                            <span class="text-muted">(<span t-esc="vendor['reviews']"/> reviews)</span>
                                        </p>
                                    </div>
                                </div>
                                <p t-esc="vendor['description']"/>
                                <!-- <p class="text-muted small">
                                    <i class="fa fa-calendar me-1"></i> Member since <span t-esc="vendor['joined']"/>
                                </p> -->
                            </div>
                        </div>

                        <!-- About This Service -->
                        <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-info-circle text-primary me-2"></i>About This Service</h5>
                            </div>
                            <div class="card-body">
                                <p t-esc="vendor['about_service']"/>
                            </div>
                        </div>

                        <!-- Available Timeframes -->
                        <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-clock-o text-primary me-2"></i>Available Timeframes</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <h6 class="text-muted">Pickup</h6>
                                        <p class="mb-1"><span class="badge bg-primary" t-esc="vendor['pickup_timeframe']"/></p>
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="text-muted">Dropoff</h6>
                                        <p class="mb-1"><span class="badge bg-success" t-esc="vendor['dropoff_timeframe']"/></p>
                                    </div>
                                </div>
                                <hr/>
                                <h6 class="text-muted small mb-2">Other Available Time Slots:</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    <t t-foreach="vendor['available_timeframes']" t-as="timeframe">
                                        <span class="badge bg-light text-dark border" t-esc="timeframe"/>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Storage Information -->
                        <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-cube text-primary me-2"></i>Storage Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4 text-center">
                                        <div class="bg-light rounded p-3">
                                            <h4 class="mb-0 text-primary" t-esc="vendor['storage_dimensions']"/>
                                            <small class="text-muted">L x W x H (cm)</small>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <p class="mb-0" t-esc="vendor['storage_details']"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Required Documents -->
                        <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-file-text text-primary me-2"></i>Required Documents</h5>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="vendor['required_documents']" t-as="doc">
                                        <li class="list-group-item px-0">
                                            <i class="fa fa-check-circle text-success me-2"></i>
                                            <span t-esc="doc"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>

                        <!-- Contact Info -->
                        <!-- <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-address-card text-primary me-2"></i>Contact Information</h5>
                            </div>
                            <div class="card-body">
                                <p><i class="fa fa-phone me-2 text-primary"></i> <span t-esc="vendor['phone']"/></p>
                                <p class="mb-0"><i class="fa fa-envelope me-2 text-primary"></i> <span t-esc="vendor['email']"/></p>
                            </div>
                        </div> -->

                        <!-- Available Add-ons -->
                        <div class="card">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-plus-circle text-primary me-2"></i>Available Add-ons</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <t t-foreach="addons" t-as="addon">
                                        <div class="col-md-6 mb-3">
                                            <div class="d-flex align-items-start">
                                                <div class="flex-shrink-0">
                                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                        <i class="fa fa-check text-success"></i>
                                                    </div>
                                                </div>
                                                <div class="ms-3 flex-grow-1">
                                                    <h6 class="mb-1" t-esc="addon['name']"/>
                                                    <p class="small text-muted mb-1" t-esc="addon['description']"/>
                                                    <span class="text-success fw-bold">+<span t-esc="currency_symbol + ' ' + str(int(addon['price']))"/></span>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sidebar - Booking CTA -->
                    <div class="col-lg-4">
                        <div class="card shadow-sm sticky-top" style="top: 20px;">
                            <div class="card-body">
                                <!-- <h5 class="card-title">Estimate</h5> -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>Price Estimate</span>
                                        <span class="text-success fs-4" t-esc="currency_symbol + ' ' + '150'"/>
                                    </div>
                                </div>
                                <a href="/logspace/booking/details" class="btn btn-primary w-100 btn-lg mb-2">Book Now</a>
                                <div class="small text-muted mt-2">
                                    <p class="mb-1"><i class="fa fa-check-circle text-success me-1"></i> Free cancellation up to 24 hours before booking date</p>
                                    <p class="mb-1"><i class="fa fa-exclamation-circle text-warning me-1"></i> 50% refund after Pickup Started</p>
                                    <p class="mb-0"><i class="fa fa-times-circle text-danger me-1"></i> 0% refund after Pickup Completed</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Vehicle Info Page (real data) - between search and booking -->
    <template id="logspace_vehicle_info_page" name="Logspace Vehicle Details">
        <t t-call="appness_logspace.logspace_layout">
            <div class="container py-4">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/logspace">Home</a></li>
                        <li class="breadcrumb-item"><a href="/logspace/search">Trucks</a></li>
                        <li class="breadcrumb-item active" t-esc="vehicle_type.name"/>
                    </ol>
                </nav>

                <div class="row">
                    <!-- Main Content -->
                    <div class="col-lg-8">
                        <!-- Service Image & Header -->
                        <div class="card mb-4">
                            <div class="card-img-top text-center">
                                <img t-att-src="vehicle_type.image_url or '/appness_logspace/static/src/img/truck_flatbed.jpg'"
                                     class="img-fluid w-100" style="height: 300px; object-fit: cover;"
                                     t-att-alt="vehicle_type.name"/>
                            </div>
                            <div class="card-body text-center">
                                <h3 t-esc="vehicle_type.name"/>
                                <p class="text-muted mb-0">
                                    <i class="fa fa-truck me-1"></i>
                                    <span t-esc="vehicle_type.category_id.name"/>
                                    <!-- <t t-if="zone"> <i class="fa fa-map-marker me-1"></i><span t-esc="zone.name"/></t> -->
                                </p>
                            </div>
                        </div>

                        <!-- Provider Info -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="flex-grow-1">
                                        <h4>
                                            <t t-if="provider.image_128">
                                                <img t-att-src="image_data_uri(provider.image_128)" class="img-fluid" style="height: 50px; width: 50px; object-fit: contain;" t-att-alt="provider.name"/>
                                            </t>
                                            <t t-if="not provider.image_128">
                                                <i class="fa fa-building-o text-muted me-2"/>
                                            </t>
                                            <span t-esc="provider.name"/>
                                        </h4>
                                        <p class="text-muted mb-0">
                                            <span class="text-warning"><i class="fa fa-star"></i>
                                                <t t-esc="'%.1f' % provider.logspace_rating if provider.logspace_rating else 'N/A'"/>
                                            </span>
                                            <span class="text-muted">(<span t-esc="provider.logspace_review_count"/> reviews)</span>
                                        </p>
                                    </div>
                                </div>
                                <!-- <p class="text-muted small">
                                    <i class="fa fa-calendar me-1"></i> Member since <span t-esc="provider.create_date.strftime('%B %Y') if provider.create_date else 'N/A'"/>
                                </p> -->
                            </div>
                        </div>

                        <!-- About This Service -->
                        <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-info-circle text-primary me-2"></i>About This Service</h5>
                            </div>
                            <div class="card-body">
                                <p t-esc="vehicle_type.description or 'Professional logistics service.'"/>
                            </div>
                        </div>

                        <!-- Available Timeframes -->
                        <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-clock-o text-primary me-2"></i>Available Timeframes</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <h6 class="text-muted">Pickup</h6>
                                        <div class="d-flex flex-wrap gap-2">
                                            <t t-foreach="timeframes" t-as="tf">
                                                <span class="badge bg-primary" t-esc="tf.name"/>
                                            </t>
                                            <t t-if="not timeframes">
                                                <span class="text-muted">Contact provider for available timeframes</span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                                <hr/>
                                <h6 class="text-muted small mb-2">Estimated Dropoff:</h6>
                                <t t-if="booking_data and booking_data.get('dropoff_timeframe')">
                                    <span class="badge bg-success" t-esc="request.env['logspace.time.slot']._get_labels_by_code().get(booking_data.get('dropoff_timeframe'), booking_data.get('dropoff_timeframe').title())"/>
                                </t>
                                <t t-if="not (booking_data and booking_data.get('dropoff_timeframe'))">
                                    <span class="text-muted small">Will be calculated based on your pickup selection and route distance</span>
                                </t>
                            </div>
                        </div>

                        <!-- Storage Information -->
                        <t t-if="vehicle_type.dimensions or vehicle_type.default_capacity_kg or vehicle_type.default_capacity_cbm">
                            <div class="card mb-4">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0"><i class="fa fa-cube text-primary me-2"></i>Storage Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-center mb-3">
                                        <div class="col-md-4 text-center">
                                            <div class="bg-light rounded p-3">
                                                <t t-if="vehicle_type.dimensions">
                                                    <h4 class="mb-0 text-primary" t-esc="vehicle_type.dimensions"/>
                                                    <small class="text-muted">L x W x H (cm)</small>
                                                </t>
                                                <t t-if="not vehicle_type.dimensions">
                                                    <h4 class="mb-0 text-primary" t-esc="vehicle_type.default_capacity_kg"/>
                                                    <small class="text-muted">Capacity (kg)</small>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <p class="mb-0">
                                                <t t-if="vehicle_type.default_capacity_cbm">
                                                    <strong>Volume:</strong> <span t-esc="vehicle_type.default_capacity_cbm"/> m
                                                    <br/>
                                                </t>
                                                <t t-if="vehicle_type.dimensions and not vehicle_type.default_capacity_kg">
                                                    <strong>Capacity:</strong> <span t-esc="vehicle_type.default_capacity_kg or 'N/A'"/> kg
                                                </t>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Required Documents -->
                        <t t-if="required_documents">
                            <div class="card mb-4">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0"><i class="fa fa-file-text text-primary me-2"></i>Required Documents</h5>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush">
                                        <t t-foreach="required_documents" t-as="doc">
                                            <li class="list-group-item px-0">
                                                <i class="fa fa-check-circle text-success me-2"></i>
                                                <strong t-esc="doc.name"/>
                                                <t t-if="doc.description">
                                                    <br/><small class="text-muted" t-esc="doc.description"/>
                                                </t>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </t>

                        <!-- Contact Info -->
                        <!-- <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa fa-address-card text-primary me-2"></i>Contact Information</h5>
                            </div>
                            <div class="card-body">
                                <p><i class="fa fa-phone me-2 text-primary"></i> <span t-esc="provider.phone or 'Not provided'"/></p>
                                <p class="mb-0"><i class="fa fa-envelope me-2 text-primary"></i> <span t-esc="provider.email or 'Not provided'"/></p>
                            </div>
                        </div> -->

                        <!-- Special Instructions -->
                        <t t-if="special_instruction and special_instruction.instructions">
                            <div class="card mb-4">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0"><i class="fa fa-info-circle text-primary me-2"></i>Special Instructions</h5>
                                </div>
                                <div class="card-body">
                                    <t t-raw="special_instruction.instructions"/>
                                </div>
                            </div>
                        </t>

                        <!-- Available Add-ons -->
                        <t t-if="addons">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0"><i class="fa fa-plus-circle text-primary me-2"></i>Available Add-ons</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <t t-foreach="addons" t-as="addon">
                                            <div class="col-md-6 mb-3">
                                                <div class="d-flex align-items-start">
                                                    <div class="flex-shrink-0">
                                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                            <i class="fa fa-check text-success"></i>
                                                        </div>
                                                    </div>
                                                    <div class="ms-3 flex-grow-1">
                                                        <h6 class="mb-1" t-esc="addon['name']"/>
                                                        <p class="small text-muted mb-1" t-esc="addon['description']"/>
                                                        <span class="text-success fw-bold">+<span t-esc="currency_symbol + ' ' + str(int(addon['price']))"/></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Sidebar - Booking CTA -->
                    <div class="col-lg-4">
                        <div class="card shadow-sm sticky-top" style="top: 20px;">
                            <div class="card-body">
                                <!-- Price -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>Price Estimate</span>
                                        <span class="text-success fs-4">
                                            <t t-if="price"><t t-esc="currency_symbol + ' ' + ('%.2f' % float(price))"/></t>
                                            <t t-else="">Contact for price</t>
                                        </span>
                                    </div>
                                </div>
                                <div class="alert alert-info small mb-3 py-2" t-if="logspace_estimated_time_policy">
                                    <i class="fa fa-info-circle me-1"></i>
                                    <t t-esc="logspace_estimated_time_policy"/>
                                </div>
                                <a t-att-href="booking_url" class="btn btn-primary w-100 btn-lg mb-2">Book Now</a>
                                <div class="small text-muted mt-2" t-if="logspace_cancel_refund_policy">
                                    <t t-foreach="logspace_cancel_refund_policy.split('\n')" t-as="policy_line">
                                        <p class="mb-1" t-esc="policy_line"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
