#. module: appness_logspace
#: model:mail.template,body_html:appness_logspace.email_template_guest_payment_recovery
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #1a237e; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>Almost done!</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>Dear <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                    <p>Your Logspace booking <strong t-out=\"object.name or ''\"/> has been reserved. It is <strong>not confirmed yet</strong> — please complete the payment to confirm it.</p>\n"
"                    <p>If you already paid, you can ignore this email or use the button below to check the status.</p>\n"
"\n"
"                    <div style=\"background: white; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h3 style=\"color: #1a237e; margin-top: 0;\">Booking Details</h3>\n"
"                        <table style=\"width: 100%;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Order Number:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.name or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Provider:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\">\n"
"                                    <t t-if=\"object.logspace_provider_id\" t-out=\"object.logspace_provider_id.name\"/>\n"
"                                    <t t-else=\"\">TBD</t>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Scheduled Date:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.scheduled_date or ''\">To be confirmed</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Pickup:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.pickup_address or ''\">Not set</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Dropoff:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.dropoff_address or ''\">Not set</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Total:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.currency_id.format(object.amount_total) or ''\"/>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <p style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a t-attf-href=\"/logspace/booking/payment/{{ object.id }}?access_token={{ object.access_token }}\" style=\"background: #2e7d32; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">Complete Payment</a>\n"
"                    </p>\n"
"\n"
"                    <p style=\"color: #666; font-size: 12px; margin-top: 30px;\">\n"
"                        This link is personal to this booking. Need help? Contact us at support@logspace.com\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""

#. module: appness_logspace
#: model:mail.template,body_html:appness_logspace.email_template_provider_application_received
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #1a237e; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>Application Received</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"                    <p>Thank you for submitting your provider application to Logspace.</p>\n"
"\n"
"                    <div style=\"background: #fff3cd; padding: 15px; border-radius: 5px; margin: 20px 0; border: 1px solid #ffc107;\">\n"
"                        <h4 style=\"color: #856404; margin-top: 0;\">Status: Pending Review</h4>\n"
"                        <p style=\"color: #856404;\">Our team is reviewing your application. This typically takes 1-2 business days.</p>\n"
"                    </div>\n"
"\n"
"                    <p>We will notify you via email once your application has been reviewed.</p>\n"
"\n"
"                    <p style=\"color: #666; margin-top: 30px; font-size: 12px;\">\n"
"                        If you have any questions, please contact us at support@logspace.com\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""

#. module: appness_logspace
#: model:mail.template,body_html:appness_logspace.email_template_logspace_status_driver
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #1a237e; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>Delivery Status Update</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>Dear <t t-out=\"object.logspace_driver_id.name or ''\"/>,</p>\n"
"                    <p>Delivery <strong t-out=\"object.name or ''\"/> status has been updated to:</p>\n"
"                    <p style=\"text-align: center; font-size: 20px; font-weight: bold; color: #1a237e; background: #e8eaf6; padding: 12px; border-radius: 5px;\" t-out=\"object.logspace_state_label or ''\"/>\n"
"\n"
"                    <div style=\"background: white; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h3 style=\"color: #1a237e; margin-top: 0;\">Delivery Details</h3>\n"
"                        <table style=\"width: 100%;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Pickup Address:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.pickup_address or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Drop-off Address:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.dropoff_address or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Scheduled:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.scheduled_date or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Vehicle:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\">\n"
"                                    <t t-if=\"object.logspace_vehicle_id\">\n"
"                                        <t t-out=\"object.logspace_vehicle_id.vehicle_type_id.name or ''\"/>\n"
"                                        <t t-if=\"object.logspace_vehicle_id.plate_number\">\n"
"                                            (<t t-out=\"object.logspace_vehicle_id.plate_number\"/>)\n"
"                                        </t>\n"
"                                    </t>\n"
"                                    <t t-else=\"\">Not assigned</t>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div style=\"background: #fff8e1; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h4 style=\"color: #e65100; margin-top: 0;\">Verification Codes</h4>\n"
"                        <p style=\"color: #666; font-size: 13px; margin-bottom: 0;\">\n"
"                            Ask the customer for the pickup code when you collect the items, and for the\n"
"                            drop-off code when you deliver them. You will be prompted to enter each code\n"
"                            from your delivery page.\n"
"                        </p>\n"
"                    </div>\n"
"\n"
"                    <p style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a t-attf-href=\"/logspace/driver/orders/track/{{ object.name }}\" style=\"background: #1a237e; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">Open My Delivery</a>\n"
"                    </p>\n"
"\n"
"                    <p style=\"color: #666; font-size: 12px; margin-top: 30px;\">\n"
"                        This is an automated message - please do not reply.\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""

#. module: appness_logspace
#: model:mail.template,body_html:appness_logspace.email_template_driver_assigned
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #1a237e; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>Driver Assigned</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>Dear <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                    <p>A driver has been assigned to your booking <strong t-out=\"object.name or ''\"/>.</p>\n"
"\n"
"                    <div style=\"background: white; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h3 style=\"color: #1a237e; margin-top: 0;\">Driver Information</h3>\n"
"                        <table style=\"width: 100%;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Driver Name:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\">\n"
"                                    <t t-if=\"object.logspace_driver_id\" t-out=\"object.logspace_driver_id.name\"/>\n"
"                                    <t t-else=\"\">TBD</t>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Driver Phone:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.driver_phone or ''\">Will be provided shortly</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Vehicle:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\">\n"
"                                    <t t-if=\"object.logspace_vehicle_id and object.logspace_vehicle_id.vehicle_type_id\" t-out=\"object.logspace_vehicle_id.vehicle_type_id.name\"/>\n"
"                                    <t t-else=\"\">TBD</t>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div style=\"background: #e8f5e9; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h4 style=\"color: #2e7d32; margin-top: 0;\">Pickup Verification Code</h4>\n"
"                        <p style=\"font-size: 32px; font-weight: bold; color: #1a237e; margin: 10px 0; text-align: center; letter-spacing: 5px;\" t-out=\"object.verification_code_pickup or ''\">\n"
"                        </p>\n"
"                        <p style=\"color: #666; font-size: 12px; text-align: center;\">Show this code to the driver at pickup</p>\n"
"                    </div>\n"
"\n"
"                    <p style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a t-attf-href=\"/logspace/my/orders/track/{{ object.name }}?access_token={{ object.access_token }}\" style=\"background: #1a237e; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">Track Your Order</a>\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""

