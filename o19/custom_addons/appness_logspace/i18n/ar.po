"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Scheduled Date:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.scheduled_date or ''\">To be confirmed</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Pickup:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.pickup_address or ''\">Not set</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Dropoff:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.dropoff_address or ''\">Not set</td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div t-if=\"object.verification_code_pickup\" style=\"background: #e8f5e9; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h4 style=\"color: #2e7d32; margin-top: 0;\">Pickup Verification Code</h4>\n"
"                        <p style=\"font-size: 32px; font-weight: bold; color: #1a237e; margin: 10px 0; text-align: center; letter-spacing: 5px;\" t-out=\"object.verification_code_pickup\"/>\n"
"                        <p style=\"color: #666; font-size: 12px; text-align: center;\">Give this code to the driver at pickup - keep it private.</p>\n"
"                    </div>\n"
"\n"
"                    <div t-if=\"object.verification_code_dropoff\" style=\"background: #fff8e1; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h4 style=\"color: #e65100; margin-top: 0;\">Drop-off Verification Code</h4>\n"
"                        <p style=\"font-size: 32px; font-weight: bold; color: #1a237e; margin: 10px 0; text-align: center; letter-spacing: 5px;\" t-out=\"object.verification_code_dropoff\"/>\n"
"                        <p style=\"color: #666; font-size: 12px; text-align: center;\">Give this code to the driver at drop-off - keep it private.</p>\n"
"                    </div>\n"
"\n"
"                    <p style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a t-attf-href=\"/logspace/my/orders/track/{{ object.name }}?access_token={{ object.access_token }}\" style=\"background: #1a237e; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">Track Your Order</a>\n"
"                    </p>\n"
"\n"
"                    <p style=\"color: #666; font-size: 12px; margin-top: 30px;\">\n"
"                        This is an automated message - please do not reply.\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #1a237e; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>تحديث حالة الطلب</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>عزيزي <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                    <p>حالة حجزك لدى Logspace <strong t-out=\"object.name or ''\"/> تم تحديثها إلى:</p>\n"
"                    <p style=\"text-align: center; font-size: 20px; font-weight: bold; color: #1a237e; background: #e8eaf6; padding: 12px; border-radius: 5px;\" t-out=\"object.logspace_state_label or ''\"/>\n"
"\n"
"                    <div style=\"background: white; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h3 style=\"color: #1a237e; margin-top: 0;\">تفاصيل الحجز</h3>\n"
"                        <table style=\"width: 100%;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>رقم الطلب:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.name or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>مقدم الخدمة:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\">\n"
"                                    <t t-if=\"object.logspace_provider_id\" t-out=\"object.logspace_provider_id.name\"/>\n"
"                                    <t t-else=\"\">يُحدد لاحقًا</t>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>الموعد المقرر:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.scheduled_date or ''\">بانتظار التأكيد</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>الاستلام:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.pickup_address or ''\">غير محدد</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>التسليم:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.dropoff_address or ''\">غير محدد</td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div t-if=\"object.verification_code_pickup\" style=\"background: #e8f5e9; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h4 style=\"color: #2e7d32; margin-top: 0;\">رمز التحقق من الاستلام</h4>\n"
"                        <p style=\"font-size: 32px; font-weight: bold; color: #1a237e; margin: 10px 0; text-align: center; letter-spacing: 5px;\" t-out=\"object.verification_code_pickup\"/>\n"
"                        <p style=\"color: #666; font-size: 12px; text-align: center;\">أعطِ هذا الرمز للسائق عند الاستلام، وحافظ على سريته.</p>\n"
"                    </div>\n"
"\n"
"                    <div t-if=\"object.verification_code_dropoff\" style=\"background: #fff8e1; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h4 style=\"color: #e65100; margin-top: 0;\">رمز التحقق من التسليم</h4>\n"
"                        <p style=\"font-size: 32px; font-weight: bold; color: #1a237e; margin: 10px 0; text-align: center; letter-spacing: 5px;\" t-out=\"object.verification_code_dropoff\"/>\n"
"                        <p style=\"color: #666; font-size: 12px; text-align: center;\">أعطِ هذا الرمز للسائق عند التسليم، وحافظ على سريته.</p>\n"
"                    </div>\n"
"\n"
"                    <p style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a t-attf-href=\"/logspace/my/orders/track/{{ object.name }}?access_token={{ object.access_token }}\" style=\"background: #1a237e; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">تتبع طلبك</a>\n"
"                    </p>\n"
"\n"
"                    <p style=\"color: #666; font-size: 12px; margin-top: 30px;\">\n"
"                        هذه رسالة آلية، يرجى عدم الرد عليها.\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "

#. module: appness_logspace
#: model:mail.template,body_html:appness_logspace.email_template_provider_approved
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #1a237e; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>Welcome to Logspace!</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"                    <p>Congratulations! Your provider application has been <strong style=\"color: #2e7d32;\">approved</strong>.</p>\n"
"\n"
"                    <div style=\"background: white; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h3 style=\"color: #1a237e; margin-top: 0;\">Your Account Details</h3>\n"
"                        <table style=\"width: 100%;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Business Name:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.name or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Approval Date:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.approval_date or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Login Email:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.email or ''\"/>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div style=\"background: #fff3cd; padding: 15px; border-radius: 5px; margin: 20px 0; border: 1px solid #ffc107;\">\n"
"                        <h4 style=\"color: #856404; margin-top: 0;\">Set Your Password</h4>\n"
"                        <p style=\"color: #856404;\">A separate email has been sent with instructions to set your portal password. Please check your inbox.</p>\n"
"                    </div>\n"
"\n"
"                    <p style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a href=\"/my\" style=\"background: #1a237e; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">Access Your Portal</a>\n"
"                    </p>\n"
"\n"
"                    <p style=\"color: #666; margin-top: 30px;\">\n"
"                        Next steps:\n"
"                        </p><ul>\n"
"                            <li>Set up your password</li>\n"
"                            <li>Complete your profile</li>\n"
"                            <li>Add vehicles to your fleet</li>\n"
"                            <li>Configure your pricing</li>\n"
"                        </ul>\n"
"                    \n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #1a237e; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>مرحبًا بك في Logspace!</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>عزيزي <t t-out=\"object.name or ''\"/>,</p>\n"
"                    <p>تهانينا! تم <strong style=\"color: #2e7d32;\">قبول طلب انضمامك كمقدم خدمة</strong>.</p>\n"
"\n"
"                    <div style=\"background: white; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h3 style=\"color: #1a237e; margin-top: 0;\">تفاصيل حسابك</h3>\n"
"                        <table style=\"width: 100%;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>اسم المنشأة:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.name or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>تاريخ الموافقة:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.approval_date or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>بريد تسجيل الدخول:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.email or ''\"/>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div style=\"background: #fff3cd; padding: 15px; border-radius: 5px; margin: 20px 0; border: 1px solid #ffc107;\">\n"
"                        <h4 style=\"color: #856404; margin-top: 0;\">تعيين كلمة المرور</h4>\n"
"                        <p style=\"color: #856404;\">أُرسلت رسالة منفصلة تتضمن تعليمات تعيين كلمة مرور بوابتك. يرجى التحقق من بريدك الوارد.</p>\n"
"                    </div>\n"
"\n"
"                    <p style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a href=\"/my\" style=\"background: #1a237e; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">الدخول إلى بوابتك</a>\n"
"                    </p>\n"
"\n"
"                    <p style=\"color: #666; margin-top: 30px;\">\n"
"                        الخطوات التالية:\n"
"                        </p><ul>\n"
"                            <li>تعيين كلمة المرور</li>\n"
"                            <li>إكمال ملفك</li>\n"
"                            <li>إضافة مركبات إلى أسطولك</li>\n"
"                            <li>إعداد أسعارك</li>\n"
"                        </ul>\n"
"                    \n"
"                </div>\n"
"            </div>\n"
"        "

#. module: appness_logspace
#: model:mail.template,body_html:appness_logspace.email_template_order_delivered
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #2e7d32; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>Delivery Complete!</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>Dear <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                    <p>Your delivery has been completed successfully!</p>\n"
"\n"
"                    <div style=\"background: white; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h3 style=\"color: #1a237e; margin-top: 0;\">Delivery Summary</h3>\n"
"                        <table style=\"width: 100%;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Order Number:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.name or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Provider:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.logspace_provider_id.name or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>Delivered On:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.delivery_date or ''\"/>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div style=\"background: #e8f5e9; padding: 15px; border-radius: 5px; margin: 20px 0; text-align: center;\">\n"
"                        <h4 style=\"color: #2e7d32; margin-top: 0;\">How was your experience?</h4>\n"
"                        <p>We'd love to hear your feedback!</p>\n"
"                        <p style=\"text-align: center; margin: 20px 0;\">\n"
"                            <a t-attf-href=\"/logspace/my/orders/{{ object.name }}/rate\" style=\"background: #2e7d32; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">Rate Your Driver</a>\n"
"                        </p>\n"
"                    </div>\n"
"\n"
"                    <p style=\"color: #666; margin-top: 30px; font-size: 12px;\">\n"
"                        Thank you for choosing Logspace!\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #2e7d32; color: white; padding: 20px; text-align: center;\">\n"
"                    <h2>اكتمل التوصيل!</h2>\n"
"                </div>\n"
"                <div style=\"padding: 20px; background: #f9f9f9;\">\n"
"                    <p>عزيزي <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                    <p>تم توصيل طلبك بنجاح!</p>\n"
"\n"
"                    <div style=\"background: white; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n"
"                        <h3 style=\"color: #1a237e; margin-top: 0;\">ملخص التوصيل</h3>\n"
"                        <table style=\"width: 100%;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>رقم الطلب:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.name or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>مقدم الخدمة:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.logspace_provider_id.name or ''\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 0;\"><strong>تاريخ التسليم:</strong></td>\n"
"                                <td style=\"padding: 5px 0;\" t-out=\"object.delivery_date or ''\"/>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div style=\"background: #e8f5e9; padding: 15px; border-radius: 5px; margin: 20px 0; text-align: center;\">\n"
"                        <h4 style=\"color: #2e7d32; margin-top: 0;\">كيف كانت تجربتك؟</h4>\n"
"                        <p>يسعدنا سماع رأيك!</p>\n"
"                        <p style=\"text-align: center; margin: 20px 0;\">\n"
"                            <a t-attf-href=\"/logspace/my/orders/{{ object.name }}/rate\" style=\"background: #2e7d32; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">قيّم السائق</a>\n"
"                        </p>\n"
"                    </div>\n"
"\n"
"                    <p style=\"color: #666; margin-top: 30px; font-size: 12px;\">\n"
"                        شكرًا لاختيارك Logspace!\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "

