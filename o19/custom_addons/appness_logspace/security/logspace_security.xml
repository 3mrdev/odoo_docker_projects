<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Logspace Security Rules
        =======================
        This file contains record rules for access control:
        - Portal users see only their own data
        - Public users see approved providers only
        - Customers see their own orders, tickets, refunds
    -->

    <!-- ============================================================================
         LOGSPACE.ZONE - Portal/Public read access for zone data shown in portal
         ============================================================================ -->
    <record id="rule_logspace_zone_portal" model="ir.rule">
        <field name="name">Zones - Portal Read</field>
        <field name="model_id" ref="model_logspace_zone"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="rule_logspace_zone_public" model="ir.rule">
        <field name="name">Zones - Public Read</field>
        <field name="model_id" ref="model_logspace_zone"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <!-- ============================================================================
         LOGSPACE.VEHICLE.TYPE - Portal/Public read access
         ============================================================================ -->
