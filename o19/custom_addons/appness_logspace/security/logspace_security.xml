<!-- ============================================================================
         RES.PARTNER - Provider sees only their own partner record (not suspended)
         ============================================================================ -->
    <record id="rule_res_partner_provider_own" model="ir.rule">
        <field name="name">Providers - Own Record Only</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[
            '|',
                ('parent_id', '=', user.partner_id.id),
                '&amp;',
                    ('id', '=', user.partner_id.id),
                    ('state', '!=', 'suspended'),
        ]</field>
        <field name="groups" eval="[(4, ref('group_logspace_provider'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="rule_res_partner_provider_all" model="ir.rule">
        <field name="name">Providers - See All</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_logspace_admin'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">False</field>
    </record>

