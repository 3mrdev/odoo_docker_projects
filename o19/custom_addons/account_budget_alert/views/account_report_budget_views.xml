<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="account_report_budget_form_inherit_budget_alert" model="ir.ui.view">
        <field name="name">account.report.budget.form.inherit.budget.alert</field>
        <field name="model">account.report.budget</field>
        <field name="inherit_id" ref="account_reports.account_report_budget_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-3" role="alert">
                    <i class="fa fa-warning" title="Warning"/>
                    <b>If the budget alert type is 'Block' or 'Warning':</b> The user will be blocked or warned from posting the transaction for all the budget lines.
                    <b>If the budget alert type is 'None':</b> You can define the alert type for each budget line separately.
                </div>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group>
                    <group>
                        <field name="budget_alert_type" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='item_ids']/list" position="replace">
                <list editable="bottom">
                    <field name="account_id" />
                    <field name="date" string="Months" options="{'min_precision': 'months'}" />
                    <field name="budget_alert_type" />
                    <field name="amount" />
                </list>
            </xpath>
        </field>
    </record>

    <!-- account.report.budget.item form view -->
    <record id="view_account_report_budget_item_form" model="ir.ui.view">
        <field name="name">account.report.budget.item.form.view</field>
        <field name="model">account.report.budget.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id" />
                            <field name="date" string="Months" options="{'min_precision': 'months'}" />
                            <field name="budget_alert_type" />
                            <field name="amount" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

</odoo>