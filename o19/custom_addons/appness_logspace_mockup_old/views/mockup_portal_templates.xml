<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Base Portal Layout Mockup -->
    <template id="mockup_portal_layout" name="Mockup Portal Layout">
        <t t-call="appness_logspace_mockup.mockup_layout">
            <div class="container mt-4 mb-5">
                <div class="row">
                    <!-- Sidebar -->
                    <div class="col-md-3 mb-4">
                        <div class="list-group shadow-sm">
                            <a href="/mockup/my/profile" class="list-group-item list-group-item-action d-flex align-items-center">
                                <i class="fa fa-user me-3 text-primary"></i> My Profile
                            </a>
                            <a href="/mockup/my/orders" class="list-group-item list-group-item-action d-flex align-items-center">
                                <i class="fa fa-box me-3 text-primary"></i> My Orders
                            </a>
                            <a href="/mockup/my/notifications" class="list-group-item list-group-item-action d-flex align-items-center">
                                <i class="fa fa-bell me-3 text-primary"></i> Notifications
                            </a>
                            <a href="/mockup/ticket" class="list-group-item list-group-item-action d-flex align-items-center">
                                <i class="fa fa-life-ring me-3 text-primary"></i> Get Help
                            </a>
                            <a href="/mockup/login" class="list-group-item list-group-item-action text-danger d-flex align-items-center">
                                <i class="fa fa-sign-out me-3"></i> Logout
                            </a>
                        </div>
                    </div>
                    <!-- Main Content Area -->
                    <div class="col-md-9">
                        <t t-out="0"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 11: Profile -->
    <template id="mockup_profile_page" name="Profile">
        <t t-call="appness_logspace_mockup.mockup_portal_layout">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="mb-4 text-primary">My Profile</h4>
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white me-4" style="width: 100px; height: 100px;">
                            <i class="fa fa-user fa-3x"></i>
                        </div>
                        <div>
                            <h5>John Doe</h5>
                            <p class="text-muted mb-0">+966 50 000 0000</p>
                        </div>
                    </div>
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name</label>
                                <input type="text" class="form-control" value="John"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name</label>
                                <input type="text" class="form-control" value="Doe"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="john@example.com"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone</label>
                                <input type="text" class="form-control" value="+966 50 000 0000"/>
                            </div>
                        </div>
                        <button type="button" class="btn btn-primary mt-4">Save Changes</button>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 12: Orders -->
    <template id="mockup_orders_page" name="My Orders">
        <t t-call="appness_logspace_mockup.mockup_portal_layout">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="mb-4 text-primary">My Orders</h4>
                    <ul class="nav nav-tabs mb-4">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">Active</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Completed</a>
                        </li>
                    </ul>
                    <t t-foreach="orders" t-as="order">
                        <div class="border rounded p-3 mb-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1"><a t-attf-href="/mockup/my/orders/track" class="text-decoration-none text-primary"><t t-out="order['id']"/></a></h6>
                                <p class="text-muted small mb-0"><i class="fa fa-calendar me-1"></i> <t t-out="order['date']"/></p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success mb-1"><t t-out="order['status']"/></span>
                                <h6 class="mb-0"><t t-out="order['total']"/></h6>
                            </div>
                        </div>
                    </t>
                    <a href="/mockup/search" class="btn btn-outline-primary mt-3">Book New Order</a>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 13: Track Order -->
    <template id="mockup_track_page" name="Track Order">
        <t t-call="appness_logspace_mockup.mockup_portal_layout">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="text-primary mb-0">Order #ORD-100234</h4>
                        <span class="badge bg-primary fs-6">In Transit</span>
                    </div>
                    
                    <!-- Dummy Map Area -->
                    <div class="bg-light rounded d-flex align-items-center justify-content-center mb-4" style="height: 250px;">
                        <span class="text-muted"><i class="fa fa-map-marker fa-2x me-2"></i>Live Tracking Map Simulation</span>
                    </div>
                    
                    <h5 class="mb-3">Status Timeline</h5>
                    <div class="position-relative border-start border-primary border-2 ms-3 pb-3">
                        <div class="position-absolute bg-primary rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 0;"></div>
                        <div class="ms-4">
                            <h6 class="mb-0">Driver Assigned</h6>
                            <p class="text-muted small">Oct 1, 10:00 AM</p>
                        </div>
                        
                        <div class="position-absolute bg-primary rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 70px;"></div>
                        <div class="ms-4 mt-4">
                            <h6 class="mb-0">Out for Pickup</h6>
                            <p class="text-muted small">Oct 1, 10:30 AM</p>
                        </div>

                        <div class="position-absolute bg-white border border-primary border-2 rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 140px;"></div>
                        <div class="ms-4 mt-4">
                            <h6 class="mb-0">In Transit</h6>
                            <p class="text-muted small">Pending...</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <a href="/mockup/rate" class="btn btn-outline-warning w-100"><i class="fa fa-star me-2"></i>Rate Driver</a>
                </div>
                <div class="col-md-6">
                    <a href="/mockup/refund" class="btn btn-outline-danger w-100"><i class="fa fa-undo me-2"></i>Request Refund</a>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 14: Notifications -->
    <template id="mockup_notifications_page" name="Notifications">
        <t t-call="appness_logspace_mockup.mockup_portal_layout">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="mb-4 text-primary">Notifications</h4>
                    <div class="list-group list-group-flush">
                        <div class="list-group-item py-3 px-0 border-bottom">
                            <div class="d-flex w-100 justify-content-between mb-1">
                                <h6 class="mb-0 fw-bold">Driver Arrived</h6>
                                <small class="text-primary">10 mins ago</small>
                            </div>
                            <p class="mb-0 text-muted">Your driver has arrived at the pickup location.</p>
                        </div>
                        <div class="list-group-item py-3 px-0 border-bottom">
                            <div class="d-flex w-100 justify-content-between mb-1">
                                <h6 class="mb-0 fw-bold">Payment Successful</h6>
                                <small class="text-muted">1 hour ago</small>
                            </div>
                            <p class="mb-0 text-muted">Your payment of $150 was successful.</p>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 15: Rating -->
    <template id="mockup_rate_page" name="Rate Driver">
        <t t-call="appness_logspace_mockup.mockup_layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 text-center p-4">
                            <div class="card-body">
                                <h4>Rate Your Experience</h4>
                                <div class="my-4 text-warning" style="font-size: 2rem;">
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star-o"></i>
                                </div>
                                <textarea class="form-control mb-4" rows="4" placeholder="Leave a comment..."></textarea>
                                <a href="/mockup/my/orders" class="btn btn-primary w-100">Submit Rating</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 16: Refund -->
    <template id="mockup_refund_page" name="Refund">
        <t t-call="appness_logspace_mockup.mockup_layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 p-4">
                            <div class="card-body">
                                <h4 class="text-danger mb-4">Request Refund</h4>
                                <form action="/mockup/my/orders" method="GET">
                                    <div class="mb-3">
                                        <label class="form-label">Order Reference</label>
                                        <input type="text" class="form-control" value="ORD-100234" readonly="1"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Reason for Refund</label>
                                        <select class="form-select">
                                            <option>Driver did not show up</option>
                                            <option>Items damaged</option>
                                            <option>Other</option>
                                        </select>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Additional Details</label>
                                        <textarea class="form-control" rows="4"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-danger w-100">Submit Request</button>
                                    <a href="/mockup/my/orders/track" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Screen 17: Ticket -->
    <template id="mockup_ticket_page" name="Helpdesk Ticket">
        <t t-call="appness_logspace_mockup.mockup_portal_layout">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="mb-4 text-primary">Submit a Ticket</h4>
                    <form action="/mockup/my/profile" method="GET">
                        <div class="mb-3">
                            <label class="form-label">Subject</label>
                            <input type="text" class="form-control" placeholder="Briefly describe your issue"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="5" placeholder="Provide more details here..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Submit Ticket</button>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>
