<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mockup_vendor_page" name="Vendor Details">
        <t t-call="appness_logspace_mockup.mockup_layout">
            <div class="container mt-5">
                <div class="row">
                    <!-- Vendor Info -->
                    <div class="col-md-8">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px;">
                                        <i class="fa fa-building fa-2x"></i>
                                    </div>
                                    <div>
                                        <h2 class="text-primary mb-0"><t t-out="vendor['name']"/></h2>
                                        <span class="text-warning"><i class="fa fa-star"></i> <t t-out="vendor['rating']"/></span>
                                    </div>
                                </div>
                                <p class="text-muted"><t t-out="vendor['description']"/></p>
                                <hr/>
                                <h5>Service Pictures</h5>
                                <div class="row">
                                    <div class="col-4">
                                        <div class="bg-secondary rounded text-white d-flex align-items-center justify-content-center" style="height: 100px;">
                                            <i class="fa fa-image fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Booking Actions -->
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0">
                            <div class="card-body text-center">
                                <h4 class="text-success mb-3">Starting at $150</h4>
                                <a href="/mockup/addons" class="btn btn-primary btn-lg w-100 mb-2">Book Now</a>
                                <a href="/mockup/search" class="btn btn-outline-secondary w-100">Back to Search</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
