<odoo>
    <data noupdate="0">

        <record id="purchase.group_purchase_user" model="res.groups">
            <field name="name">User: Own Documents Only</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        </record>

        <record id="purchase_own.group_purchase_all" model="res.groups">
            <field name="name">User: All Documents</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <record id="purchase.group_purchase_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
            <field name="implied_ids" eval="[(6,0,[ref('purchase_own.group_purchase_all')])]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="purchase_own_purchase_order_rule" model="ir.rule">
            <field name="name">User Own Purchase Orders</field>
            <field ref="purchase.model_purchase_order" name="model_id"/>
            <field name="domain_force">['|',('user_id','=',user.id),('user_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <record id="purchase_order_see_all" model="ir.rule">
            <field name="name">User All Purchase Orders</field>
            <field ref="purchase.model_purchase_order" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('purchase_own.group_purchase_all'))]"/>
        </record>
        
    </data>
</odoo>