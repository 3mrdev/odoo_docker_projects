<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="hrb_property_category" model="ir.module.category">
            <field name="name">HRB Property</field>
            <field name="description">HRB Property</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_hrb_property">
            <field name="name">HRB Property</field>
            <field name="sequence">9</field>
            <field name="category_id" ref="hrb_property_category" />
        </record>

        <record id="group_hrb_property_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_hrb_property" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="group_hrb_property_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_hrb_property" />
            <field name="implied_ids"
                eval="[(4, ref('sale_subscription_property.group_hrb_property_user'))]" />
        </record>

        <record id="property_multi_company_rule" model="ir.rule">
            <field name="name">Property Multi Company</field>
            <field name="model_id" ref="model_hrb_property"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="property_unit_multi_company_rule" model="ir.rule">
            <field name="name">Property Unit Multi Company</field>
            <field name="model_id" ref="model_hrb_property_unit"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

    </data>
</odoo>