<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hrb_property_type_view_form" model="ir.ui.view">
            <field name="name">hrb.property.type.view.form</field>
            <field name="model">hrb.property.type</field>
            <field name="arch" type="xml">
                <form string="Property Type">
                    <sheet>
                        <group>
                            <field name="name" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hrb_property_type_view_list" model="ir.ui.view">
            <field name="name">hrb.property.type.view.list</field>
            <field name="model">hrb.property.type</field>
            <field name="arch" type="xml">
                <list string="Property Types">
                    <field name="name" />
                </list>
            </field>
        </record>

        <record id="hrb_property_type_action" model="ir.actions.act_window">
            <field name="name">Property Types</field>
            <field name="res_model">hrb.property.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="hrb_property_type_menu" name="Property Types"
            parent="sale_subscription_property.hrb_property_configuration_menu"
            action="hrb_property_type_action" sequence="10" />
    </data>
</odoo>