<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hrb_property_view_kanban" model="ir.ui.view">
            <field name="name">hrb.property.kanban</field>
            <field name="model">hrb.property</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard o_waqf_kanban" default_group_by="status"
                    groups_draggable="0" records_draggable="0">
                    <field name="id" />
                    <field name="name" />
                    <field name="sequence_number" />
                    <field name="unit_count" />
                    <field name="free_unit_count" />
                    <field name="rented_unit_count" />
                    <field name="maintenance_unit_count" />
                    <templates>
                        <t t-name="card" class="flex-row">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary">
                                            <span><t t-esc="record.sequence_number.value" /> - <t
                                                    t-esc="record.name.value" /></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="container o_kanban_card_content mt-4">
                                    <div class="row">
                                        <div class="col-6 o_kanban_primary_left">
                                            <button class="btn btn-primary" name="action_view_units"
                                                type="object">
                                                <t t-esc="record.unit_count.value" /> Units </button>
                                        </div>
                                        <div class="col-6 o_kanban_primary_right">
                                            <div class="row">
                                                <div class="col-12">
                                                    <span class="text-success fw-bold"><i
                                                            class="fa fa-check-circle-o" /> Free: <t
                                                            t-esc="record.free_unit_count.value" /></span>
                                                </div>
                                                <div class="col-12">
                                                    <span class="text-warning fw-bold"><i
                                                            class="fa fa-clock-o" /> Rented: <t
                                                            t-esc="record.rented_unit_count.value" /></span>
                                                </div>
                                                <div class="col-12">
                                                    <span class="text-danger fw-bold"><i
                                                            class="fa fa-wrench" /> Maintenance: <t
                                                            t-esc="record.maintenance_unit_count.value" /></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="hrb_property_view_form" model="ir.ui.view">
            <field name="name">hrb.property.view.form</field>
            <field name="model">hrb.property</field>
            <field name="arch" type="xml">
                <form string="Property">
                    <header invisible="not show_properties_features">
                        <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="status != 'draft'" />
                        <button name="action_hold" string="Hold" type="object"
                            invisible="status not in ['in_progress', 'sold']" />
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="status not in ['on_hold', 'sold']" />
                        <button
                            name="%(sale_subscription_property.hrb_property_generate_units_wizard_action)d"
                            string="Generate Units" type="action" class="oe_highlight"
                            context="{'default_property_id': id}"
                            invisible="status in ['on_hold', 'sold']" />
                        <field name="status" widget="statusbar"
                            statusbar_visible="draft,in_progress,sold" />
                    </header>
                    <div class="alert alert-info" role="alert" invisible="show_properties_features">
                        The property feature is not activated in this company. if you wish to use it please tell your admin to activiate it in this company.
                    </div>
                    <sheet>
                        <div class="oe_button_box" name="button_box" invisible="not show_properties_features">
                            <button name="action_view_units" type="object" class="oe_stat_button"
                                icon="fa-building-o" invisible="unit_count == 0">
                                <field name="unit_count" widget="statinfo" string="Units" />
                            </button>
                            <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="invoices_count == 0">
                                <field name="invoices_count" widget="statinfo" string="Invoices" />
                            </button>
                            <button name="action_view_subscriptions" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="subscriptions_count == 0">
                                <field name="subscriptions_count" widget="statinfo"
                                    string="Subscriptions" />
                            </button>
                        </div>
                        <group invisible="not show_properties_features">
                            <field name="sequence_number" readonly="1" />
                        </group>
                        <div class="oe_title" invisible="not show_properties_features">
                            <h1>
                                <field name="name" placeholder="Property Name..."
                                    readonly="status != 'draft'" />
                            </h1>
                        </div>
                        <group invisible="not show_properties_features">
                            <group>
                                <field name="responsible_id" readonly="0"
                                    groups="sale_subscription_property.group_hrb_property_admin" />
                                <field name="responsible_id" readonly="status != 'draft'"
                                    groups="!sale_subscription_property.group_hrb_property_admin" />
                                <field name="land_number" readonly="status != 'draft'" required="1" />
                                <field name="property_type_id" readonly="status != 'draft'"
                                    required="1" />
                                <field name="tag_ids" widget="many2many_tags"
                                    options="{'color_field': 'color', 'no_create_edit': True}" />
                            </group>
                            <group>
                                <field name="create_date" string="Create Date" readonly="1" />
                                <field name="date"
                                    groups="sale_subscription_property.group_hrb_property_admin" />
                                <field name="date" readonly="1"
                                    groups="!sale_subscription_property.group_hrb_property_admin" />
                                <field name="analytic_account_id"
                                    groups="analytic.group_analytic_accounting"
                                    readonly="status != 'draft'" />
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook invisible="not show_properties_features">
                            <page string="Units" name="units">
                                <field name="unit_ids" readonly="status != 'draft'">
                                    <list>
                                        <field name="name" />
                                        <field name="product_id" string="Unit Type" />
                                        <field name="tenant_id" />
                                        <field name="price" sum="Total" />
                                        <field name="status" />
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right" colspan="2"
                                    name="rent_total">
                                    <div class="d-flex">
                                        <label for="units_total_rent" class="me-auto" />
                                        <span class="h2">
                                            <field name="units_total_rent" widget="float"
                                                class="oe_inline" />
                                            <!-- <span class="oe_grey p-2"> %</span> -->
                                        </span>
                                    </div>
                                </group>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" readonly="status != 'draft'" />
                            </page>
                            <page string="Location" name="location">
                                <group>
                                    <group>
                                        <span class="o_form_label o_td_label o_address_type"
                                            name="address_name">
                                            <span>Address</span>
                                        </span>
                                        <div class="o_address_format" readonly="1">
                                            <field name="country_enforce_cities" invisible="1" />
                                            <field name="street" placeholder="Street..."
                                                class="o_address_street" />
                                            <field name="street2" placeholder="Street 2..."
                                                class="o_address_street" />
                                            <field name="zip" placeholder="ZIP"
                                                class="o_address_zip" />
                                            <field name="area_id"
                                                domain="[('city_id', '=', city_id)]" />
                                            <field name="city_id" placeholder="City"
                                                class="o_address_city"
                                                domain="[('state_id', '=?', state_id)]"
                                                context="{'default_state_id': state_id, 'default_country_id': country_id}"
                                                invisible="not country_enforce_cities" />
                                            <field name="city" placeholder="City"
                                                class="o_address_city"
                                                invisible="country_enforce_cities and (city_id or city in ('', False))" />
                                            <field name="state_id" class="o_address_state"
                                                placeholder="State" options='{"no_open": True}' />
                                            <field name="country_id" placeholder="Country"
                                                class="o_address_country"
                                                options='{"no_open": True, "no_create": True}' />
                                        </div>
                                    </group>
                                    <group>
                                        <field name="address_location_details_link" widget="url"
                                            readonly="status != 'draft'" />
                                        <field name="address_location_details_id"
                                            readonly="status != 'draft'" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter invisible="not show_properties_features">
                        <thread_view />
                        <activities />
                    </chatter>
                </form>
            </field>
        </record>

        <record id="hrb_property_view_list" model="ir.ui.view">
            <field name="name">hrb.property.view.list</field>
            <field name="model">hrb.property</field>
            <field name="arch" type="xml">
                <list string="Property">
                    <field name="name" />
                    <field name="sequence_number" />
                    <field name="property_type_id" />
                    <field name="status" />
                    <field name="company_id" groups="base.group_multi_company" />
                </list>
            </field>
        </record>

        <record id="hrb_property_action" model="ir.actions.act_window">
            <field name="name">Property</field>
            <field name="res_model">hrb.property</field>
            <field name="view_mode">kanban,list,pivot,graph,form</field>
        </record>

        <menuitem id="hrb_property_menu_root" name="Property" sequence="26"
            web_icon="sale_subscription_property,static/description/waqf.png" />
        <menuitem id="hrb_property_managment_menu" name="Managment" parent="hrb_property_menu_root"
            sequence="20" />
        <menuitem id="hrb_property_property_menu" name="Property"
            parent="hrb_property_managment_menu"
            action="hrb_property_action" sequence="10" />
        <menuitem id="hrb_property_configuration_menu" name="Configuration"
            parent="hrb_property_menu_root"
            sequence="100" groups="sale_subscription_property.group_hrb_property_admin" />
    </data>
</odoo>