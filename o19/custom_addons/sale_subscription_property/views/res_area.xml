<odoo>
    <data>
        <record id="res_area_form" model="ir.ui.view">
            <field name="name">res.area.form</field>
            <field name="model">res.area</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="row justify-content-between position-relative w-100 m-0 mb-2">
                            <div class="oe_title mw-75 ps-0 pe-2">
                                <h1 class="d-flex flex-row align-items-center">
                                    <field name="name" placeholder="Area's Name" required="True" style="font-size: min(4vw, 2.6rem);"/>
                                </h1>
                            </div>
                        </div>
                        <notebook>
                            <page string="Basic Info">
                                <group>
                                    <group string="Area Info">
                                        <field name="city_id" required="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="res_area_list" model="ir.ui.view">
            <field name="name">res.area.list</field>
            <field name="model">res.area</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="city_id"/>
                </list>
            </field>
        </record>

        <record id="res_area_action" model="ir.actions.act_window">
            <field name="name">Areas</field>
            <field name="res_model">res.area</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="res_area_menu" name="Areas" parent="contacts.menu_localisation" action="res_area_action" sequence="40"/>
    </data>
</odoo>
