<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_hrb_property" model="ir.ui.view">
        <field name="name">account.move.form.inherit.hrb_property</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Property" name="hrb_property" invisible="not show_properties_features">
                    <group>
                        <field name="property_id" />
                        <field name="property_unit_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>