<odoo>
    <template id="report_invoice_document_inherit_wd" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <t t-if="not proforma">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                        <t name="invoice_title">Tax Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                        <t name="draft_invoice_title">Draft Tax Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">
                        <t name="cancelled_invoice_title">Cancelled Tax Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'"
                        class="text-center">
                        <t name="credit_note_title">Tax Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">
                        <t name="draft_credit_note_title">Draft Tax Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">
                        <t name="cancelled_credit_note_title">Cancelled Tax Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_refund' and not o.journal_id.is_self_billing">
                        <t name="vendor_credit_note_title">Vendor Tax Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_refund' and o.journal_id.is_self_billing">
                        <t name="self_billing_credit_note_title">Self Billing Tax Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_invoice' and not o.journal_id.is_self_billing">
                        <t name="vendor_bill_title">Vendor Bill</t>
                    </span>
                    <span t-elif="o.move_type == 'in_invoice' and o.journal_id.is_self_billing">
                        <t name="self_billing_invoice_title">Self Billing</t>
                    </span>
                </t>
                <t t-else="">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                        <t name="proforma_invoice_title">Proforma Tax Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                        <t name="draft_proforma_invoice_title">Draft Proforma Tax Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">
                        <t name="cancelled_proforma_invoice_title">Cancelled Proforma Tax Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'"
                        class="text-center">
                        <t name="proforma_credit_note_title">Proforma Tax Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">
                        <t name="draft_proforma_credit_note_title">Draft Proforma Tax Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">
                        <t name="cancelled_proforma_credit_note_title">Cancelled Proforma Tax Credit
                            Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_refund'">
                        <t name="proforma_vendor_credit_note_title">Proforma Vendor Tax Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_invoice'">
                        <t name="proforma_vendor_bill_title">Proforma Vendor Bill</t>
                    </span>
                </t>
                <span t-if="o.name and o.name != '/'" t-field="o.name">INV/2023/0001</span>
            </t>
        </xpath>

        <xpath expr="//div[@name='address_not_same_as_shipping']/t/address" position="before">
            <strong t-if="o.move_type in ['out_invoice','out_refund']">Bill To:</strong>
        </xpath>

        <xpath expr="//div[@name='address_same_as_shipping']/t/address" position="before">
            <strong t-if="o.move_type in ['out_invoice','out_refund']">Bill &amp; Ship To:</strong>
        </xpath>

        <xpath expr="//div[@name='no_shipping']/t/address" position="before">
            <strong t-if="o.move_type in ['out_invoice','out_refund']">Bill To:</strong>
        </xpath>

        <xpath expr="//div[@name='reference']" position="after">
            <div class="col" t-if="o.credit_note_ref and o.move_type == 'out_refund'"
                name="credit_note_reference">
                <strong>Credit Note Reference</strong>
                <div t-field="o.credit_note_ref"></div>
            </div>
            <div class="col" t-if="o.invoice_user_id" name="salesperson">
                <strong>Salesperson</strong>
                <div t-field="o.invoice_user_id.name"></div>
            </div>
        </xpath>

        <!-- Columns -->
        <xpath expr="//th[@name='th_description']" position="before">
            <t t-set="seq_count" t-value="0" />
            <th name="th_sequence" class="text-start">#</th>
            <th name="th_barcode" class="text-end">
                <span>Barcode</span>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="after">
            <th name="th_discount_amount" t-if="display_discount"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Disc.% Amount</span>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="after">
            <th name="th_taxes_amount" t-if="display_taxes"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Taxes Amount</span>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="after">
            <th name="th_subtotal_tax_inc" class="text-end">
                <span>Tax Inc.</span>
            </th>
        </xpath>

        <!-- Rows -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="td_sequence" class="text-start">
                <t t-set="seq_count" t-value="seq_count + 1" />
                <span t-esc="seq_count" />
            </td>
            <td name="td_barcode" class="text-end">
                <span t-field="line.barcode" class="text-nowrap"></span>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_discount']" position="after">
            <td name="td_discount_amount" t-if="display_discount"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span class="text-nowrap" t-field="line.discount_amount">0</span>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="after">
            <td name="td_taxes_amount" t-if="display_taxes"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                <!-- <span t-if="not hide_prices" t-out="taxes" id="line_tax_ids">Tax 15%</span> -->
                <span t-if="not hide_prices" t-field="line.tax_amount" id="line_tax_amount_ids"></span>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="after">
            <td name="td_subtotal_tax_inc" class="text-end o_price_total">
                <span t-if="not hide_prices" class="text-nowrap" t-field="line.price_total"></span>
            </td>
        </xpath>
        <xpath expr="//table[hasclass('o_total_table')]/t[1]" position="before">
            <tr class="o_total_amount_before_discount" t-if="o.total_discount > 0">
                <td>
                    <span>Amount Before Discount</span>
                </td>
                <td class="text-end">
                    <span t-field="o.amount_before_discount"
                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"></span>
                </td>
            </tr>
            <tr class="o_total_discount" t-if="o.total_discount > 0">
                <td>
                    <span>Total Discount</span>
                </td>
                <td class="text-end">
                    <span t-field="o.total_discount"
                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"></span>
                </td>
            </tr>
        </xpath>

    </template>
</odoo>