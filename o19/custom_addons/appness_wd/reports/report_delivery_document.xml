<odoo>
    <template id="report_delivery_document_inherit_wd" inherit_id="stock.report_delivery_document">
        <!-- Columns -->
        <xpath expr="//th[@name='th_sm_product']" position="before">
            <th name="th_sm_barcode" class="text-end">
                <strong>Barcode</strong>
            </th>
        </xpath>

        <!-- Rows -->
        <xpath expr="//tr[td[hasclass('o_td_quantity')]]/td[1]" position="before">
            <td name="td_barcode" class="o_td_barcode text-end">
                <span t-field="move.barcode"></span>
            </td>
        </xpath>
    </template>
</odoo>