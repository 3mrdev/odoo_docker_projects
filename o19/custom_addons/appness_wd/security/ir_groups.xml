<odoo>
    <data noupdate="1">
        <record id="customer_evaluation_category" model="ir.module.category">
            <field name="name">Customer Evaluation</field>
            <field name="description">Customer Evaluation</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_customer_evaluation">
            <field name="name">Customer Evaluation</field>
            <field name="sequence">9</field>
            <field name="category_id" ref="customer_evaluation_category"/>
        </record>

        <record id="group_evaluation_user" model="res.groups">
            <field name="name">Evaluation User</field>
            <field name="privilege_id" ref="res_groups_privilege_customer_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_evaluation_manager" model="res.groups">
            <field name="name">Evaluation Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_customer_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('appness_wd.group_evaluation_user'))]"/>
        </record>

    </data>
</odoo>