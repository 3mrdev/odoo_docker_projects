<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="appness_wd.OrderDisplay" t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]/div[1]" position="before">
            <div class="d-flex justify-content-between w-100 fs-3">
                <span><b style="margin: 0px 5px;" t-esc="lines.reduce((sum, line) => sum + (line.is_reward_line ? 0 : line.qty), 0)"/></span>
                <span></span>
            </div>
        </xpath>
    </t>
</templates>