<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.return.policy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="after">
                <block title="Return Policy" id="pos_return_policy_section">
                    <setting string="Return Limit" help="Limit the number of days for returns.">
                        <field name="pos_return_limit_days"/>
                        <div class="content-group">
                            <div class="mt16">
                                <label for="pos_return_limit_days" string="Days"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
