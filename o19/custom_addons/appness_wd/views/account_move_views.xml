<odoo>
    <record id="view_account_move_form_inherit_wd" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reverse']" position="after">
                <button name="action_return_products" string="Return Products" type="object"
                    groups="account.group_account_invoice"
                    invisible="move_type not in ('out_refund','in_refund') or return_pickings"
                    confirm="Are you sure you want to return the products ?" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="open_return_products" class="oe_stat_button" icon="fa-exchange"
                    type="object" invisible="not return_pickings">
                    <field name="return_pickings_count" string="Returned Products" widget="statinfo" />
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="before">
                <!-- <field name="sequence_number" /> -->
                <field name="barcode" string="Barcode" optional="show" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']"
                position="after">
                <field name="discount_amount" string="Disc. Amount" widget="monetary"
                    optional="show" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']"
                position="before">
                <field name="tax_amount" string="Tax Amount" widget="monetary" optional="show" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']"
                position="after">
                <field name="price_total" string="Tax Inc." widget="monetary" optional="show" />
            </xpath>
            <xpath expr="//page[@id='other_tab']/group/group/field[@name='ref']" position="after">
                <field name="credit_note_ref" string="Credit Note Reference"
                    invisible="move_type != 'out_refund'" />
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="amount_before_discount" class="oe_subtotal_footer_separator"
                    string="Amount Before Discount" widget="monetary"
                    invisible="total_discount == 0" />
                <field name="total_discount" class="oe_subtotal_footer_separator"
                    string="Total Discount"
                    widget="monetary" invisible="total_discount == 0" />
            </xpath>
        </field>
    </record>
</odoo>