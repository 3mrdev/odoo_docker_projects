<odoo>
    <record id="view_picking_form_inherit_wd" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.wd</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority" eval="17"/>
        <field name="arch" type="xml">
            <field name="user_id" position="before">
                <field name="credit_note_id"/>
            </field>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="before">
                <field name="barcode" string="Barcode" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>