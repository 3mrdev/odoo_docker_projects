<odoo>
    <data noupdate="1">

        <record id="maintenance_seq_id" model="ir.sequence">
            <field name="name">Maintinance Request Sequence</field>
            <field name="code">maintenance.seq</field>
            <field name="prefix">MR</field>
            <field name="padding">7</field>
        </record>

        <record id="sparepart_seq_id" model="ir.sequence">
            <field name="name">Sparepart Request Sequence</field>
            <field name="code">sparepart.seq</field>
            <field name="prefix">SP</field>
            <field name="padding">7</field>
        </record>

        <record id="ir_cron_maintenance_request" model="ir.cron">
            <field name="name">Maintenance Request Cron Job</field>
            <field name="model_id" ref="model_maintenance_request" />
            <field name="state">code</field>
            <field name="code">model._cron_check_maintenance_requests()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True" />
        </record>

        <record id="ir_cron_maintenance_request_archive" model="ir.cron">
            <field name="name">Maintenance Request Cron Job Archive</field>
            <field name="model_id" ref="model_maintenance_request" />
            <field name="state">code</field>
            <field name="code">
                model.archive_done_requests_cron(rec_limit=100,day_limit=30,archive_flag=True)</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>

    </data>
</odoo>