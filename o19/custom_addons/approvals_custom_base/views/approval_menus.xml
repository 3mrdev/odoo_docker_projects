<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_operation_view_form" model="ir.ui.view">
        <field name="name">approval.operation.view.form</field>
        <field name="model">approval.operation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_operation" model="ir.actions.act_window">
        <field name="name">Operation Statuses</field>
        <field name="res_model">approval.operation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_approval_operation"
        parent="approvals.approvals_menu_config"
        name="Operation Statuses"
        action="action_approval_operation"
        groups="approvals.group_approval_manager"
        sequence="20"/>

</odoo>
