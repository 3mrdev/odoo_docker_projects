<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="mrp_production_form_inherit_plan">
        <field name="name">mrp.production.form.inherit.production.plan</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']//group[2]" position="inside">
                <field name="plan_target_id" readonly="state in ('done', 'cancel')"
                       groups="mrp_production_plan.group_production_plan_user"/>
                <field name="plan_id" groups="mrp_production_plan.group_production_plan_user"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="mrp_production_list_inherit_plan">
        <field name="name">mrp.production.list.inherit.production.plan</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="plan_id" optional="hide"
                       groups="mrp_production_plan.group_production_plan_user"/>
            </xpath>
        </field>
    </record>

</odoo>
