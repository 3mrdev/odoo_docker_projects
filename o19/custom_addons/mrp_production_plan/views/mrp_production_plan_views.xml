<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_mrp_production_plan_form">
        <field name="name">mrp.production.plan.view.form</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <form string="Production Plan">
                <header>
                    <button string="Confirm" name="action_confirm" invisible="state != 'draft'" type="object" class="btn-primary"/>
                    <button string="Revise" name="create_revised_plan" invisible="state != 'confirmed'" type="object" class="btn-secondary"/>
                    <button string="Done" name="action_done" invisible="state != 'confirmed'" type="object" class="btn-secondary"/>
                    <button string="Reset to Draft" name="action_draft" invisible="state != 'cancelled'" type="object" class="btn-secondary"/>
                    <button string="Cancel" name="action_cancel" invisible="state != 'draft'" type="object" class="btn-secondary"/>
                    <button string="Generate Draft MOs" name="action_generate_mo" invisible="state != 'confirmed' or not line_ids" type="object"/>
                    <button string="Print Plan" name="action_print_plan" invisible="state == 'draft'" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet string="Production Plan">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_open_plan_analysis" type="object" icon="fa-bar-chart" invisible="state == 'draft'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Plan Analysis</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" name="action_open_plan_targets" type="object" icon="fa-bullseye" invisible="not line_ids">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Targets</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'" placeholder="e.g. Gold Production Plan 2027"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="state != 'draft'" widget="many2one_avatar" options="{'no_create': True}"/>
                            <field name="parent_id" invisible="not parent_id"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <label for="date_from" string="Period"/>
                            <div class="o_row">
                                <field name="date_from" nolabel="1" class="oe_inline" readonly="state != 'draft'"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="to" title="to"/>
                                <field name="date_to" nolabel="1" class="oe_inline" readonly="state != 'draft'"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plan Lines" name="plan_lines">
                            <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                                <list string="Plan Lines" editable="bottom" decoration-danger="achieved_percentage &gt; 1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_id" column_invisible="1"/>
                                    <field name="bom_id" optional="show"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="target_qty_total"/>
                                    <field name="actual_qty"/>
                                    <field name="target_gold_total" sum="Target Gold" optional="hide"/>
                                    <field name="actual_gold_content" sum="Actual Gold" optional="hide"/>
                                    <field name="achieved_percentage" widget="percentage" optional="show"/>
                                    <field name="theoretical_qty" optional="hide"/>
                                    <field name="mo_count" optional="hide"/>
                                    <button type="object" name="action_open_line_targets" string="Targets" width="60px"/>
                                    <button type="object" name="action_open_mo_details" string="Details" width="60px" column_invisible="parent.state in ('draft', 'cancelled')"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right"
                                name="plan_total">
                                <div class="mt-2">
                                    <label for="actual_qty_total" class="me-auto" />
                                    <span class="h2">
                                        <field name="actual_qty_total" widget="float"
                                            class="oe_inline" />
                                        <span class="oe_grey p-2"> /</span>
                                        <field name="target_qty_total" widget="float"
                                            class="oe_inline" />
                                    </span>
                                </div>
                                <div class="mt-2">
                                    <label for="actual_gold_total" class="me-auto" />
                                    <span class="h2">
                                        <field name="actual_gold_total" widget="float"
                                            class="oe_inline" />
                                        <span class="oe_grey p-2"> /</span>
                                        <field name="target_gold_total" widget="float"
                                            class="oe_inline" />
                                    </span>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_mrp_production_plan_list">
        <field name="name">mrp.production.plan.view.list</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state in ('done', 'cancelled', 'revised')" string="Production Plans">
                <header>
                    <button display="always" class="btn btn-secondary" string="Revise" type="object" name="create_revised_plan"/>
                </header>
                <field name="name" readonly="state == 'done'"/>
                <field name="user_id" options="{'no_create': True}"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="hide"/>
                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_mrp_production_plan_kanban">
        <field name="name">mrp.production.plan.view.kanban</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row mb4">
                            <field name="name" class="fw-bold fs-5 col-8"/>
                            <div class="col-4">
                                <field name="state" class="float-end" widget="label_selection" options="{'classes': {'draft': 'default', 'confirmed': 'success'}}"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-10">
                                <i class="fa fa-clock-o me-1" role="img" aria-label="Period" title="Period"/>
                                <field name="date_from"/> - <field name="date_to"/>
                            </div>
                            <div class="col-2">
                                <field name="user_id" class="float-end" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="view_mrp_production_plan_search">
        <field name="name">mrp.production.plan.view.search</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <search string="Production Plans">
                <field name="name" string="Plan"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Revised" name="revised" domain="[('state', '=', 'revised')]"/>
                <separator/>
                <filter string="My Plans" name="my_plans" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_mrp_production_plan_view">
        <field name="name">Production Plans</field>
        <field name="res_model">mrp.production.plan</field>
        <field name="path">production-plans</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_mrp_production_plan_list"/>
        <field name="search_view_id" ref="view_mrp_production_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new production plan.
            </p>
            <p>
                Set targets per period for your grade-tracked products and follow target vs actual production.
            </p>
        </field>
    </record>

    <menuitem id="menu_mrp_production_plan"
              parent="mrp.mrp_planning_menu_root"
              name="Production Plans"
              action="act_mrp_production_plan_view"
              sequence="5"
              groups="mrp_production_plan.group_production_plan_user"/>

</odoo>
