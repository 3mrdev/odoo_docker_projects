<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_plan_target_generate_form">
        <field name="name">mrp.production.plan.target.generate.view.form</field>
        <field name="model">mrp.production.plan.target.generate</field>
        <field name="arch" type="xml">
            <form string="Break Down Target">
                <group>
                    <group>
                        <field name="target_id" readonly="1"/>
                        <field name="period_type"/>
                    </group>
                    <group>
                        <field name="split_mode"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate Targets" name="action_generate" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
