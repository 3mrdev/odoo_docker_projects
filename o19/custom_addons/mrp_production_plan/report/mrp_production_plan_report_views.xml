<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_mrp_production_plan_report_pivot">
        <field name="name">mrp.production.plan.report.pivot</field>
        <field name="model">mrp.production.plan.report</field>
        <field name="arch" type="xml">
            <pivot string="Production Plan Analysis">
                <field name="plan_id" type="row"/>
                <field name="period_type" type="row"/>
                <field name="target_qty" type="measure"/>
                <field name="actual_qty" type="measure"/>
                <field name="target_gold_content" type="measure"/>
                <field name="actual_gold_content" type="measure"/>
            </pivot>
        </field>
    </record>

    <record model="ir.ui.view" id="view_mrp_production_plan_report_graph">
        <field name="name">mrp.production.plan.report.graph</field>
        <field name="model">mrp.production.plan.report</field>
        <field name="arch" type="xml">
            <graph string="Production Plan Analysis">
                <field name="period_type"/>
                <field name="target_qty" type="measure"/>
                <field name="actual_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record model="ir.ui.view" id="view_mrp_production_plan_report_list">
        <field name="name">mrp.production.plan.report.list</field>
        <field name="model">mrp.production.plan.report</field>
        <field name="arch" type="xml">
            <list string="Production Plan Analysis">
                <field name="plan_id"/>
                <field name="product_id"/>
                <field name="period_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="line_type"/>
                <field name="target_qty"/>
                <field name="actual_qty"/>
                <field name="target_gold_content"/>
                <field name="actual_gold_content"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_mrp_production_plan_report">
        <field name="name">Production Plan Analysis</field>
        <field name="res_model">mrp.production.plan.report</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <menuitem id="menu_mrp_production_plan_report"
              parent="mrp.menu_mrp_reporting"
              name="Production Plan Analysis"
              action="action_mrp_production_plan_report"
              sequence="60"
              groups="mrp_production_plan.group_production_plan_user"/>

</odoo>
