<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record model="res.groups.privilege" id="res_groups_privilege_production_plan">
        <field name="name">Production Plans</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_production_plan_user" model="res.groups">
        <field name="name">Production Plan User</field>
        <field name="privilege_id" ref="res_groups_privilege_production_plan"/>
    </record>

    <record id="group_production_plan_manager" model="res.groups">
        <field name="name">Production Plan Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_production_plan"/>
        <field name="implied_ids" eval="[Command.link(ref('group_production_plan_user'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_production_plan_company" model="ir.rule">
        <field name="name">Production Plan multi-company</field>
        <field name="model_id" ref="model_mrp_production_plan"/>
        <field eval="True" name="global"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_production_plan_line_company" model="ir.rule">
        <field name="name">Production Plan Line multi-company</field>
        <field name="model_id" ref="model_mrp_production_plan_line"/>
        <field eval="True" name="global"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_production_plan_target_company" model="ir.rule">
        <field name="name">Production Plan Target multi-company</field>
        <field name="model_id" ref="model_mrp_production_plan_target"/>
        <field eval="True" name="global"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_production_plan_report_company" model="ir.rule">
        <field name="name">Production Plan Analysis multi-company</field>
        <field name="model_id" ref="model_mrp_production_plan_report"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
    </record>
    </data>

</odoo>
