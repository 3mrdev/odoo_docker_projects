<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- INTERNAL USER RULES (base.group_user)                        -->
    <!-- ============================================================ -->

    <!-- stock.warehouse.orderpoint: internal user sees only orderpoints
         whose location_id is in their allowed locations.
         Note: Users should have parent locations manually added to allowed_location_ids
         to prevent access errors when displaying location names in views.
         Bypass: if user has no allowed locations (check_location=False),
         boolean_orderpoint_flag is also False → OR evaluates True → sees all. -->
    <record id="rule_orderpoint_allowed_user" model="ir.rule">
        <field name="name">Orderpoint Allowed User</field>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="domain_force">
            ['|',
                ('location_id', 'in', user.allowed_location_ids.ids),
                ('boolean_orderpoint_flag', '=', user.check_location)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- stock.route: internal user sees only routes manually assigned
         via allowed_route_ids on the user.
         Bypass: if user has no allowed routes (check_location=False for routes),
         boolean_route_flag is also False → OR evaluates True → sees all. -->
    <record id="rule_route_allowed_user" model="ir.rule">
        <field name="name">Route Allowed User</field>
        <field name="model_id" ref="stock.model_stock_route"/>
        <field name="domain_force">
            ['|',
                ('id', 'in', user.allowed_route_ids.ids),
                ('boolean_route_flag', '=', user.check_location)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- MANAGER RULES (group_warehouse_manager)                      -->
    <!-- ============================================================ -->

    <!-- stock.warehouse.orderpoint: manager sees all -->
    <record id="rule_orderpoint_manager" model="ir.rule">
        <field name="name">Orderpoint Manager</field>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sttl_warehouse_access_control.group_warehouse_manager'))]"/>
    </record>

    <!-- stock.route: manager sees all -->
    <record id="rule_route_manager" model="ir.rule">
        <field name="name">Route Manager</field>
        <field name="model_id" ref="stock.model_stock_route"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sttl_warehouse_access_control.group_warehouse_manager'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- STOCK RULE (Route Rules)                                       -->
    <!-- ============================================================ -->

    <!-- stock.rule: internal user sees only rules of their allowed routes.
         A user can see a rule if its route is in their allowed_route_ids.
         Bypass: if user has no allowed routes, sees all. -->
    <record id="rule_stock_rule_allowed_user" model="ir.rule">
        <field name="name">Stock Rule Allowed User</field>
        <field name="model_id" ref="stock.model_stock_rule"/>
        <field name="domain_force">
            ['|',
                ('route_id', 'in', user.allowed_route_ids.ids),
                ('boolean_rule_flag', '=', user.check_location)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- stock.rule: manager sees all -->
    <record id="rule_stock_rule_manager" model="ir.rule">
        <field name="name">Stock Rule Manager</field>
        <field name="model_id" ref="stock.model_stock_rule"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sttl_warehouse_access_control.group_warehouse_manager'))]"/>
    </record>

</odoo>
