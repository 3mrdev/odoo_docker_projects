<odoo>
    <data>
        <record id="jiz_document_type_form" model="ir.ui.view">
            <field name="name">jiz.document.type.form</field>
            <field name="model">jiz.document.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="row justify-content-between position-relative w-100 m-0 mb-2">
                            <div class="oe_title mw-75 ps-0 pe-2">
                                <h1 class="d-flex flex-row align-items-center">
                                    <field name="name" placeholder="Type's Name" required="True" style="font-size: min(4vw, 2.6rem);"/>
                                </h1>
                                <field name="type" widget="radio" options="{'horizontal': true}"/>
                            </div>
                        </div>
                        <notebook>
                            <page string="Basic Info">
                                <group>
                                    <group string="Documents Filters">
                                        <field name="is_mandatory" widget="boolean_toggle" help="Check this only if this document is required at all times"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="jiz_document_type_list" model="ir.ui.view">
            <field name="name">jiz.document.type.list</field>
            <field name="model">jiz.document.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="is_mandatory"/>
                </list>
            </field>
        </record>
    </data>
</odoo>