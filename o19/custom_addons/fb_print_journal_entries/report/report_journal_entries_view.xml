<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Journal Entry Report Template -->
        <template id="journal_entry_report_template_all">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <table style="border-collapse: collapse; width: 100%;" class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Partner</th>
                                    <th>Account</th>
                                    <th>Label</th>
                                    <th>Due Date</th>
                                    <th>Analytic Account</th>
                                    <th>Taxes (%)</th>
                                    <th>Debit</th>
                                    <th>Credit</th>
                                </tr>
                            </thead>
                            <tbody class="consumed_tbody">
                                <t t-foreach="docs" t-as="o">
                                    <t t-set="o" t-value="o.with_context({'lang': o.partner_id.lang})"/>
                                    <t t-set="total" t-value="0.0"/>
                                    <t t-set="total1" t-value="0.0"/>
                                    <t t-foreach="o.line_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-field="line.partner_id.name"/> <!-- Use .name for better display -->
                                            </td>
                                            <td>
                                                <span t-field="line.account_id.name"/> <!-- Use .name for better display -->
                                            </td>
                                            <td>
                                                <span t-field="line.name"/>
                                            </td>
                                            <td>
                                                <span t-field="line.date_maturity"/>
                                            </td>
                                            <td>
                                                <t t-foreach="line.analytic_line_ids" t-as="aline">
                                                    <span t-field="aline.account_id.name"/> <!-- Use .name for better display -->
                                                </t>
                                            </td>
                                            <td>
                                                <span t-field="line.tax_ids" />
                                            </td>
                                            <td>
                                                <span t-field="line.debit"/>
                                            </td>
                                            <td>
                                                <span t-field="line.credit"/>
                                            </td>
                                        </tr>
                                        <t t-set="total" t-value="total + line.debit"/>
                                        <t t-set="total1" t-value="total1 + line.credit"/>
                                    </t>
                                    <tr>
                                        <td colspan="6" class="text-right"><strong>Total:</strong></td>
                                        <td width="10%"><strong><span><t t-esc="total"/></span></strong></td>
                                        <td width="10%"><strong><span><t t-esc="total1"/></span></strong></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>