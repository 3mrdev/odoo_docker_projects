<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_request_category_view_list" model="ir.ui.view">
        <field name="name">maintenance.request.category.list</field>
        <field name="model">maintenance.request.category</field>
        <field name="arch" type="xml">
            <list string="Maintenance Request Categories" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="maintenance_request_category_view_form" model="ir.ui.view">
        <field name="name">maintenance.request.category.form</field>
        <field name="model">maintenance.request.category</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Category Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Electrical"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" placeholder="Visible to all"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maintenance_request_category_action" model="ir.actions.act_window">
        <field name="name">Maintenance Request Categories</field>
        <field name="res_model">maintenance.request.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="maintenance_request_category_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new maintenance request category
            </p>
        </field>
    </record>

    <menuitem
        id="menu_maintenance_request_category"
        name="Maintenance Request Categories"
        parent="maintenance.menu_maintenance_configuration"
        action="maintenance_request_category_action"
        sequence="4"/>

</odoo>
