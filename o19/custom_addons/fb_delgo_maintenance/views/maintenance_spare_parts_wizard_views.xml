<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="maintenance_spare_parts_wizard_view_form" model="ir.ui.view">
            <field name="name">maintenance.spare.parts.wizard.form</field>
            <field name="model">maintenance.spare.parts.wizard</field>
            <field name="arch" type="xml">
                <form string="Request Spare Parts">
                    <group>
                        <group>
                            <field name="maintenance_request_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="category_approval_type" invisible="1"/>
                        </group>
                        <group string="Destination (Consumption)">
                            <field name="dest_warehouse_id"/>
                            <field name="dest_location_id"/>
                        </group>
                        <group string="Source" invisible="category_approval_type != 'stock_material'">
                            <field name="source_warehouse_id"/>
                            <field name="source_location_id"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Create Approval Request" name="action_open_approval_request" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
