<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.fb_delgo_maintenance</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="maintenance.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='maintenance']" position="inside">
                    <block title="Spare Parts Consumption" name="fb_delgo_spare_parts_setting_container">
                        <setting id="maintenance_loss_location" string="Maintenance Loss Location"
                                 help="Default destination of the spare parts requested from maintenance. Stock moves reaching it are expensed on the equipment's maintenance expense account.">
                            <field name="maintenance_loss_location_id"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
