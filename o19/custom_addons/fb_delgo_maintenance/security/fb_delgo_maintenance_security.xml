<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_maintenance_schedule_edit" model="res.groups.privilege">
        <field name="name">Maintenance Scheduled Dates</field>
        <field name="description">Edit the Scheduled Date, Scheduled End (equipment downtime) and Close Date of open maintenance requests.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_maintenance_schedule_edit" model="res.groups">
        <field name="name">Edit Scheduled Dates</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_maintenance_schedule_edit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Members may edit the Scheduled Date, Scheduled End (equipment downtime) and Close Date of open maintenance requests.</field>
    </record>

    <record id="privilege_maintenance_spare_parts" model="res.groups.privilege">
        <field name="name">Maintenance Spare Parts</field>
        <field name="description">Request spare parts for maintenance (stock material or purchase approval requests).</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_maintenance_spare_parts" model="res.groups">
        <field name="name">Request Spare Parts</field>
        <field name="sequence">21</field>
        <field name="privilege_id" ref="privilege_maintenance_spare_parts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_user'))]"/>
        <field name="comment">Members may open spare-part approval requests (stock material or purchase) from maintenance requests. Implies the Approvals user access.</field>
    </record>

    <record id="maintenance.group_equipment_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_maintenance_spare_parts'))]"/>
    </record>

    <data noupdate="1">
        <record id="maintenance_request_category_comp_rule" model="ir.rule">
            <field name="name">Maintenance Request Category Multi-company rule</field>
            <field name="model_id" ref="model_maintenance_request_category"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
