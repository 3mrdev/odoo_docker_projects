<odoo>
    <data noupdate="1">
        <record model="res.groups.privilege" id="res_groups_privilege_sale_project_quote">
            <field name="name">Projects Team Sales Quotations</field>
            <field name="sequence">9</field>
        </record>

        <record id="group_sale_project_quote_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_sale_project_quote" />
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        </record>

        <record id="group_sale_project_quote_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_sale_project_quote" />
            <field name="implied_ids"
                eval="[(4, ref('sale_project_quote.group_sale_project_quote_user'))]" />
        </record>

        <record id="sale_project_quote_order_rule" model="ir.rule">
            <field name="name">Sales Project Quote Orders</field>
            <field ref="sale.model_sale_order" name="model_id" />
            <field name="domain_force">[('team_user_ids','in',[user.id])]</field>
            <field name="groups"
                eval="[(4, ref('sale_project_quote.group_sale_project_quote_user')),(4, ref('sale_project_quote.group_sale_project_quote_manager'))]" />
        </record>

        <record id="sale_project_quote_order_line_rule" model="ir.rule">
            <field name="name">Sales Project Quote Order Lines</field>
            <field ref="sale.model_sale_order_line" name="model_id" />
            <field name="domain_force">[('order_id.team_user_ids','in',[user.id])]</field>
            <field name="groups"
                eval="[(4, ref('sale_project_quote.group_sale_project_quote_user')),(4, ref('sale_project_quote.group_sale_project_quote_manager'))]" />
        </record>
    </data>
</odoo>