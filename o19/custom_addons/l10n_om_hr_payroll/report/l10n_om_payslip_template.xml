<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Oman Payslip Report Template - inherits from base Odoo payslip report -->
    <template id="report_payslip_om" inherit_id="hr_payroll.report_payslip" primary="True">

        <!-- Replace Employee ID with Civil ID -->
        <div id="employee_id" position="replace">
            <strong class="me-2">Civil ID / الرقم المدني:</strong>
            <span t-out="o.employee_id.l10n_om_civil_id or ''"/>
            <t t-if="o.employee_id.l10n_om_pasi_number">
                <br/>
                <strong class="me-2">PASI No / رقم التأمين:</strong>
                <span t-out="o.employee_id.l10n_om_pasi_number"/>
            </t>
        </div>

        <!-- Remove fields not needed for Oman -->
        <div id="employee_email" position="replace"/>
        <div id="employee_marital" position="replace"/>
        <div id="employee_person_in_charge" position="replace"/>
        <div id="employee_private_address" position="replace"/>
        <div id="contract_type" position="replace"/>
        <div id="working_schedule" position="replace"/>

        <!-- Simplify worked days table headers -->
        <th id="work_days_header_name" position="replace">
            <th id="work_days_header_name">Entries / البيانات</th>
        </th>
        <th id="work_days_header_hours" position="replace"/>
        <td id="worked_days_hours" position="replace"/>
        <td id="worked_days_amount" position="replace"/>
        <td id="worked_days_total_hours" position="replace"/>
        <td id="worked_days_total_amount" position="replace"/>

        <!-- Simplify salary line table headers -->
        <th id="line_header_amount" position="replace"/>
        <th id="line_header_quantity" position="replace"/>
        <th id="line_header_rate" position="replace"/>
        <td id="payslip_line_amount" position="replace"/>
        <td id="payslip_line_quantity" position="replace"/>
        <td id="payslip_line_rate" position="replace"/>

        <!-- Enhance "To pay" section with bilingual label -->
        <xpath expr="//div[@id='to_pay']" position="replace">
            <div id="to_pay">
                <t t-if="o.net_wage >= 0">
                    <t t-set="allocations" t-value="o.compute_salary_allocations()"/>
                    <t t-foreach="allocations.items()" t-as="alloc">
                        <t t-set="bank" t-value="o.env['res.partner.bank'].browse(int(alloc[0]))"/>
                        <p t-if="bank.acc_number">
                            <span class="fw-bold" t-out="bank.acc_number"/> :
                            <span t-out="alloc[1]" t-options='{"widget": "monetary", "display_currency": o.currency_id}' class="fw-bold"/>
                        </p>
                    </t>
                    <t t-if="not allocations">
                        <p>
                            Net Payable to / صافي الراتب إلى <span class="fst-italic" t-field="o.employee_id.legal_name"/>:
                            <span t-esc="o.net_wage" t-options='{"widget": "monetary", "display_currency": o.currency_id}' class="fw-bold"/>
                        </p>
                    </t>
                </t>
                <p t-if="o.net_wage &lt; 0">
                    The net amount will be recovered from the first positive remuneration.
                    <br/>
                    سيتم استرداد المبلغ الصافي من أول راتب إيجابي لاحق.
                </p>
            </div>
        </xpath>

    </template>

    <!-- Language wrapper for bilingual support -->
    <template id="report_payslip_om_lang">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.employee_id.lang or o.env.lang)"/>
                <t t-call="l10n_om_hr_payroll.report_payslip_om" t-lang="o.env.lang"/>
            </t>
        </t>
    </template>

</odoo>
