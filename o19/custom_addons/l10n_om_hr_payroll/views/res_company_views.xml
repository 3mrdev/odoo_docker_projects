<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_om" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_om</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <separator string="Oman Payroll Settings" colspan="2"/>
                <field name="l10n_om_pasi_establishment_no"/>
                <field name="l10n_om_cr_number"/>
                <field name="l10n_om_wps_reference"/>
            </field>
        </field>
    </record>

</odoo>
