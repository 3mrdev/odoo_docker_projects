            <field name="time_off_type_id" ref="leave_type_sick_100"/>
            <field name="accrued_gain_time">start</field>
            <field name="can_be_carryover" eval="False"/>
            <field name="carryover_date">year_start</field>
            <field name="carryover_day">1</field>
            <field name="carryover_month">1</field>
            <field name="level_ids" eval="[(0, 0, {
                'added_value': 21,
                'added_value_type': 'day',
                'frequency': 'yearly',
                'start_count': 0,
                'start_type': 'day',
                'milestone_date': 'creation',
                'yearly_day': '1',
                'yearly_month': '1',
            })]"/>
        </record>

