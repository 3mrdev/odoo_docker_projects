<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Annual Leave Accrual Plan: 2.5 days/month (30 days/year) -->
        <record id="accrual_plan_annual" model="hr.leave.accrual.plan">
            <field name="name">Annual Leave: 2.5 days/month</field>
            <field name="time_off_type_id" ref="leave_type_annual"/>
            <field name="accrued_gain_time">end</field>
            <field name="can_be_carryover" eval="False"/>
            <field name="level_ids" eval="[(0, 0, {
                'added_value': 2.5,
                'added_value_type': 'day',
                'frequency': 'monthly',
                'first_day': '1',
                'start_count': 0,
                'start_type': 'day',
                'milestone_date': 'creation',
                'action_with_unused_accruals': 'lost',
            })]"/>
        </record>

        <!-- Accrual Plan 1: Sick Time Off 21 days (Paid at 100%) -->
        <record id="accrual_plan_sick_100" model="hr.leave.accrual.plan">
