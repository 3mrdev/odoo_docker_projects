        <record id="salary_rule_absence" model="hr.salary.rule">
            <field name="name">Absence</field>
            <field name="code">ABS</field>
            <field name="sequence">120</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="struct_id" ref="om_regular_pay_structure"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
abs = worked_days.get('ABSENSE100')
result = True if abs else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
abs = worked_days.get('ABSENSE100')
if abs:
    abs_days_count = abs.number_of_days
else:
    abs_days_count = 0
month_days = (payslip.date_to - payslip.date_from).days + 1
result = -(GROSS / month_days)
result_rate = 100.0
result_qty = abs_days_count</field>
        </record>

