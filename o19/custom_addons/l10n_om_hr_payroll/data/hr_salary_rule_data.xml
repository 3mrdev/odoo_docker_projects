            <field name="category_id" ref="l10n_om_hr_payroll.salary_rule_category_ad_alw"/>
            <field name="struct_id" ref="om_regular_pay_structure"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
ot = worked_days.get('OVERTIME')
result = True if ot else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
ot = worked_days.get('OVERTIME')
if ot:
    ot_hours_count = ot.number_of_hours
    ot_rate = ot.work_entry_type_id.amount_rate * 100
else:
    ot_hours_count = 0
    ot_rate = 0
result = version.overtime_by_hour
result_rate = ot_rate
result_qty = ot_hours_count</field>
        </record>

