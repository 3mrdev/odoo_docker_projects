        <!-- D001: Sick Time Off (Paid at 75%) -->
        <record id="salary_rule_d001_sto75" model="hr.salary.rule">
            <field name="name">Sick Time Off (Paid at 75%)</field>
            <field name="code">D001</field>
            <field name="sequence">150</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="struct_id" ref="om_regular_pay_structure"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
sto = worked_days.get('STO75')
result = True if sto else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
sto = worked_days.get('STO75')

if sto:
    sto_days_count = sto.number_of_days
    sto_rate = sto.work_entry_type_id.amount_rate * 100 - 100
else:
    sto_days_count = 0
    sto_rate = 0

month_days = (payslip.date_to - payslip.date_from).days + 1
day_cost = (GROSS / month_days)

result = -day_cost
result_rate = sto_rate
result_qty = sto_days_count</field>
        </record>

