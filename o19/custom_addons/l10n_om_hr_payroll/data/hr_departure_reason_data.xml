<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Extend existing default departure reasons with Oman reason types -->
        <record id="hr.departure_fired" model="hr.departure.reason">
            <field name="l10n_om_reason_type">fired</field>
        </record>

        <record id="hr.departure_resigned" model="hr.departure.reason">
            <field name="l10n_om_reason_type">resigned</field>
        </record>

        <record id="hr.departure_retired" model="hr.departure.reason">
            <field name="l10n_om_reason_type">retired</field>
        </record>

        <!-- New Oman-specific departure reasons -->
        <record id="om_departure_end_of_contract" model="hr.departure.reason">
            <field name="sequence">5</field>
            <field name="name">End of Contract</field>
            <field name="l10n_om_reason_type">end_of_contract</field>
            <field name="country_id" ref="base.om"/>
        </record>

        <record id="om_departure_gross_misconduct" model="hr.departure.reason">
            <field name="sequence">6</field>
            <field name="name">Gross Misconduct</field>
            <field name="l10n_om_reason_type">gross_misconduct</field>
            <field name="country_id" ref="base.om"/>
        </record>

    </data>
</odoo>
