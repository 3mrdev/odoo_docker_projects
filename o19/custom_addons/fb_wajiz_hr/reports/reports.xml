    <template id="biometric_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <style>
                    @font-face {
                        font-family: 'Noto Sans Arabic';
                        src: url('/path/to/NotoSansArabic.ttf') format('truetype');
                    }
                    body {
                        font-family: 'Noto Sans Arabic', sans-serif;
                        direction: rtl;
                        text-align: right;
                    }
                </style>

                <!-- Title Page -->
                <div class="page">
                    <h2 class="text-center">تقرير البصمة الشهري</h2>
                </div>

                <t t-foreach="doc_ids" t-as="employee_id">
                    <t t-set="employee" t-value="env['employee.attendance.report'].browse(employee_id)"/>
                    <t t-set="department" t-value="employee.department_id"/>
                    <div class="page">
                    </div>
                </t>

                <!-- Display total on the last page -->
                <div class="page">
                </div>
            </t>
        </t>
    </template>

        <record id="action_print_biometric_report" model="ir.actions.server">
            <field name="name">Print Monthly Biometric Report</field>
            <field name="model_id" ref="model_employee_attendance_report"/>
            <field name="binding_type">action</field>
            <field name="binding_model_id" ref="model_employee_attendance_report"/>
            <field name="state">code</field>
            <field name="code">
                action = env.ref('fb_wajiz_hr.biometric_report_template').report_action(records)
            </field>
        </record>

