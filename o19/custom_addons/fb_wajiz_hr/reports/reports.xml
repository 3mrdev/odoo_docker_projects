    <template id="attendance_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <style>
                    @font-face {
                        font-family: 'Noto Sans Arabic';
                        src: url('/path/to/NotoSansArabic.ttf') format('truetype');
                    }
                    body {
                        font-family: 'Noto Sans Arabic', sans-serif;
                        direction: rtl;
                        text-align: right;
                    }
                </style>

                <t t-foreach="doc_ids" t-as="employee_id">
                    <t t-set="employee" t-value="env['hr.employee'].browse(employee_id)"/>
                    <div class="page">
                        <h2 class="text-center">Employee Attendance Report for <t t-esc="employee.name" /> </h2>                      
                        <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th style="border: 1px solid black; padding: 8px;">التاريخ</th>
                                    <th style="border: 1px solid black; padding: 8px;">اليوم</th>
                                    <th style="border: 1px solid black; padding: 8px;">عدد ساعات العمل</th>
                                    <th style="border: 1px solid black; padding: 8px;">عدد ساعات الغياب</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_worked_hours" t-value="0"/>
                                <t t-set="total_absence_hours" t-value="0"/>
                                
                                <t t-foreach="employee.total_hours_not_attended" t-as="record">
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px;">
                                            <t t-esc="record.date"/>
                                        </td>
                                        <td style="border: 1px solid black; padding: 8px;">
                                            <t t-esc="record.day"/>
                                        </td>
                                        <td style="border: 1px solid black; padding: 8px;">
                                            <t t-set="worked_hours" t-value="record.worked_hours or 0"/>
                                            <t t-esc="'{:.2f}'.format(worked_hours)"/>
                                            <t t-set="total_worked_hours" t-value="total_worked_hours + worked_hours"/>
                                        </td>
                                        <td style="border: 1px solid black; padding: 8px;">
                                            <t t-set="absence_hours" t-value="record.absence_hours or 0"/>
                                            <t t-esc="'{:.2f}'.format(absence_hours)"/>
                                            <t t-set="total_absence_hours" t-value="total_absence_hours + absence_hours"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- Display total on the last page -->
                <div class="page">
                    <h2 class="text-center">Totals</h2>
                    <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                        <tfoot>
                            <tr>
                                <td colspan="2" style="border: 1px solid black; padding: 8px; text-align: right;">إجمالي ساعات العمل:</td>
                                <td style="border: 1px solid black; padding: 8px;">
                                    <t t-esc="'{:.2f}'.format(total_worked_hours)"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="border: 1px solid black; padding: 8px; text-align: right;">إجمالي ساعات الغياب:</td>
                                <td style="border: 1px solid black; padding: 8px;">
                                    <t t-esc="'{:.2f}'.format(total_absence_hours)"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

