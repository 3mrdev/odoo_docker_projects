<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="res.groups.privilege" id="module_privilege_jiz_waqf">
            <field name="name">Waqf</field>
            <field name="description">User access levels for the Waqf module</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_jiz_waqf_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="jiz_waqf.module_privilege_jiz_waqf"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_jiz_waqf_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="jiz_waqf.module_privilege_jiz_waqf"/>
            <field name="implied_ids" eval="[(4, ref('jiz_waqf.group_jiz_waqf_user'))]"/>
        </record>

    </data>
</odoo>
