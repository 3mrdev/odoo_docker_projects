<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="jiz_waqf_asset_view_form" model="ir.ui.view">
            <field name="name">account.asset.view.form</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="after">
                    <field name="equity_account_id" required="is_automated"/>
                    <field name="equity_journal_id" required="is_automated"/>
                    <field name="is_automated" widget="boolean_toggle"/>
                </field>
            </field>
        </record>
        
        <record id="jiz_waqf_asset_type_action" model="ir.actions.act_window">
            <field name="name">Asset Types</field>
            <field name="res_model">account.asset</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'model')]</field>
            <field name="context">{'default_state': 'model'}</field>
        </record>

        <menuitem id="jiz_waqf_asset_type_menu" name="Asset Types" parent="jiz_waqf.jiz_waqf_configuration_menu" action="jiz_waqf_asset_type_action" sequence="30"/>
    </data>
</odoo>
