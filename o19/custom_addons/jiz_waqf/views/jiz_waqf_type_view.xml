<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="jiz_waqf_type_view_form" model="ir.ui.view">
            <field name="name">jiz.waqf.type.view.form</field>
            <field name="model">jiz.waqf.type</field>
            <field name="arch" type="xml">
                <form string="Waqf Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="asset_model_id" required="1" context="{'default_state': 'model'}" options="{'no_create_edit': True}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="jiz_waqf_type_view_list" model="ir.ui.view">
            <field name="name">jiz.waqf.type.view.list</field>
            <field name="model">jiz.waqf.type</field>
            <field name="arch" type="xml">
                <list string="Waqf Types">
                    <field name="name"/>
                    <field name="asset_model_id"/>
                </list>
            </field>
        </record>

        <record id="jiz_waqf_type_action" model="ir.actions.act_window">
            <field name="name">Waqf Types</field>
            <field name="res_model">jiz.waqf.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="jiz_waqf_type_menu" name="Waqf Types" parent="jiz_waqf.jiz_waqf_configuration_menu" action="jiz_waqf_type_action" sequence="10"/>
    </data>
</odoo>
