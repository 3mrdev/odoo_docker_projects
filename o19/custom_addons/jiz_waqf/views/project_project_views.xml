<odoo>
    <data>
        <record id="project_project_view_form_inherit_jiz_waqf" model="ir.ui.view">
            <field name="name">project.project.view.form.inherit.jiz_waqf</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[1]" position="after">
                    <page name="waqf" string="Waqf">
                        <group>
                            <field name="waqf_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
