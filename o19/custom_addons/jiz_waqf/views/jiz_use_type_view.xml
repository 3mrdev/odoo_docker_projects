<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="jiz_use_type_view_form" model="ir.ui.view">
            <field name="name">jiz.use.type.view.form</field>
            <field name="model">jiz.use.type</field>
            <field name="arch" type="xml">
                <form string="Use Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="is_rent"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="jiz_use_type_view_list" model="ir.ui.view">
            <field name="name">jiz.use.type.view.list</field>
            <field name="model">jiz.use.type</field>
            <field name="arch" type="xml">
                <list string="Use Types">
                    <field name="name"/>
                    <field name="is_rent"/>
                </list>
            </field>
        </record>

        <record id="jiz_use_type_action" model="ir.actions.act_window">
            <field name="name">Use Types</field>
            <field name="res_model">jiz.use.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="jiz_use_type_menu" name="Use Types" parent="jiz_waqf.jiz_waqf_configuration_menu" action="jiz_use_type_action" sequence="20"/>
    </data>
</odoo>
