<odoo>
    <data>
        <record id="purchase_order_view_form_inherit_jiz_waqf" model="ir.ui.view">
            <field name="name">purchase.order.view.form.inherit.jiz_waqf</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[1]" position="after">
                    <page name="waqf" string="Waqf">
                        <group>
                            <field name="waqf_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>