<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="jiz_waqf_unit_view_form" model="ir.ui.view">
            <field name="name">jiz.waqf.unit.view.form</field>
            <field name="model">jiz.waqf.unit</field>
            <field name="arch" type="xml">
                <form string="Waqf Unit">
                    <header>
                        <button name="action_create_rent" string="Create Rent" type="object" class="oe_highlight" invisible="status != 'free'"/>
                        <button name="action_set_under_maintenance" string="Set to Under Maintenance" type="object" invisible="status != 'free'"/>
                        <button name="action_set_free" string="Set to Free" type="object" invisible="status != 'under_maintenance'"/>
                        <field name="status" widget="statusbar" statusbar_visible="free,under_rent,under_maintenance"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_subscriptions" type="object" class="oe_stat_button" icon="fa-book">
                                <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Unit Name..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="waqf_id"/>
                                <field name="internal_reference"/>
                                <field name="sequence_number" readonly="1"/>
                                <field name="product_id" domain="[('type', '=', 'service'),('recurring_invoice', '=', True)]"/>
                                <field name="price" groups="jiz_waqf.group_jiz_waqf_admin"/>
                                <field name="price" readonly="1" groups="!jiz_waqf.group_jiz_waqf_admin"/>
                            </group>
                            <group>
                                <field name="tenant_id" readonly="status != 'free'"/>
                                <field name="responsible_id"/>
                                <!-- <field name="invoice_address_id" groups="jiz_waqf.group_jiz_waqf_admin"/> -->
                                <!-- <field name="invoice_address_id" readonly="1" groups="!jiz_waqf.group_jiz_waqf_admin"/> -->
                                <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Location" name="location">
                                <group>
                                    <group>
                                        <span class="o_form_label o_td_label o_address_type" name="address_name">
                                            <span>Address</span>
                                        </span>
                                        <div class="o_address_format" readonly="1">
                                            <field name="country_enforce_cities" invisible="1"/>
                                            <field name="street" placeholder="Street..." class="o_address_street"/>
                                            <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                            <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                            <field name="area_id" domain="[('city_id', '=', city_id)]"/>
                                            <field name="city_id" placeholder="City" class="o_address_city" domain="[('state_id', '=?', state_id)]" context="{'default_state_id': state_id, 'default_country_id': country_id}" invisible="not country_enforce_cities"/>
                                            <field name="city" placeholder="City" class="o_address_city" invisible="country_enforce_cities and (city_id or city in ('', False))"/>
                                            <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                            <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                        </div>
                                    </group>
                                    <group>
                                        <field name="address_link" widget="url"/>
                                        <field name="address_location_details_id"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter>
                        <thread_view/>
                        <activities/>
                    </chatter>
                </form>
            </field>
        </record>

        <record id="jiz_waqf_unit_view_list" model="ir.ui.view">
            <field name="name">jiz.waqf.unit.view.list</field>
            <field name="model">jiz.waqf.unit</field>
            <field name="arch" type="xml">
                <list string="Waqf Units">
                    <field name="name"/>
                    <field name="waqf_id"/>
                    <field name="status"/>
                    <field name="tenant_id"/>
                    <field name="price"/>
                </list>
            </field>
        </record>

        <record id="jiz_waqf_unit_action" model="ir.actions.act_window">
            <field name="name">Waqf Units</field>
            <field name="res_model">jiz.waqf.unit</field>
            <field name="view_mode">list,pivot,graph,form</field>
        </record>

        <menuitem id="jiz_waqf_unit_menu" name="Waqf Units" parent="jiz_waqf.jiz_waqf_managment_menu" action="jiz_waqf_unit_action" sequence="20"/>
    </data>
</odoo>