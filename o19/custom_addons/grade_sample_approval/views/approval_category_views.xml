<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_grade_sample_category_view_form_inherit" model="ir.ui.view">
        <field name="name">approval.grade.sample.category.view.form.inherit</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_type']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='has_location']" position="attributes">
                <attribute name="readonly">approval_type == 'grade_sample'</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
