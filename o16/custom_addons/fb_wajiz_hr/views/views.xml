            <field name="res_model">hr.custody</field>
            <field name="view_mode">tree,pivot,form</field>
            <field name="search_view_id" ref="hr_custody.hr_custody_search_view" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to Create a New Record.
                </p>
            </field>
        </record>

        <record id="view_employee_attendance_report_tree" model="ir.ui.view">
            <field name="name">employee.attendance.report.tree</field>
            <field name="model">employee.attendance.report</field>
            <field name="arch" type="xml">
                <tree string="Employee Attendance Reports">
                    <field name="identification_no" />
                    <field name="employee_id" />
                    <field name="department_id" />
                    <field name="date" />
                    <field name="day" />
                    <field name="absence_hours" />
                    <field name="worked_hours" />
                    <field name="notes_id" />
                    <field name="approval" />
                </tree>
            </field>
        </record>

        <record id="view_employee_attendance_report_pivot" model="ir.ui.view">
            <field name="name">employee.attendance.report.pivot</field>
            <field name="model">employee.attendance.report</field>
            <field name="arch" type="xml">
                <pivot string="Employee Attendance Reports">
                    <field name="date" type="row" />
                    <field name="department_id" type="row" />
                    <field name="employee_id" type="row" />
                    <field name="notes_id" type="row" />
                    <field name="worked_hours" type="measure" />
                    <field name="absence_hours" type="measure" />
                </pivot>
            </field>
