<odoo>
    <data>

        <record id="document_form" model="ir.ui.view">
            <field name="name">hr.document.form</field>
            <field name="model">hr.document</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="valid" type="object" string="Approve" states="draft" />
                        <button name="draft" type="object" string="Reset to draft" states="canceled" />
                        <button name="cancel" type="object" string="Cancel"
                            states="draft,valid,renew,expired" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <field name="active" invisible="1" />
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}" />
                        <div class="oe_title">
                            <h1 class="d-flex">
                                <field name="name" placeholder="Document's Name" required="True"
                                    style="font-size: min(4vw, 2.6rem);" />
                                <div class="d-flex align-items-end fs-6"
                                    style="height: min(4vw, 2.6rem); padding-bottom: 1px;">
                                    <div id="hr_presence_status" class="ms-1">
                                        <small role="img"
                                            class="fa fa-fw fa-circle text-success o_button_icon hr_presence align-middle"
                                            attrs="{'invisible': [('state', '!=', 'valid')]}"
                                            aria-label="Valid" title="Valid" />
                                        <small role="img"
                                            class="fa fa-fw fa-circle-o text-muted o_button_icon hr_presence align-middle"
                                            attrs="{'invisible': [('state', '!=', 'expired')]}"
                                            aria-label="Expired" title="Expired" name="expired" />
                                        <small role="img"
                                            class="fa fa-fw fa-circle-o text-success o_button_icon hr_presence align-middle"
                                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                                            aria-label="To define" title="To define" name="draft" />
                                        <small role="img"
                                            class="fa fa-fw fa-circle text-warning o_button_icon hr_presence align-middle"
                                            attrs="{'invisible': [('state', '!=', 'canceled')]}"
                                            aria-label="Canceled" title="Canceled" name="canceled" />
                                        <small role="img"
                                            class="fa fa-fw fa-circle text-warning o_button_icon hr_presence align-middle"
                                            attrs="{'invisible': [('state', '!=', 'renew')]}"
                                            aria-label="Renew" title="Renew" name="renew" />
                                    </div>
                                </div>
                            </h1>
                            <h2>
                                <field name="number" placeholder="Document Number" />
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id"
                                    attrs="{'invisible': [('vehicle_id', '!=', False)]}" />
                                <field name="vehicle_id"
                                    attrs="{'invisible': [('employee_id', '!=', False)]}" />
                                <field name="doc_type"
                                    domain="[('document_category', '=', 'employee') if employee_id else ('document_category', '=', 'vehicle')]" />
                                <field name="document" />
                            </group>
                            <group>
                                <field name="begin_date" />
                                <field name="begin_date_hijri" widget="date_hijri" />
                                <field name="finish_date" />
                                <field name="finish_date_hijri" widget="date_hijri"
                                    attrs="{'required':[('doc_type','=',6)]}" />
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"
                            options="{'post_refresh': 'recipients'}" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>

        <record id="fleet_vehicle_form_inherit_TD" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.inherit.td</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location']" position="after">
                    <field name="have_tracking_device" />
                    <field name="have_chip_number"
                        attrs="{'invisible': [('have_tracking_device', '=', False)]}" />
                    <field name="device_number"
                        attrs="{'invisible': [('have_chip_number', '=', False)]}" />
                </xpath>
            </field>
        </record>

        <record id="view_approval_request_form" model="ir.ui.view">
            <field name="name">approval.request.form.inherit</field>
            <field name="model">approval.request</field>
            <field name="inherit_id" ref="approvals.approval_request_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="department_id" />
                </xpath>
            </field>
        </record>


        <record id="view_approval_category_approver_tree" model="ir.ui.view">
            <field name="name">approval.category.approver.tree.inherit</field>
            <field name="model">approval.category.approver</field>
            <field name="inherit_id" ref="approvals.approval_category_approver_view_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="department_id" />
                </xpath>
            </field>
        </record>

        <record id="view_fleet_vehicle_log_services_form_inherit" model="ir.ui.view">
            <field name="name">fleet.vehicle.log.services.form.inherit</field>
            <field name="model">fleet.vehicle.log.services</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vehicle_id']" position="attributes">
                    <attribute name="domain">[["manager_id", "=", uid]]</attribute>
                </xpath>
            </field>
        </record>

        <record id="fleet.fleet_vehicle_log_services_action" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="res_model">fleet.vehicle.log.services</field>
            <field name="view_mode">tree,kanban,form,graph,pivot,activity</field>
            <field name="domain">[('vehicle_id.manager_id', '=', uid)]</field>
        </record>

        <record id="fleet.fleet_vehicle_action" model="ir.actions.act_window">
            <field name="name">Vehicles</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="view_mode">kanban,tree,form,pivot,activity</field>
            <field name="domain"></field>
        </record>

        <record id="document_tree" model="ir.ui.view">
            <field name="name">hr.document.tree</field>
            <field name="model">hr.document</field>
            <field name="arch" type="xml">
                <tree decoration-muted="state == 'canceled'" decoration-success="state == 'valid'"
                    decoration-danger="state == 'expired'">
                    <field name="employee_id" attrs="{'invisible': [('vehicle_id', '!=', False)]}" />
                    <field name="vehicle_id" attrs="{'invisible': [('employee_id', '!=', False)]}" />
                    <field name="number" />
                    <field name="name" />
                    <field name="doc_type" />
                    <field name="begin_date" />
                    <field name="finish_date" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="document_kanban" model="ir.ui.view">
            <field name="name">hr.document.kanban</field>
            <field name="model">hr.document</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_employee_kanban" js_class="hr_employee_kanban" sample="1">
                    <field name="id" />
                    <field name="state" />
                    <templates>
                        <t t-name="kanban-box">
                            <div
                                class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <t t-if="record.state.raw_value">
                                                    <div class="float-end"
                                                        t-if="record.state.raw_value == 'valid'"
                                                        name="valid">
                                                        <span class="fa fa-circle text-success"
                                                            role="img" aria-label="Valid"
                                                            title="Valid" name="valid">
                                                        </span>
                                                    </div>
                                                    <div class="float-end"
                                                        t-if="record.state.raw_value == 'expired'"
                                                        name="expired">
                                                        <span class="fa fa-circle-o text-muted"
                                                            role="img" aria-label="Expired"
                                                            title="Expired" name="expired">
                                                        </span>
                                                    </div>
                                                    <div class="float-end"
                                                        t-if="record.state.raw_value == 'draft'"
                                                        name="draft">
                                                        <span class="fa fa-circle-o text-success"
                                                            role="img" aria-label="To define"
                                                            title="To define" name="draft">
                                                        </span>
                                                    </div>
                                                    <div class="float-end"
                                                        t-if="record.state.raw_value == 'canceled'"
                                                        name="canceled">
                                                        <span class="fa fa-circle text-warning"
                                                            role="img" aria-label="Canceled"
                                                            title="Canceled" name="canceled">
                                                        </span>
                                                    </div>
                                                    <div class="float-end"
                                                        t-if="record.state.raw_value == 'renew'"
                                                        name="renew">
                                                        <span class="fa fa-circle text-warning"
                                                            role="img" aria-label="Renew"
                                                            title="Renew" name="renew">
                                                        </span>
                                                    </div>
                                                </t>
                                                <field name="name" placeholder="Document's Name" />
                                            </strong>
                                            <span t-if="record.number.raw_value"
                                                class="o_kanban_record_subtitle">
                                                <field name="number" />
                                            </span>
                                        </div>
                                    </div>
                                    <ul>
                                        <li t-if="record.state.raw_value" class="o_text_overflow">
                                            <field name="state" />
                                        </li>
                                        <br />
                                        <li t-if="record.doc_type.raw_value" class="o_text_overflow">
                                            <field name="doc_type" />
                                        </li>
                                        <br />
                                        <li t-if="record.employee_id.raw_value"
                                            class="o_text_overflow">
                                            <field name="employee_id" />
                                        </li>
                                        <br />
                                        <li t-if="record.vehicle_id.raw_value"
                                            class="o_text_overflow">
                                            <field name="vehicle_id" />
                                        </li>
                                        <br />
                                        <li t-if="record.begin_date.raw_value"
                                            class="o_text_overflow">
                                            <field name="begin_date" />
                                        </li>
                                        <br />
                                        <li t-if="record.finish_date.raw_value" class="o_force_ltr">
                                            <field name="finish_date" />
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="attendance_report" model="ir.ui.view">
            <field name="name">attendance.report</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form" />
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Attendance Records">
                        <field name="total_hours_not_attended" widget="one2many_list"
                            options="{'no_create': True, 'no_open': True, 'no_edit': True}">
                            <tree>
                                <field name="employee_id" />
                                <field name="date" />
                                <field name="day" />
                                <field name="worked_hours" />
                                <field name="absence_hours" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_attendance_report_wizard" model="ir.ui.view">
            <field name="name">attendance.report.wizard.form</field>
            <field name="model">attendance.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Attendance Report">
                    <div>
                        <p>Please Select The Range for the Report:</p>
                    </div>
                    <group>
                        <field name="employee_id" readonly="1" />
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                    <footer>
                        <button string="Print Report" type="object" name="print_report"
                            class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_employee_attendance_report_wizard" model="ir.actions.act_window">
            <field name="name">Absense Report</field>
            <field name="res_model">attendance.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="fb_wajiz_hr.view_attendance_report_wizard" />
            <field name="binding_model_id" ref="model_attendance_report_wizard" />
            <field name="binding_view_types">form</field>
        </record>

        <record id="document_search" model="ir.ui.view">
            <field name="name">hr.document.search</field>
            <field name="model">hr.document</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id" />
                    <field name="vehicle_id" />
                    <field name="number" />
                    <field name="name" />
                    <field name="doc_type" />
                    <field name="begin_date" />
                    <field name="finish_date" />
                    <field name="create_uid" string="Created by" />
                    <separator />
                    <filter string="Archived" name="Inactive" domain="[('active', '=', False)]" />
                    <separator />
                    <filter invisible="0" string="Late" name="docs_overdue"
                        domain="[('finish_date', '&lt;', context_today().strftime('%Y-%m-%d'))]" />
                    <filter invisible="0" string="Today" name="docs_today"
                        domain="[('finish_date', '=', context_today().strftime('%Y-%m-%d'))]" />
                    <filter invisible="0" string="Future" name="docs_upcoming_all"
                        domain="[('finish_date', '&gt;', context_today().strftime('%Y-%m-%d'))]" />
                    <separator />
                    <group expand="0" string="Group By">
                        <filter name="group_employee" string="Employee" domain="[]"
                            context="{'group_by': 'employee_id'}" />
                        <filter name="group_state" string="State" domain="[]"
                            context="{'group_by': 'state'}" />
                        <filter name="group_doc_type" string="Doc Type" domain="[]"
                            context="{'group_by': 'doc_type'}" />
                        <filter string="Begin Date" name="filter_begin_date" domain="[]"
                            context="{'group_by':'begin_date'}" />
                        <filter string="Finish Date" name="filter_finish_date" domain="[]"
                            context="{'group_by':'finish_date'}" />
                    </group>
                    <searchpanel>
                        <field name="company_id" groups="base.group_multi_company"
                            icon="fa-building" enable_counters="1" />
                        <field name="doc_type" icon="fa-address-card-o" enable_counters="1" />
                        <field name="state" icon="fa-address-card-o" enable_counters="1" />
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="hr_employee_form_inherit_wajiz" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.wajiz</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form" />
            <field name="arch" type="xml">
                <field name="mobile_phone" position="before">
                    <field name="job_uid" groups="hr.group_hr_user" />
                    <field name="iban_number" groups="hr.group_hr_user" />
                    <field name="job_residency" groups="hr.group_hr_user" />
                </field>
                <!-- <field name="km_home_work" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field> -->
                <field name="spouse_birthdate" position="replace">
                </field>
                <field name="spouse_complete_name" position="replace">
                </field>
                <field name="permit_no" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="work_permit_expiration_date" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="certificate" position="attributes">
                    <attribute name="string">Educational qualification</attribute>
                </field>
                <field name="study_school" position="attributes">
                    <attribute name="string">Educational body</attribute>
                </field>
                <xpath expr="//div[@name='div_km_home_work']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Documents">
                        <group>
                            <group>
                                <field name="related_document1" />
                                <field name="related_document2" />
                                <field name="related_document3" />
                            </group>
                            <group>
                                <field name="related_document4" />
                                <field name="related_document5" />
                                <field name="related_document6" />
                            </group>
                        </group>
                    </page>

                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="related_documents_count" invisible="1" />
                    <button name="action_related_documents" class="oe_stat_button"
                        icon="fa-file-text" type="object" help="Related Documnets"
                        attrs="{'invisible': [('related_documents_count', '=', -1)]}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="related_documents_count" />
                            </span>
                            <span class="o_stat_text">Legal Docs</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="fleet_vehicle_view_form_inherit_related_documents" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.inherit.related.documents</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="related_documents_count" invisible="1" />
                    <button name="action_related_documents_for_vehicle" class="oe_stat_button"
                        icon="fa-file-text" type="object" help="Related Documents"
                        attrs="{'invisible': [('related_documents_count', '=', -1)]}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="related_documents_count" />
                            </span>
                            <span class="o_stat_text">Legal Docs</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="hr_employee_search_inherit_wajiz" model="ir.ui.view">
            <field name="name">hr.employee.search.inherit.wajiz</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="job_uid" />
                    <field name="identification_id" />
                    <field name="visa_no" />
                </field>
            </field>
        </record>

        <record id="hr_employee_public_form_inherit_wajiz" model="ir.ui.view">
            <field name="name">hr.employee.public.form.inherit.wajiz</field>
            <field name="model">hr.employee.public</field>
            <field name="inherit_id" ref="hr.hr_employee_public_view_form" />
            <field name="arch" type="xml">
                <field name="mobile_phone" position="before">
                    <field name="job_uid" />
                </field>
            </field>
        </record>

        <record id="hr_employee_public_form_inherit_wajiz_documents" model="ir.ui.view">
