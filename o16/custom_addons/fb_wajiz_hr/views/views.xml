                                <field name="day" readonly="1" />
                            </group>
                            <group>
                                <field name="worked_hours" />
                                <field name="absence_hours" />
                                <field name="identification_no" readonly="1" />
                            </group>
                        </group>
                        <group>
                            <field name="notes_id" />
                            <field name="approval" />
                            <field name="department_id" readonly="1" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_employee_attendance_report_view" model="ir.actions.act_window">
            <field name="name">Employee Attendance Reports</field>
            <field name="res_model">employee.attendance.report</field>
            <field name="view_mode">tree,form,pivot</field>
            <field name="context">{'group_by': ['date:month', 'department_id', 'employee_id',
                'notes_id']}</field>
        </record>

