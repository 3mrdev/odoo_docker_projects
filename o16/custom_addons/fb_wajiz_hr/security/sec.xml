<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Define the new security group -->
        <record id="group_project_manager" model="res.groups">
            <field name="name">Projects Manager</field>
            <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
            <field name="implied_ids" eval="[(6,0, [ref('maintenance.group_equipment_manager')])]"/>
            <field name="comment">The user will be able to manage projects.</field>  
        </record>

        <record id="project_manager_employees" model="ir.rule">
            <field name="name">Projects Manager Employees</field>
            <field name="model_id" ref="model_hr_employee_public"/>
            <field eval="True" name="global"/>
            <field name="domain_force">["|",('department_id','=',user.employee_id.department_id.id),('department_id.parent_id','=',user.employee_id.department_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="groups" eval="[(4,ref('group_project_manager'))]"/>      
        </record>

        <record id="hr_fleet_rule_vehicle_visibility_hr_officer" model="ir.rule">
            <field name="name">HR Officer: Read rights on vehicles with employees assigned</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <!-- <field name="domain_force">[('manager_id', '!=', False)]</field> -->
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="groups" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
        </record>

        <record id="fleet.fleet_rule_vehicle_visibility_manager" model="ir.rule">
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="active" eval="0"/>
        </record>

        <record id="own_vehicle_rule" model="ir.rule">
            <field name="name">Own Vehicle</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[('manager_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="document_hr" model="ir.rule">
            <field name="name">Documents Multi Company</field>
            <field name="model_id" ref="model_hr_document"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
         </record>

         <record id="employee_own2_hr" model="ir.rule">
            <field name="name">Your Own Employees Public</field>
            <field name="model_id" ref="hr.model_hr_employee_public"/>
            <field eval="True" name="global"/>
            <field name="domain_force">["|",('parent_id','=',user.employee_id.id),('id','=',user.employee_id.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
         </record>

         <record id="employee_own_hr" model="ir.rule">
            <field name="name">Your Own Employees</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field eval="True" name="global"/>
            <field name="domain_force">["|",('parent_id','=',user.employee_id.id),('id','=',user.employee_id.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
         </record>

         <record id="custody_owners" model="ir.rule">
            <field name="name">Your Own Custudy</field>
            <field name="model_id" ref="hr_custody.model_hr_custody"/>
            <field eval="True" name="global"/>
            <field name="domain_force">["|",('employee.parent_id.user_id','=',user.id),('employee.user_id','=',user.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
        </record>


        <record id="hr_document_rule" model="ir.rule">
            <field name="name">User: Modify own document only</field>
            <field name="model_id" ref="model_hr_document"/>
            <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
        </record>

        <record id="hr_documents_rule_man" model="ir.rule">
            <field name="name">Manager: Modify all documents</field>
            <field name="model_id" ref="model_hr_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4,ref('hr.group_hr_user')),(4,ref('hr.group_hr_manager'))]"/>
        </record>

        <record id="custody_owners_man" model="ir.rule">
            <field name="name">Your Own Custudy Manager</field>
            <field name="model_id" ref="hr_custody.model_hr_custody"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4,ref('hr.group_hr_manager'))]"/>
        </record>

        <record id="employee_own_hr_man" model="ir.rule">
            <field name="name">Your Own Employees Man</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4,ref('hr.group_hr_manager'))]"/>
         </record>
        
    </data>
</odoo>