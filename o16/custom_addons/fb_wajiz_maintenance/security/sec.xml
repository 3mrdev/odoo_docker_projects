            <field name="domain_force">[('member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('fb_wajiz_maintenance.group_maintenance_user'))]"/>
        </record>

        <record id="maintenance.equipment_request_rule_user" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <record id="maintenance.equipment_rule_user" model="ir.rule">
