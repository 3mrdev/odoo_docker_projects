            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4,ref('maintenance.group_equipment_manager'))]"/>
        </record>

        <record id="maintenance_team_rule" model="ir.rule">
            <field name="name">You can only see your own team rule</field>
            <field name="model_id" ref="maintenance.model_maintenance_team"/>
            <field name="domain_force">[('member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('fb_wajiz_maintenance.group_maintenance_user'))]"/>
