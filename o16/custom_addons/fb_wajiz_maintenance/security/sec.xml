        <record id="group_maintenance_user" model="res.groups">
            <field name="name">Maintenance User</field>
            <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- <record id="group_maintenance_view" model="res.groups">
            <field name="name">Maintenance View</field>
        </record> -->

        <record id="maintenance.group_equipment_manager" model="res.groups">
            <field name="name">Equipment Manager</field>
            <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
            <field name="implied_ids" eval="[(6,0, [ref('fb_wajiz_maintenance.group_maintenance_user')])]"/>
            <field name="comment">The user will be able to manage equipments.</field>
        </record>

        <!-- Purchase Users Payments Rules -->


        <record id="products_owners" model="ir.rule">
            <field name="name">Your Own Products Branch</field>
            <field name="model_id" ref="stock.model_product_template"/>
            <field eval="True" name="global"/>
            <field name="domain_force">["|",('responsible_id','=',user.id),('responsible_id','=',False)]</field>
            <field name="groups" eval="[(4,ref('group_maintenance_user'))]"/>
        </record>

        <record id="location_owners" model="ir.rule">
            <field name="name">Your Own Location Branch</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field eval="True" name="global"/>
            <field name="domain_force">["|",('user_id','=',user.id),('user_id','=',False)]</field>
            <field name="groups" eval="[(4,ref('group_maintenance_user'))]"/>
        </record>

        <record id="account_move_rule_group_purhcase" model="ir.rule">
            <field name="name">Purchase Move</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="account_move_line_rule_group_readonly_purchase" model="ir.rule">
            <field name="name">Purchase Move Line</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="access_account_payment_purchase_user" model="ir.model.access">
            <field name="name">account.payment access for Purchase User</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="group_id" ref="purchase.group_purchase_user"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="operation_owners" model="ir.rule">
            <field name="name">Your Own Stock Operations Branch</field>
            <field name="model_id" ref="stock.model_stock_picking_type"/>
            <field eval="True" name="global"/>
            <field name="domain_force">["|",('user_id','=',user.id),('user_id','=',False)]</field>
            <field name="groups" eval="[(4,ref('group_maintenance_user'))]"/>
        </record>

        <record id="products_quant_owners" model="ir.rule">
            <field name="name">Your Own Quant Branch</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field eval="True" name="global"/>
            <field name="domain_force">["|",('product_id.responsible_id','=',user.id),('product_id.responsible_id','=',False)]</field>
            <field name="groups" eval="[(4,ref('group_maintenance_user'))]"/>
        </record>

        <record id="products_owners_man" model="ir.rule">
            <field name="name">Your Own Products Branch Manager</field>
            <field name="model_id" ref="stock.model_product_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
