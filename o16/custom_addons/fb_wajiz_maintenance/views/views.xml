        <record id="base_maintenance.maintenance_team_view_form" model="ir.ui.view">
            <field name="active" eval="False" />
        </record>

        <record id="base_maintenance.maintenance_team_view_tree" model="ir.ui.view">
            <field name="active" eval="False" />
        </record>

        <record id="maintenance_custom.maintenance_equipment_form_view" model="ir.ui.view">
            <field name="active" eval="False" />
        </record>

        <!-- <record id="maintenance_custom.maintenance_requiest_inherit_form_view" model="ir.ui.view">
