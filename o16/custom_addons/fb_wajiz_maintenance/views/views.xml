        <record id="maintenance_team_equ_form" model="ir.ui.view">
            <field name="name">maintenance.equipment.form.inherit</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
            <field name="arch" type="xml">
                <field name="maintenance_team_id" position="attributes">
                    <attribute name="attrs">{'required': [(1, '=', 1)]}</attribute>
                </field>
                <field name="technician_user_id" position="replace">
                    <field name="technician_user_id"
                        domain="[('share', '=', False),('id','in',member_ids)]" />
                    <field name="member_ids" invisible="1" />
                </field>
                <field name="maintenance_team_id" position="after">
                    <field name="address_id" domain="[('type','=','other')]" />
                    <field name="todo" />
                </field>
            </field>
        </record>

        <record id="maintenance_team_equ_form2" model="ir.ui.view">
            <field name="name">maintenance.equipment.form.inherit2</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="hr_maintenance.maintenance_equipment_view_form_inherit_hr" />
            <field name="arch" type="xml">
                <field name="employee_id" position="attributes">
                    <attribute name="domain">[('parent_id.user_id','=',uid)]</attribute>
                    <!-- <attribute name="options">{'no_create': True,
                    'no_create_edit':True}</attribute> -->
                    <attribute name="widget">selection</attribute>
                </field>

                <field name="department_id" position="attributes">
                    <attribute name="domain">[('manager_id.user_id','=',uid)]</attribute>
                    <!-- <attribute name="options">{'no_create': True,
                    'no_create_edit':True}</attribute> -->
                    <attribute name="widget">selection</attribute>
                </field>
            </field>
        </record>


        <record id="maintenance_team_equ_category_form" model="ir.ui.view">
            <field name="name">maintenance.equipment.category.form.inherit</field>
            <field name="model">maintenance.equipment.category</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_category_view_form" />
            <field name="arch" type="xml">
                <field name="technician_user_id" position="replace">
                    <field name="maintenance_team_id" />
                    <field name="todo" />
                    <field name="technician_user_id"
                        domain="[('share', '=', False),('id','in',member_ids)]" />
                    <field name="member_ids" invisible="1" />
                </field>
            </field>
        </record>

        <record id="equipment_request_view_form2" model="ir.ui.view">
            <field name="name">equipment.request.view.form2</field>
            <field name="model">maintenance.request</field>
            <field name="inherit_id" ref="base_maintenance.equipment_request_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="maintenance_request_form" model="ir.ui.view">
            <field name="name">maintenance.request.form.inherit</field>
            <field name="model">maintenance.request</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button string="Transfer Spareparts" name="sparepart" type="object" />
                    <button string="Purchase" name="purchase" type="object" />
                    <!-- <button string="Gen Seq" name="gen_sec" type="object"/> -->
                </xpath>
                <xpath expr="//div[1]" position="before">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_pickings" type="object" class="oe_stat_button"
                            attrs="{'invisible':[('stock_pickings_count', '=', 0)]}"
                            icon="fa-wrench">
                            <field string="SpareParts" name="stock_pickings_count" widget="statinfo" />
                        </button>
                    </div>
                </xpath>
                <field name="user_id" position="replace">
                    <field name="user_id" string="Responsible" domain="[('id','in',member_ids)]" />
                    <field name="member_ids" invisible="1" />
                    <field name="active" invisible="1" />
                    <field name="address_id" domain="[('type','=','other')]" />
                    <!-- <field name="closed"/> -->
                    <field name="close_date" />
                    <field name="mtype" />
                    <field name="catalog" />
                    <field name="cost" />
                </field>
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Instructions">
                            <div class="alert alert-info mb-0" role="alert">
                                Upload images in the attachments and it should not be larger than
                                2MB and it should be in png or jpg format
                                (قم برفع الصور في المرفقات و يجب ان لا يتجاوز حجم الصور 2 ميجابايت
                                و يجب ان تكون الصور بصيغة png أو jpg)
                            </div>
                            <field name="note" placeholder="Describe the maintenance to do..." />
                        </page>
                        <page name="description_page" string="Notes">
                            <div class="alert alert-info mb-0" role="alert">
                                Upload images in the attachments and it should not be larger than
                                2MB and it should be in png or jpg format
                                (قم برفع الصور في المرفقات و يجب ان لا يتجاوز حجم الصور 2 ميجابايت
                                و يجب ان تكون الصور بصيغة png أو jpg)
                            </div>
                            <field name="description" readonly="1" />
                        </page>
                        <page name="todo_page" string="Todo">
                            <group>
                                <!-- <button name="cal_todo" string="Generate Todo" type="object"/> -->
                                <group>
                                    <field name="todo" />
                                </group>
                                <group>
                                    <!-- <field name="todo_do"/> -->
                                </group>
                            </group>
                            <field name="todolines">
                                <tree editable="bottom" decoration-muted="check == False">
                                    <field name="name" />
                                    <field name="maintenance_strategy" />
                                    <field name="maintenance_kind_id" />
                                    <field name="equipment_number" />
                                    <field name="check" />
                                    <field name="note" />
                                </tree>
                            </field>
                        </page>
                        <page name="spareparts_page" string="Spare Parts"
                            groups="stock.group_stock_manager,stock.group_stock_user">
                            <field name="stock_pickings2" readonly="1" />
                            <field name="sparepartslines2" readonly="1" />
                            <!-- <field name="sparepartslines" readonly="1">
                                <tree decoration-muted="state == 'cancel'">
                                    <field name="spareparts_id"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="state"/>
                                </tree>
                            </field> -->
                        </page>
                        <page name="purchase_page" string="Purchase Orders"
                            groups="purchase.group_purchase_manager,purchase.group_purchase_user">
                            <field name="purchase_orders" readonly="1" />
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>

        <record id="maintenance_request_form2" model="ir.ui.view">
            <field name="name">maintenance.request.form.inherit2</field>
            <field name="model">maintenance.request</field>
            <field name="inherit_id" ref="hr_maintenance.maintenance_request_view_form_inherit_hr" />
            <field name="arch" type="xml">
                <field name="employee_id" position="attributes">
                    <!--<attribute
                    name="domain">[('parent_id.user_id', '=', uid)]</attribute>-->
                    <!-- Disable the creation of new records -->
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                    <attribute name="widget">selection</attribute>
                </field>
                <field name="employee_id" position="before">
                    <field name="seq" readonly="1" />
                </field>
            </field>
        </record>

        <record id="stock_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="maintenance_request_id" readonly="1" />
                </field>
            </field>
        </record>

        <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_confirm'][1]" position="attributes">
                    <attribute name="groups">purchase.group_purchase_manager</attribute>
                </xpath>
                <xpath expr="//button[@name='button_confirm'][2]" position="attributes">
                    <attribute name="groups">purchase.group_purchase_manager</attribute>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_form_inherit_2" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.2</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Invoices">
                        <field name="invoice_ids" widget="one2many_list"
                            options="{'no_create': True}">
                            <tree>
                                <field name="name" />
                                <field name="amount_total" />
                                <field name="invoice_payments_widget" colspan="2" nolabel="1"
                                    widget="payment" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_form_inherit_action_view_invoices" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.action.view.invoices</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                    <attribute name="groups">
                        account.group_account_invoice,account.group_account_readonly</attribute>
                </xpath>
            </field>
        </record>

        <record id="equipment_form_inherit_sparepart_ids" model="ir.ui.view">
            <field name="name">equipment.form.inherit.sparepart.ids</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Spareparts Records">
                        <field name="sparepart_ids">
                            <tree editable="bottom">
                                <field name="date" widget="date" />
                                <field name="picking_id" />
                                <field name="picking_code" />
                                <field name="product_id" />
                                <field name="product_uom_qty" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="equipment_form_inherit_2" model="ir.ui.view">
            <field name="name">equipment.form.inherit.2</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="equipment_number" />
                    <field name="product_id" />
                </xpath>
            </field>
        </record>

        <record id="stock_location_form_inherit" model="ir.ui.view">
            <field name="name">stock.location.form.inherit</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form" />
            <field name="arch" type="xml">
                <field name="usage" position="after">
                    <field name="user_id" />
                </field>
            </field>
        </record>

        <record id="stock_picking_type_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.type.form.inherit</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form" />
            <field name="arch" type="xml">
                <field name="code" position="after">
                    <field name="user_id" />
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="spareparts_form">
            <field name="name">maintenance.spareparts.form</field>
            <field name="model">maintenance.spareparts</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="SpareParts">
                    <header>
                        <button string="Reset to draft" name="draft" type="object" states="cancel" />
                        <button string="Confirm" name="confirm" type="object" states="draft,submit" />
                        <button string="Reject" name="reject" type="object"
                            states="draft,submit,confirm" />
                        <button string="Cancel" name="cancel" type="object"
                            states="draft,submit,reject" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet attrs="{'readonly':[('state','in',['cancel','confirm'])]}">
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_pickings" type="object" class="oe_stat_button"
                                attrs="{'invisible':[('stock_pickings_count', '=', 0)]}"
                                icon="fa-wrench">
                                <field string="Pickings" name="stock_pickings_count"
                                    widget="statinfo" />
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="seq" readonly="1" />
                                <field name="maintenance_request_id" readonly="1" />
                                <field name="picking_type_id" />
                            </group>
                            <group>
                                <field name="from_loc" />
                                <field name="to_loc_dest" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Spareparts">
                                <field name="sparepart_lines">
                                    <tree editable="bottom">
                                        <field name="spareparts_id" invisible="1" />
                                        <field name="product_id" />
                                        <field name="product_uom_qty" />
                                        <field name="product_uom" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>


        <record id="maintenance_team_form_inherit" model="ir.ui.view">
            <field name="name">maintenance.team.form.inherit</field>
            <field name="model">maintenance.team</field>
            <field name="inherit_id" ref="maintenance.maintenance_team_view_tree" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="picking_type_id" groups="maintenance.group_equipment_manager" />
                    <field name="source_location" groups="maintenance.group_equipment_manager" /> <!--
                    domain="[('usage','=','internal')]" -->
                    <field name="location" groups="maintenance.group_equipment_manager" />
                </field>
            </field>
        </record>

        <record id="res_partner_type_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <field name="vat" position="after">
                    <field name="type" widget="radio" />
                </field>
            </field>
        </record>

        <record id="spareparts_tree" model="ir.ui.view">
            <field name="name">maintenance.spareparts.tree</field>
            <field name="model">maintenance.spareparts</field>
            <field name="arch" type="xml">
                <tree decoration-muted="state == 'cancel'">
                    <field name="seq" />
                    <field name="maintenance_request_id" />
                    <field name="picking_type_id" />
                    <field name="from_loc" />
                    <field name="to_loc_dest" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="mtodoline_tree" model="ir.ui.view">
            <field name="name">maintenance.todo.line.tree</field>
            <field name="model">maintenance.todo.line</field>
            <field name="arch" type="xml">
                <tree decoration-muted="check == False">
                    <field name="name" />
                    <field name="maintenance_strategy" />
                    <field name="maintenance_kind_id" />
                    <field name="equipment_number" />
                    <field name="check" />
                    <field name="note" />
                </tree>
            </field>
        </record>

        <record id="mtodo_form" model="ir.ui.view">
            <field name="name">maintenance.todo.form</field>
            <field name="model">maintenance.todo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                        </group>
                        <field name="lines">
                            <tree editable="bottom" decoration-muted="check == False">
                                <field name="name" />
                                <field name="maintenance_strategy" />
                                <field name="maintenance_kind_id" />
                                <field name="equipment_number" />
                                <field name="check" />
                                <field name="note" />
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- spareparts : actions -->
        <record id="spareparts_action" model="ir.actions.act_window">
            <field name="name">SpareParts</field>
            <field name="res_model">maintenance.spareparts</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new sparepart request
                </p>
            </field>
        </record>

