        <record model="ir.ui.view" id="maintenance_branch_form">
            <field name="name">maintenance.branch.form</field>
            <field name="model">maintenance.branch</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="branches">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_requests" type="object" class="oe_stat_button"
                                attrs="{'invisible':[('requests_count', '=', 0)]}" icon="fa-wrench">
                                <field string="Requests" name="requests_count" widget="statinfo" />
                            </button>
                            <button name="action_open_plans" type="object" class="oe_stat_button"
                                attrs="{'invisible':[('plans_count', '=', 0)]}" icon="fa-wrench">
                                <field string="Plans" name="plans_count" widget="statinfo" />
                            </button>
                            <button name="action_open_equipments" type="object"
                                class="oe_stat_button"
                                attrs="{'invisible':[('equipments_count', '=', 0)]}"
                                icon="fa-wrench">
                                <field string="Equipments" name="equipments_count" widget="statinfo" />
                            </button>
                        </div>
                        <group>
                            <field name="name" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="res_config_settings_view_form_firebits_maintenance" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.firebits.maintenance</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="25" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="maintenance" string="maintenance"
                        data-key="maintenance" groups="base.group_erp_manager">
                        <h2>Maintenance</h2>
                        <div class="row mt16 o_settings_container" name="title_setting_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="source_location" />
